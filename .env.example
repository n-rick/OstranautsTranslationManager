FROM_MEMORY="Depuis la mémoire"
NEW_TRANSLATIONS="Nouvelles traductions"
NEW="NOUVEAU"
AUTO_TRANSLATED="TRADUCTION AUTOMATIQUE"
VALIDATED="VALIDÉ"
MODIFIED="MODIFIÉ"
SKIPPED="IGNORÉ"
VALIDATE="Valider"
EDIT="Éditer"
SKIP="Ignorer"
