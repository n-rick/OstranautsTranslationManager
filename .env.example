# Configuration principale
OSTRANAUTS_DATA_PATH=/chemin/vers/Ostranauts/Ostranauts_Data/StreamingAssets/data
OUTPUT_PATH=./output
REPORT_PATH=./reports
DATABASE_PATH=./database/translation_memory.json

# Configuration du Workshop
WORKSHOP_MOD_NAME="Ostranauts - Traduction Française"
WORKSHOP_AUTHOR="RicoRama"
WORKSHOP_MOD_VERSION="1.0.0"
WORKSHOP_GAME_VERSION="1.0.0"
WORKSHOP_MOD_URL="https://github.com/n-rick/OstranautsTranslationManager"
WORKSHOP_NOTES="Traduction complète en français pour Ostranauts v1.0. Inclut tous les textes du jeu, interfaces, descriptions et dialogues."
WORKSHOP_OUTPUT_PATH=./workshop
GENERATE_WORKSHOP=false

# Langues
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=fr

# Messages UI (à traduire dans votre langue)
FILE_SCANNED="Fichiers scannés"
