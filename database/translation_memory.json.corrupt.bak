    },
    "9f8c0a99be8fadd9735f02c9665bbe7ca1e48673": {
        "source": "[us] says ugh, you? Fine, let's talk favors.",
        "translation": "[us] dit pouah, et toi ? Très bien, parlons des faveurs.",
        "field": "strDesc",
        "path": "$[8].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "2fed750effdc596ef4dd363e96f5cc4d2cf08770": {
        "source": "Agree to Discuss Favors with Criminal",
        "translation": "Accepter de discuter de faveurs avec un criminel",
        "field": "strTitle",
