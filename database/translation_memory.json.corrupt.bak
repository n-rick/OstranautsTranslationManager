        "relative_path": "interactions/interactions2.json"
    },
    "0ef03106c90f5970c0ca467b415c80ebe89c8bf9": {
        "source": "Talk About Illegal Racing",
        "translation": "Parlez de courses illégales",
        "field": "strTitle",
        "path": "$[170].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "ce6d919363205d9685ef2187e87437815d0eb71a": {
        "source": "[us] [says] [us-subj] heard that a bunch of roughnecks are slapping a dozen thrusters on old salvage pods and doing circuit races around an asteroid field twenty klicks out from K-Leg.",
        "translation": "[us] [says] [us-subj] a entendu dire qu'une bande de voyous claquaient une douzaine de propulseurs sur de vieux pods de récupération et faisaient des courses en circuit autour d'un champ d'astéroïdes à vingt kilomètres de K-Leg.",
        "field": "strDesc",
        "path": "$[170].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "44888b681fde3d5db10355c61dfaa4271f243c0d": {
        "source": "SOCBlank",
        "translation": "SOCBlanque",
        "field": "aInverse",
        "path": "$[170].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "2f558bd474f39303a4c532173b3ff743db0177e4": {
        "source": "Talk About The Mariner",
        "translation": "Parlez du marin",
        "field": "strTitle",
        "path": "$[171].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "471aaff6c6595eff7c096e3b0033dcca82332c89": {
        "source": "[us] [says] [us-subj] heard kids are trying to summon The Mariner on purpose.\nThey're putting on purple jumpsuits and smoking like two ounces of Damask Rose.\nNow half the abandoned shops in the Old Emporium smell like bongwater and BO.",
        "translation": "[us] [says] [us-subj] j'ai entendu dire que des enfants essayaient d'invoquer le Mariner exprès.\nIls enfilent des combinaisons violettes et fument comme deux onces de Damask Rose.\nAujourd’hui, la moitié des magasins abandonnés du Old Emporium sentent le bongwater et le BO.",
        "field": "strDesc",
        "path": "$[171].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "c7815b77bb06fa19d3df297a81ac10b3adacde3d": {
        "source": "SOCBlank",
        "translation": "SOCBlanque",
        "field": "aInverse",
        "path": "$[171].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "2c6f1f19e890b5107363e60e4db02e2d7614de02": {
        "source": "Gossip About Management",
        "translation": "Potins sur la gestion",
        "field": "strTitle",
        "path": "$[172].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "d5e36e6b2beae2f0ee84570121e7b84c428f850e": {
        "source": "[us] [asks] [them] if the suits at Ayotimiwa are up to their old tricks.",
        "translation": "[us] [asks] [them] si les costumes d'Ayotimiwa sont à la hauteur de leurs vieux tours.",
        "field": "strDesc",
        "path": "$[172].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "ffe221b1163c48f4f3e54909184d87587198bf10": {
        "source": "SOCPoliceShakedownRecognizeFriendGossipReply1",
        "translation": "SOCPoliceShakedownReconnaîtreAmiGossipRépondre1",
        "field": "aInverse",
        "path": "$[172].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
