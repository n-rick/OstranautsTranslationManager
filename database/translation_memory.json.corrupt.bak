    "3d7544ef5b70f45971cddfd35c194ac61bc52342": {
        "source": "Pacific Airlines Space Service",
        "translation": "Service spatial de Pacific Airlines",
        "field": "strTitle",
        "path": "$[137].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "76e32fa7c1f4a7417ee21e49c6e4cd7176e7b8ae": {
        "source": "Pacific Airlines Space Service (PASS) is an interplanetary shuttle service which operates in the Mars/Venus, Mars/Belt, and Luna/Mars transfers. It is the unofficial flag carrier of the Inner System, while its parent company Pacific Airlines is the flag carrier of the Old Philippines.\n\n<b>Service:</b> Airline, interplanetary shuttle\n<b>Country of origin:</b> Old Philippines\n<b>Key people:</b> Althea Torres (CEO)\n<b>Parent Company:</b> Pacific Airlines\n<b>Ticker symbol:</b> IPAC\n\n<b>Slogans:</b>\nBegin brand new in the off world colonies... (on Earth, defunct)\nHome is one ticket away... (off world, defunct)\nFrom sea to sky, we fly",
        "translation": "Pacific Airlines Space Service (PASS) est un service de navette interplanétaire qui opère dans les transferts Mars/Vénus, Mars/Ceinture et Luna/Mars. C'est le transporteur national non officiel du système intérieur, tandis que sa société mère Pacific Airlines est le transporteur national des anciennes Philippines.\n\n<b>Service :</b> Compagnie aérienne, navette interplanétaire\n<b>Pays d'origine :</b> Anciennes Philippines\n<b>Personnes clés :</b> Althea Torres (PDG)\n<b>Société mère :</b> Pacific Airlines\n<b>Symbole boursier :</b> IPAC\n\n<b>Slogans :</b>\nCommencez tout nouveau dans les colonies hors du monde... (sur Terre, défunte)\nLa maison est à un billet... (hors monde, défunt)\nDe la mer au ciel, nous volons",
        "field": "strDesc",
        "path": "$[137].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "a7b17694dd60587ebcabc2b8caf615ac51ecd465": {
        "source": "DataWIKIPASSHistory",
        "translation": "DonnéesWIKIPASSHistorique",
        "field": "aInverse",
        "path": "$[137].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "11c6a23fc99871214767f96e9212b155a085629b": {
        "source": "DataWIKIPASSMarketing",
        "translation": "DonnéesWIKIPASSMarketing",
        "field": "aInverse",
        "path": "$[137].aInverse[1]",
        "relative_path": "interactions/interactions_datafiles.json"
