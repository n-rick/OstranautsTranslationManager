    "81f9c1a28080b286a913ab3261078956586e82ff": {
        "source": "<b>Government:</b> Corporate republic\n<b>Head of state:</b> Academician Parker Hsu\n<b>Sovereignty:</b> Independent (owned by Brave New World, Gāngjìng xīn shìjiè, 刚劲新世界)\n<b>Location:</b> Voltaire crater, Deimos\n<b>Established:</b> 2033\n<b>Major ports:</b> Upsilon (Xilong, 西隆)\n<b>Industries:</b> Scientific research, higher education, advanced manufacturing\n<b>Currency:</b> CNY\n<b>Population estimate:</b> 300,000\n<b>Languages:</b> Mandarin, English, Arabic\n<b>Religions:</b> Buddhism",
        "translation": "<b>Gouvernement :</b> République corporative\n<b>Chef de l'État :</b> Académicien Parker Hsu\n<b>Souveraineté :</b> Indépendant (propriété du Meilleur des Mondes, Gāngjìng xīn shìjiè, 刚劲新世界)\n<b>Localisation :</b> Cratère Voltaire, Deimos\n<b>Créé :</b> 2033\n<b>Principaux ports :</b> Upsilon (Xilong, 西隆)\n<b>Industries :</b> Recherche scientifique, enseignement supérieur, fabrication de pointe\n<b>Devise :</b> CNY\n<b>Estimation de la population :</b> 300 000\n<b>Langues :</b> Mandarin, anglais, arabe\n<b>Religions :</b> Bouddhisme",
        "field": "strDesc",
        "path": "$[81].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
