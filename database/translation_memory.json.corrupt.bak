    "dfe3f70e418e86f488b15e0c1060ec6cf85236a7": {
        "source": "HQCH LEO Attacking Criminal",
        "translation": "HQCH LEO attaquant le criminel",
        "field": "strTitle",
        "path": "$[15].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "c8f4df923a31fc40a5ceecdf7258e4e5d81ea8a5": {
        "source": "\"Hey, it's that criminal! Get 'em!\" [us-shouts] [us], pointing towards [them].",
        "translation": "\"Hé, c'est si criminel ! Attrapez-les !\" [us-shouts] [us], pointant vers [them].",
        "field": "strDesc",
        "path": "$[15].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
