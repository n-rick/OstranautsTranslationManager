        "relative_path": "interactions/interactions_datafiles.json"
    },
    "288bc0b7b4960ccbc1c8d2e9362a9de52ff37c6e": {
        "source": "DataWIKIOgisosRegisterShipRatings",
        "translation": "DonnéesWIKIOgisosRegisterShipRatings",
        "field": "aInverse",
        "path": "$[126].aInverse[2]",
        "relative_path": "interactions/interactions_datafiles.json"
