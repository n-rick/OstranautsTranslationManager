        "relative_path": "interactions/interactions_datafiles.json"
    },
    "30075286b4796e5cf7ee6232918fbe621b19de1b": {
        "source": "Ogiso's Register Ship Ratings",
        "translation": "Registre des qualifications des navires d'Ogiso",
        "field": "strTitle",
        "path": "$[129].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "924f5f3fee4f3491624d99b21af2b6af7ccf8d65": {
        "source": "Ships are assessed first based on two maintenance criteria: the quality and maintenance of the hull, or the Vessel rating, and the quality and maintenance of the systems, or the Materials Rating. First Class maintenance receives an 'A' rating, which proceeds A-B-C-D-E, where 'E' is worst. The middle number indicates specialized spaces, usually pressurized, while the last letter assesses handling and agility, proceeding A-B-C-D-E in the same manner as maintenance.",
        "translation": "Les navires sont évalués d'abord sur la base de deux critères de maintenance : la qualité et l'entretien de la coque, ou la qualification du navire, et la qualité et la maintenance des systèmes, ou la qualification des matériaux. La maintenance de première classe reçoit une note « A », qui suit A-B-C-D-E, où « E » est le pire. Le chiffre du milieu indique des espaces spécialisés, généralement pressurisés, tandis que la dernière lettre évalue la maniabilité et l'agilité, en procédant A-B-C-D-E de la même manière que la maintenance.",
        "field": "strDesc",
        "path": "$[129].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "11c04dc8eee676039b59cc739807d5f9c708dc9e": {
        "source": "DataWIKIOgisosRegister",
        "translation": "DonnéesWIKIOgisosRegister",
        "field": "aInverse",
        "path": "$[129].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "fea6dcccac402227a1f7ec04c90de85e58e50f83": {
        "source": "DataWIKIOgisosRegisterHistory",
        "translation": "DataWIKIOgisosRegisterHistory",
        "field": "aInverse",
