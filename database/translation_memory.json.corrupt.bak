    },
    "7d1062bde08c8682d393c918830965e0e4889dc5": {
        "source": "[us] says oh hey, great to see you! Sure, let's talk favors.",
        "translation": "[us] dit oh hé, ravi de te voir ! Bien sûr, parlons de faveurs.",
        "field": "strDesc",
        "path": "$[7].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "aeaad31ceed2ec6abf73568dfa344fd7041dd994": {
        "source": "Agree to Discuss Favors with Enemy",
        "translation": "Accepter de discuter des faveurs avec l'ennemi",
        "field": "strTitle",
        "path": "$[8].strTitle",
