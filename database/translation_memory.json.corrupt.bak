    "3d73eb7038771d4da5db0b4bd79a98c81afb533f": {
        "source": "<b>Government:</b> Socialist republic\n<b>Head of state:</b> Administrator Lao Deng\n<b>Sovereignty:</b> De jure Xinhua, de facto independent.\n<b>Location:</b> Tharsis plateau, Mars\n<b>Established:</b> 2029\n<b>Major ports:</b> Port Yangshan (Yangshan Gang, 洋山港)\n<b>Industries:</b> Telecommunications, consumer electronics, pharmaceuticals, entertainment\n<b>Currency:</b> XNY\n<b>Population estimate:</b> 12,000,000\n<b>Languages:</b> Mandarin, English\n<b>Religions:</b> Buddhism, Christianity",
        "translation": "<b>Gouvernement :</b> République socialiste\n<b>Chef de l'État :</b> Administrateur Lao Deng\n<b>Souveraineté :</b> De jure Xinhua, de facto indépendant.\n<b>Emplacement :</b> Plateau de Tharsis, Mars\n<b>Créé :</b> 2029\n<b>Principaux ports :</b> Port Yangshan (Yangshan Gang, 洋山港)\n<b>Industries :</b> Télécommunications, électronique grand public, produits pharmaceutiques, divertissement\n<b>Devise :</b> XNY\n<b>Estimation de la population :</b> 12 000 000\n<b>Langues :</b> Mandarin, Anglais\n<b>Religions :</b> Bouddhisme, Christianisme",
        "field": "strDesc",
        "path": "$[95].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
