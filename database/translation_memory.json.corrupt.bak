    "d76eaf812ff8d1569d9f50c65a3a186058b421bf": {
        "source": "Fort Simpson is the capital colony of the revolutionary government The Galilean Confederacy. It is located on and under the palimpsest crater Lagash Sulcus on Jupiter's moon Ganymede.",
        "translation": "Fort Simpson est la colonie capitale du gouvernement révolutionnaire de la Confédération Galiléenne. Il est situé sur et sous le cratère palimpseste Lagash Sulcus sur la lune Ganymède de Jupiter.",
        "field": "strDesc",
        "path": "$[59].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
