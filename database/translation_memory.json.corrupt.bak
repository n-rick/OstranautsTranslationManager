        "relative_path": "interactions/interactions.json"
    },
    "44a19d9167601c3927ac1452dbf823b3585a6d8d": {
        "source": "[us] is seeking secure and prompt delivery of [itm] to [them], who is currently located on [them-shipfriendly]. [them] needs the item in question [txt1].",
        "translation": "[us] recherche une livraison sécurisée et rapide de [itm] à [them], qui se trouve actuellement à [them-shipfriendly]. [them] a besoin de l'article en question [txt1].",
        "field": "strDesc",
        "path": "$[566].strDesc",
        "relative_path": "interactions/interactions.json"
    },
