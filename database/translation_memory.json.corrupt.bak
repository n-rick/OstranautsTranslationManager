    "12cbac323df05f3ace8468f5b634c9a6e8532968": {
        "source": "GalCon LEO Attacking Criminal",
        "translation": "GalCon LEO attaque un criminel",
        "field": "strTitle",
        "path": "$[15].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "17affe3c34e521c186cd6265ed731be0e77d9404": {
        "source": "\"Hey, it's that criminal! Get 'em!\" [us-shouts] [us], pointing towards [them].",
        "translation": "\"Hé, c'est si criminel ! Attrapez-les !\" [us-shouts] [us], pointant vers [them].",
        "field": "strDesc",
        "path": "$[15].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
