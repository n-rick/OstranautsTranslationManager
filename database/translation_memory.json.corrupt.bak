    "de6b701b9cce25a516c77c3c863db46d789581f7": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "8cb3515cbdffb8d112eebcfd93c401be52ec7506": {
        "source": "After processing, you are unceremoniously dumped outside the Suzhou Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie devant le bureau de sécurité de Suzhou. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "58714cee2b825f09181029f06fe9c648f3edf86b": {
