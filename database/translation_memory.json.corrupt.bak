        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "426e801ae39bf49d91ce14fee1d3d8b14d4cebe4": {
        "source": "MVOL LEO Begins Arresting Criminal for Stealing a Ship",
        "translation": "MVOL LEO commence à arrêter un criminel pour avoir volé un navire",
        "field": "strTitle",
        "path": "$[16].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "772bddd3a3aea184f19111a27b698532830ebed1": {
        "source": "\"You've been reported as flying a stolen ship,\" [us] [says], looking at [them].\"We're bringing you in.\"",
        "translation": "\"On vous a signalé que vous pilotiez un vaisseau volé\", [us] [says], regardant [them]. \"Nous vous emmenons.\"",
        "field": "strDesc",
        "path": "$[16].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
