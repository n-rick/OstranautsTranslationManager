    "a31684291a705d9c77b06946ed84f91ee4fa82a2": {
        "source": "<b>Government:</b> Autocracy (prison state)\n<b>Head of state:</b> Warden Isabella Braña\n<b>Sovereignty:</b> Owned by Prokofiev Penal Colony LLC, a Hangzhou-based corporation\n<b>Location:</b> Mercury, Prokofiev crater\n<b>Established:</b> 2039\n<b>Major ports:</b> Qincheng (秦城)\n<b>Industries:</b> Imprisonment, mining\n<b>Currency:</b> XNY, Sigs (digital prison scrip)\n<b>Population estimate:</b> 8,000\n<b>Languages:</b> Mandarin, English\n<b>Religions:</b> Christianity",
        "translation": "<b>Gouvernement :</b> Autocratie (État carcéral)\n<b>Chef de l'État :</b> Préfet Isabella Braña\n<b>Souveraineté :</b> Propriété de Prokofiev Penal Colony LLC, une société basée à Hangzhou\n<b>Localisation :</b> Mercure, cratère Prokofiev\n<b>Établi :</b> 2039\n<b>Principaux ports :</b> Qincheng (秦城)\n<b>Industries :</b> Emprisonnement, exploitation minière\n<b>Devise :</b> XNY, Sigs (certificat de prison numérique)\n<b>Estimation de la population :</b> 8 000\n<b>Langues :</b> Mandarin, Anglais\n<b>Religions :</b> Christianisme",
        "field": "strDesc",
        "path": "$[105].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
