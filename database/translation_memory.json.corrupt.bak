    "101e164896132c40a654c7b7b7f7262a7d8b1031": {
        "source": "Affirmative [them-shipfriendly]. We have your speed and vector. You are cleared for close approach and dock. Confirm guidance and begin RCS maneuvers.",
        "translation": "Affirmatif [them-shipfriendly]. Nous avons votre vitesse et votre vecteur. Vous êtes autorisé à vous approcher à proximité et à accoster. Confirmez le guidage et commencez les manœuvres RCS.",
        "field": "strDesc",
        "path": "$[39].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "fce6d0a725042569f56a53e7c181ef1f83f29562": {
        "source": "Docking clearance granted, Gig target",
        "translation": "Autorisation d'amarrage accordée, objectif Gig",
        "field": "strTitle",
        "path": "$[40].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "13ef0b88e29e64365fb52a51285026126d946f1c": {
        "source": "Affirmative [them-regID]. We are expecting your arrival.",
        "translation": "Affirmatif [them-regID]. Nous attendons votre arrivée.",
        "field": "strDesc",
        "path": "$[40].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "22913a0bb889b391e0e4f8605be206415fb774c0": {
        "source": "Docking clearance granted for Friend",
        "translation": "Autorisation d'amarrage accordée pour Friend",
        "field": "strTitle",
        "path": "$[41].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "9969d432413ca399b76da7602349166f4d737c5c": {
        "source": "Hey there old friend. Anything for Captain [them-captain]. Got your speed here and you're clear for approach. Don't bust my ring on the way in.",
        "translation": "Salut, mon vieil ami. N'importe quoi pour le capitaine [them-captain]. Vous avez votre vitesse ici et vous êtes prêt à vous approcher. Ne casse pas ma bague en entrant.",
        "field": "strDesc",
        "path": "$[41].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "d1ca85a2332c2143b43f8a00b3d43bec8c9ab652": {
        "source": "Docking clearance granted for Enemy",
        "translation": "Autorisation d'amarrage accordée pour l'ennemi",
        "field": "strTitle",
        "path": "$[42].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "c498c27961537d3d35e5018b4764807e78fc5f00": {
        "source": "Can't say I'm happy to see you Captain [them-captain]. But if you insist on sullying my ship with your presence, you're clear for docking.",
        "translation": "Je ne peux pas dire que je suis heureux de vous voir Capitaine [them-captain]. Mais si vous insistez pour souiller mon vaisseau par votre présence, vous pouvez accoster.",
        "field": "strDesc",
        "path": "$[42].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "4e2ea7d73a1e02a1d965e053c4cdd458e88e4f88": {
        "source": "Docking clearance was granted by station",
        "translation": "L'autorisation d'amarrage a été accordée par la gare",
        "field": "strTitle",
        "path": "$[43].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "7c3de268a0e82d53419aed8ad1f3e8657fd445d7": {
        "source": "Affirmative [them-shipfriendly]. We have your speed and vector. You are cleared for close approach and dock. Confirm guidance and begin RCS maneuver.",
        "translation": "Affirmatif [them-shipfriendly]. Nous avons votre vitesse et votre vecteur. Vous êtes autorisé à vous approcher à proximité et à accoster. Confirmez le guidage et commencez la manœuvre RCS.",
        "field": "strDesc",
        "path": "$[43].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "2b97d2fc32d0804c5f247c93c18e2950a6976ccd": {
        "source": "Docking clearance granted",
        "translation": "Autorisation d'amarrage accordée",
        "field": "strTitle",
        "path": "$[44].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "b575642cb258dd0f45d8578017a980d2dab3ad31": {
        "source": "Affirmative [them-shipfriendly]. We have your speed and vector. You are cleared for close approach and dock. Confirm guidance and begin RCS maneuvers.",
        "translation": "Affirmatif [them-shipfriendly]. Nous avons votre vitesse et votre vecteur. Vous êtes autorisé à vous approcher à proximité et à accoster. Confirmez le guidage et commencez les manœuvres RCS.",
        "field": "strDesc",
        "path": "$[44].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "0f2512d72d25400d4bacb3c696223dea937dbb34": {
        "source": "Dock Deny because of blocked docking port",
        "translation": "Dock Deny en raison d'un port d'accueil bloqué",
        "field": "strTitle",
        "path": "$[45].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "032a5add654b1cc6c0d7f302c39aa6fb4e1f7236": {
        "source": "Negative [them-captain]. No available docking ports. Come back later or use PASS.",
        "translation": "Négatif [them-captain]. Aucun port d'accueil disponible. Revenez plus tard ou utilisez PASS.",
        "field": "strDesc",
        "path": "$[45].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
