    "52fb8661733329a5b068d381701019f4b8929bfd": {
        "source": "Adds MVOL LEO Arrest pledge to us",
        "translation": "Nous ajoute l'engagement d'arrestation de MVOL LEO",
        "field": "strTitle",
        "path": "$[28].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "c9049e52f740dbf9d5f842f2b7efcfb5e27e7ceb": {
        "source": "[us] [gains] MVOL LEO Arrest pledge.",
        "translation": "[us] [gains] MVOL LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "749ed8083b30897dfadc6156117336394b57fbc0": {
        "source": "Adds MVOL LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement d'arrestation MVOL LEO car le joueur a volé un navire.",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "05ae6639455b9d9433c2ecdaba2856ad41948bfd": {
        "source": "[us] [gains] MVOL LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] MVOL LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "712aa975ce595cdb20f69522c0cee450f399282f": {
        "source": "Adds MVOL LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement de menace MVOL LEO",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "d30c34ed5580e4e1976cdeb3fbe853554a8b3ba1": {
        "source": "[us] [gains] MVOL LEO Threat pledge.",
        "translation": "[us] [gains] MVOL LEO Engagement de menace.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "71558eb5f184baae0e4a7af603194e9846c814c1": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "757875037794231459320524253b55d326020e80": {
        "source": "They haul you before a Titan martial judge for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Virginia Penitentiary for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un juge martial Titan pour jugement, laissant votre vaisseau et votre équipement derrière eux.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payable en totalité ou en plusieurs versements - ou vous partez au pénitencier de Virginie pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "4656ab9b62b9aaa0cb9c01803ae2b9d1e5c63a1c": {
        "source": "ENCHeatSVIRFineEnd",
        "translation": "ENCHeatSVIRFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "ec885895cc02633705cdbbae97145d63384b27eb": {
        "source": "ENCHeatSVIRFineDebtEnd",
        "translation": "ENCHeatSVIRFineDetteFin",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "00f5efd50af9d221ebdf0687f0dd27c1865c6c63": {
        "source": "ENCHeatSVIRPrisonStart",
        "translation": "ENCHeatSVIRPisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "3f58a26f22f288439b822e4f189e05d2a27df7ea": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "553f9472ef066bee43e38182cdfe5662a58bc4f3": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "1f69cfef19d1a502f4b094d1aeef9a36c9c35c32": {
        "source": "ENCHeatSVIRFineFinish",
        "translation": "ENCHeatSVIRFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "4cda396b0d49dc95e17d72434fb93a27c7785572": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "61d7d2b98a7fec2257caee4b32404fd8802b2f85": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "7cf874289727204a97b50df931bd236da4c0b00a": {
        "source": "ENCHeatSVIRFineFinish",
        "translation": "ENCHeatSVIRFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "d45e105cb0f538e33f45701d7488d3e9422d723a": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "58bd3ff01c97c48776b431d9748e6dd9b373ac5c": {
        "source": "After processing, you are unceremoniously dumped outside the Virginia Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l’extérieur du bureau de sécurité de Virginie. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "719c06ecf6cc5c175b8acc74c45eda35a90b8549": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "3663fe9b684a98f4d1fd3010466f461ceef2247d": {
        "source": "Off to Virginia Penitentiary",
        "translation": "En route pour le pénitencier de Virginie",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "9e3289b1eb2a130980b1240d6fd2f2aa4a3979b7": {
        "source": "You are hauled off to Virginia Penitentiary.",
        "translation": "Vous êtes transporté au pénitencier de Virginie.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "5aa6169b9b391270820e9fbf5206f731e4d78118": {
        "source": "ENCHeatSVIRPrisonEnd",
        "translation": "ENCHeatSVIRPisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "8318bcba8246d56b9ec0a6ee7564feba571fd50d": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "f25acb23a89c98eb5e205da103e0b0e1f7c0f696": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "7618c757bdd2cc12efa97099f05ac0862ea6c377": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
    "54ec249a5274925197fb025fd8010b11016f9784": {
        "source": "ENCHeatSVIRPrisonFinish",
        "translation": "ENCHeatSVIRPisonFinish",
        "field": "aInverse",
        "path": "$[5].aInverse[0]",
        "relative_path": "interactions/interactions_crime_SVIR.json"
    },
