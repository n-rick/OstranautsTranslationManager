    "9684b40c08e049a9ed841f5d87dfe38c0c603930": {
        "source": "Voltaire, Deimos, moon of Mars",
        "translation": "Voltaire, Deimos, lune de Mars",
        "field": "strTitle",
        "path": "$[80].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "0cf8b791a3068d3c8a742b61e96013b769bf7e0b": {
        "source": "Voltaire is a network of research facilities on Mars' moon Deimos, which is owned and run by Chinese technology corporation Brave New World, LLC. Besides maintaining the facilities and conducting its own research, BNW rents research spaces, services them for other technology giants including Renbao and Zhuangzi, manufactures high-tech electronic components, and supports the private university, the Voltaire University of Science and Technology.",
        "translation": "Voltaire est un réseau d'installations de recherche sur la lune de Mars, Deimos, détenu et géré par la société technologique chinoise Brave New World, LLC. En plus d'entretenir les installations et de mener ses propres recherches, BNW loue des espaces de recherche, les entretient pour d'autres géants de la technologie, notamment Renbao et Zhuangzi, fabrique des composants électroniques de haute technologie et soutient l'université privée, l'Université des sciences et technologies Voltaire.",
        "field": "strDesc",
        "path": "$[80].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
