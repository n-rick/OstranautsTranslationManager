    "1afde3286577dc2830c10bc198037532c862baec": {
        "source": "Labor Barge Locker",
        "translation": "Casier de barge de travail",
        "field": "strTitle",
        "path": "$[388].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "97ed991687bb193cf8e51c9e4e98ed31e5a7982e": {
        "source": "Hulks of blackened metal loom all around as you ride the labor barge out to the boneyard. The barge is so overloaded today, they've got some of you clinging to a cargo web full of locked crates.\n\nCrates with emergency supplies they'll, no doubt, deduct from your pay if you dare have an accident.\n\nBut the armed guard's back is turned...",
        "translation": "Des carcasses de métal noirci surgissent tout autour tandis que vous conduisez la barge de travail jusqu'au cimetière. La barge est tellement surchargée aujourd'hui que certains d'entre vous s'accrochent à une toile de chargement remplie de caisses verrouillées.\n\nDes caisses contenant des fournitures d'urgence qu'ils déduiront sans aucun doute de votre salaire si vous osez avoir un accident.\n\nMais le garde armé a le dos tourné...",
        "field": "strDesc",
        "path": "$[388].strDesc",
        "relative_path": "interactions/interactions.json"
    },
