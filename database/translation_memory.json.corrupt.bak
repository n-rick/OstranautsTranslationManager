    "c43716444c135c43a8bb16369d74a3e732d70547": {
        "source": "Adds GalCon LEO Arrest pledge to us",
        "translation": "Nous ajoute l'engagement d'arrestation de GalCon LEO",
        "field": "strTitle",
        "path": "$[28].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "b780cf3622eec061af49d04cabeec40690bffca9": {
        "source": "[us] [gains] GalCon LEO Arrest pledge.",
        "translation": "[us] [gains] GalCon LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "ecc403f8a14268b7e0a6021b89ae9e4bf25647e1": {
        "source": "Adds GalCon LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement GalCon LEO Arrest parce que le joueur a volé un navire.",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "0ebc441874eca24fe1aa585cd6e09c69470009a4": {
        "source": "[us] [gains] GalCon LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] GalCon LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "4a059eb988c318eb9522b58764092284472c195f": {
        "source": "Adds GalCon LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement GalCon LEO Threat",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "ddc359dc91e9c75fa12e56072d98c49c754f79a0": {
        "source": "[us] [gains] GalCon LEO Threat pledge.",
        "translation": "[us] [gains] GalCon LEO Engagement de menace.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "81410521c49e1127e9254fc26ba7cf54f61e4921": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "41607fa52c166825344826dfbee3bafd8780f700": {
        "source": "They haul you before a Chinese magistrate for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Jade Rabbit Brig for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un magistrat chinois pour jugement, laissant derrière eux votre navire et votre équipement.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payable en totalité ou en plusieurs versements - ou partir à Jade Rabbit Brig pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "1db003a2800605b1ef6134a2ef66f9e5ed22ba2f": {
        "source": "ENCHeatEJDRFineEnd",
        "translation": "ENCHeatEJDRFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "1569cd167f6be7248da05a1ef0800f3bf06252cd": {
        "source": "ENCHeatEJDRFineDebtEnd",
        "translation": "ENCHeatEJDRFineDebtEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "377215fa4606ab3f980aec4eb5d5b1467c7bd819": {
        "source": "ENCHeatEJDRPrisonStart",
        "translation": "ENCHeatEJDRPrisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "5a182cce6a4894f429eecd29a2156918029543c1": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "703c55a140f46d84779e418ed27980f6f294cbd9": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "6fd5f617fb8e010129d42d5f5a609d6d811f5074": {
        "source": "ENCHeatEJDRFineFinish",
        "translation": "ENCHeatEJDRFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "ca2034e980b05265a981e784994e540057bf292c": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "47e5f7d81f62f9ee02810042e03ffd60f6df631b": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "4d1f67f831742183d32f32c4270e56416fa656fa": {
        "source": "ENCHeatEJDRFineFinish",
        "translation": "ENCHeatEJDRFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "c1f585a63520292f6198d24875b8e8ba53c4ddc7": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "5aa725fab8d312d4c2c2b8ae55549cdd4690b09a": {
        "source": "After processing, you are unceremoniously dumped outside the Jade Rabbit Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l’extérieur du bureau de sécurité du Lapin de Jade. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "d6c41fb4215e89bb434fdff74f2b495b64904d3d": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "ba2485902c2d58504140c11f891c5149f14cb814": {
        "source": "Off to Jade Rabbit Brig",
        "translation": "En route pour le brick Lapin de Jade",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "1d1ae5e7e6948fa3f3fecbd2b05ce7b91dc0fa63": {
        "source": "You are hauled off to Jade Rabbit Brig.",
        "translation": "Vous êtes transporté à Jade Rabbit Brig.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "04b04d6932978fd9254017a5bca9f55269cfc192": {
        "source": "ENCHeatEJDRPrisonEnd",
        "translation": "ENCHeatEJDRPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "8c6d97b5b0dd4fcf049c9ed28fdfdbf04673b190": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "6fd08436568b69e9308ea0bce3dde142dffe8b98": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "1d596db042d32e35755e8c9d7bd2ae025d0c392f": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "721bab381be4fbedf9130b467be0ad363369b4fe": {
        "source": "ENCHeatEJDRPrisonFinish",
        "translation": "ENCHeatEJDRPrisonFinish",
        "field": "aInverse",
        "path": "$[5].aInverse[0]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "6d2aef275150a329c2e401f602e6aa02de156efb": {
        "source": "CGEncHomeworldLEOEnemy",
        "translation": "CGEncHomeworldLEOEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[0]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "30a56d4d13d4077f4bd93bb51e89364ff773646c": {
        "source": "CGEncHomeworldPrisonerFriend",
        "translation": "CGEncHomeworldPrisonerAmi",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[1]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "a27621d43fbea814c208a8609a7ad33e32d82797": {
        "source": "CGEncHomeworldCriminalEnemy",
        "translation": "CGEncHomeworldCriminalEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[2]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "b78faa038c561e4da569e300e5c68cb40b8ace05": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "a10e8959087ad7c2f7b8035f22f103f3faa46920": {
        "source": "After processing, you are unceremoniously dumped outside the Jade Rabbit Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l’extérieur du bureau de sécurité du Lapin de Jade. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "15509cc0bb7e087cc86ecc44c65e60d9a6e43393": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[6].aInverse[0]",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
