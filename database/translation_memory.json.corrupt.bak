    "b6a830d0cf8ed363e2a5089db424db46ab663b04": {
        "source": "========================================================================================================",
        "translation": "=======================================================================================================",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "75ea16416239f6d07255b4ce25060ab7da7df70c": {
        "source": "Agree to Discuss Following",
        "translation": "Accepter de discuter suite",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "2500f91aeb6a688593a74e129573b5ca7a54cecb": {
        "source": "[us] says maybe but needs further convincing.",
        "translation": "[us] dit peut-être mais doit être davantage convaincu.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "3bc68d9fbc84314dce0a539a7bef7bd5b9b09b88": {
        "source": "Agree to Discuss Following a Friend",
        "translation": "Accepter de discuter du suivi d'un ami",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "f0d9164d625df8c510ff17f1b6dae8ccd951e677": {
        "source": "[us] offers an enthusiastic greeting and says they might be able to follow a friend like [them].",
        "translation": "[us] offers an enthusiastic greeting and says they might be able to follow a friend like [them].",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "3b6890df9849b51db3c8b4e13412bdc860210205": {
        "source": "Agree to Discuss Following an Enemy",
        "translation": "Accepter de discuter de la poursuite d'un ennemi",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "a7fc016054edad87befb1b1e49f0d326f3cf6d8d": {
        "source": "[us] recoils and asks why they would ever go somewhere with you.",
        "translation": "[us] recule et demande pourquoi ils iraient quelque part avec vous.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "121b64b6d6f4f0da1d2516788c48df6cd00a0600": {
        "source": "Agree to Discuss Following a Criminal",
        "translation": "Accepter de discuter de la suite à un criminel",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "39858f569dc889f0379aaf2f62c4be2841acf737": {
        "source": "[us] says they aren't in the habit of following criminals but is willing to hear [them] out.",
        "translation": "[us] dit qu'ils n'ont pas l'habitude de suivre les criminels, mais qu'ils sont prêts à écouter [them].",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "88605ae6897ae0b984401923539d89ec3114f2b6": {
        "source": "Agree to Discuss Following Someone Filthy",
        "translation": "Accepter de discuter du suivi de quelqu'un de sale",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "656fe355f50d91ccd222833faac9ce792bf3bc87": {
        "source": "[us] recoils from [them] and asks why they would ever follow someone so filthy.",
        "translation": "[us] recule devant [them] et demande pourquoi ils suivraient quelqu'un d'aussi sale.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "b5980c769b579c1fdd34a6e3dd22b8bac1c52f61": {
        "source": "Agree to Discuss Following an Injured Person",
        "translation": "Accepter de discuter du suivi d'une personne blessée",
        "field": "strTitle",
        "path": "$[7].strTitle",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "69224a1e8720115e1f6b3d4da993125360be0073": {
        "source": "[us] says if [them] is going anywhere it should be a Med Bay.",
        "translation": "[us] dit que si [them] va quelque part, ce devrait être une Med Bay.",
        "field": "strDesc",
        "path": "$[7].strDesc",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "f9b8621d41cf39556ed43b64133ac80e7ad80a56": {
        "source": "Refuse to Follow Enemy",
        "translation": "Refuser de suivre l'ennemi",
        "field": "strTitle",
        "path": "$[8].strTitle",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
    "61e947882543eb1fcbd2eac993e528bf5379585e": {
        "source": "[us] says [them] is the last person they'd ever want to follow.",
        "translation": "[us] dit que [them] est la dernière personne qu'ils voudraient suivre.",
        "field": "strDesc",
        "path": "$[8].strDesc",
        "relative_path": "interactions/interactions_stk_follow.json"
    },
