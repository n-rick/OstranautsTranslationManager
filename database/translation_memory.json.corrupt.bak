    "1fb73524f301d1998fdb87db480b4534c30b7495": {
        "source": "PPP_History_01.TXT",
        "translation": "PPP_History_01.TXT",
        "field": "strTitle",
        "path": "$[35].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "3271b6e438770e7dd00805c81f1edf09f12a55cc": {
        "source": "The Perpetual Protein Project was an experimental food science and biogenetics program aimed towards creating a healthy, shelf stable and self replicating protein source intended to feed spacers during long haul travel. A joint operation between Brave New World LLC (BNW) and Hyun Lee Petware (HLP), the project was run primarily out of a series of interconnected Martian labs in a remote desert facility several hundred kilometers outside of Tharsis Landing.\n\nThe project gained notoriety first as a site of interplanetary ethical debate and second as a source of corporate embarrassment after several live specimen somehow broke containment, escaped atmosphere, and subsequently spread throughout the system.",
        "translation": "Le projet Perpetual Protein était un programme expérimental de science alimentaire et de biogénétique visant à créer une source de protéines saine, stable en conservation et auto-réplicative destinée à nourrir les espaceurs lors de voyages long-courriers. Opération conjointe entre Brave New World LLC (BNW) et Hyun Lee Petware (HLP), le projet a été mené principalement à partir d'une série de laboratoires martiens interconnectés dans une installation isolée dans le désert, à plusieurs centaines de kilomètres de Tharsis Landing.\n\nLe projet a gagné en notoriété, d'abord en tant que site de débat éthique interplanétaire, puis en tant que source d'embarras pour les entreprises après que plusieurs spécimens vivants ont brisé le confinement, se sont échappés de l'atmosphère et se sont ensuite répandus dans tout le système.",
        "field": "strDesc",
        "path": "$[35].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "bea55eb0e6161e4a96a5a3a2b76edb08a3c87ba2": {
        "source": "DataWIKIHyunLeePetware",
        "translation": "DonnéesWIKIHyunLeePetware",
        "field": "aInverse",
        "path": "$[35].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "808dea5e9f06b61dd60b2222c1603f3e6217178f": {
        "source": "DataWIKIVoltaire",
        "translation": "DonnéesWIKIVoltaire",
        "field": "aInverse",
        "path": "$[35].aInverse[1]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "684d444e4b229a8fc9d2453d55622a17a8c7eae0": {
        "source": "DataWIKITharsisLanding",
        "translation": "DonnéesWIKITharsisLanding",
        "field": "aInverse",
