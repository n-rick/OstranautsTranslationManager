    "07780f4b5d39cd768b2725b3c15000a221d2f953": {
        "source": "Normal",
        "translation": "Normale",
        "field": "strNameFriendly",
        "path": "$[437].strNameFriendly",
        "relative_path": "conditions/conditions_plots.json"
    },
    "49ef516d84bd601090bb4af4f5b0df76c266bcfa": {
        "source": "[us] [has] no special intimacy needs.",
        "translation": "[us] [has] aucun besoin particulier en matière d'intimité.",
        "field": "strDesc",
        "path": "$[437].strDesc",
        "relative_path": "conditions/conditions_plots.json"
    },
    "3908a58160076abbf20b242fc00a0a0e3d759531": {
        "source": "Needy",
        "translation": "Nécessiteux",
        "field": "strNameFriendly",
        "path": "$[438].strNameFriendly",
        "relative_path": "conditions/conditions_plots.json"
    },
    "691559f8b69650a1f1c2a8caebc4462913bb0be4": {
        "source": "[us] [wonders] how long it has been since [us-subj] touched anyone, really. [us-contractHas] been going to bed alone and waking up wanting. If nothing changes, this can only get worse, right?",
        "translation": "[us] [wonders] combien de temps cela fait-il que [us-subj] n'a pas touché qui que ce soit, vraiment. [us-contractHas] je me suis couché seul et je me suis réveillé en ayant envie. Si rien ne change, cela ne peut qu’empirer, non ?",
        "field": "strDesc",
        "path": "$[438].strDesc",
        "relative_path": "conditions/conditions_plots.json"
    },
    "893cb9e6beddc1ce49f572fa9483d2f84998df12": {
        "source": "Lonesome",
        "translation": "Solitaire",
        "field": "strNameFriendly",
        "path": "$[439].strNameFriendly",
        "relative_path": "conditions/conditions_plots.json"
    },
    "220e51f56e0d760a1e3e24627387c5d78dfd988d": {
        "source": "[us] [wants] to feel wanted. It seems like everyone else has a special someone, but not [us-obj].\n\n[us-contractIs] getting desperate for the faintest touch of warm skin, for momentary smoldering eyes or flirtatious words directed [us-pos] way.",
        "translation": "[us] [wants] pour se sentir désiré. Il semble que tout le monde a quelqu'un de spécial, mais pas [us-obj].\n\n[us-contractIs] recherche désespérément le moindre contact de peau chaude, des yeux brûlants momentanés ou des mots coquettes dirigés de manière [us-pos].",
        "field": "strDesc",
        "path": "$[439].strDesc",
        "relative_path": "conditions/conditions_plots.json"
    },
    "1ccaec230a0a3e61ba06df141c13f70a7df3c301": {
        "source": "Desperate",
        "translation": "Désespéré",
        "field": "strNameFriendly",
        "path": "$[440].strNameFriendly",
        "relative_path": "conditions/conditions_plots.json"
    },
    "3849c1364d246eb544b2e10a71207ac333853614": {
        "source": "\"Dry spell\" would be putting it lightly. [us] [burns] with a persistent gnawing need and constant envy.\n\n[us-subj] [assumes] everyone else's laugh and smile is laced with a romantic satisfaction that eludes [us-obj]. Others hold hands, share drinks, fix the life support together.\n\n[us] [feels] doomed to be alone forever.",
        "translation": "\"Période de sécheresse\" serait le dire à la légère. [us] [burns] avec un besoin persistant et une envie constante.\n\n[us-subj] [assumes] le rire et le sourire de tout le monde sont mêlés d'une satisfaction romantique qui échappe à [us-obj]. D’autres se tiennent la main, partagent un verre, réparent ensemble le système de survie.\n\n[us] [feels] condamné à être seul pour toujours.",
        "field": "strDesc",
        "path": "$[440].strDesc",
        "relative_path": "conditions/conditions_plots.json"
    },
    "92aa818f08c514bc7c853ad7b5999aabfa944c5b": {
        "source": "Decorated Amorously",
        "translation": "Décoré avec amour",
        "field": "strNameFriendly",
        "path": "$[441].strNameFriendly",
        "relative_path": "conditions/conditions_plots.json"
    },
    "892f5fedc6755f94a438dcbef51f5d0d22520a41": {
        "source": "[us] [is] adorned with at least one amorous or suggestive figure.",
        "translation": "[us] [is] orné d'au moins une figure amoureuse ou suggestive.",
        "field": "strDesc",
        "path": "$[441].strDesc",
        "relative_path": "conditions/conditions_plots.json"
    },
    "ebb5e0633024f581d50c0fb2916ab58ed52376be": {
        "source": "Talked about as a Lover Recently",
        "translation": "Parlé d'un amant récemment",
        "field": "strNameFriendly",
        "path": "$[442].strNameFriendly",
        "relative_path": "conditions/conditions_plots.json"
    },
    "38d2b519ddd4ed3c40eb47d2b51533613056d68a": {
        "source": "[us] [has] been talked about as a lover recently and can't do so again for a few seconds.",
        "translation": "On a récemment parlé de [us] [has] comme d'un amant et je ne peux pas le faire à nouveau avant quelques secondes.",
        "field": "strDesc",
        "path": "$[442].strDesc",
        "relative_path": "conditions/conditions_plots.json"
    },
