    "552e9c994bf1807876429ee3058a104ac9e66661": {
        "source": "Jade Rabbit Statistics",
        "translation": "Statistiques du Lapin de Jade",
        "field": "strTitle",
        "path": "$[71].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "dd0953a3f324d82544ac9bacf8a5b52da4bc4c47": {
        "source": "<b>Government:</b> Socialist republic\n<b>Head of state:</b> Chairman Li\n<b>Sovereignty:</b> De jure owned by Old China, de facto independent\n<b>Location:</b> Mare Imbrium, Luna\n<b>Established:</b> 2022\n<b>Major ports:</b> Shajiang (Mortar, 砂浆)\n<b>Industries:</b> He3 mining, tourism\n<b>Currency:</b> CNY\n<b>Population estimate:</b> 800,000\n<b>Languages:</b> Mandarin, English\n<b>Religions:</b> Buddhism",
        "translation": "<b>Gouvernement :</b> République socialiste\n<b>Chef de l'Etat :</b> Président Li\n<b>Souveraineté :</b> Propriété de jure de la vieille Chine, indépendante de facto\n<b>Emplacement :</b> Mare Imbrium, Luna\n<b>Créé :</b> 2022\n<b>Principaux ports :</b> Shajiang (Mortar, 砂浆)\n<b>Industries :</b> He3 mines, tourisme\n<b>Devise :</b> CNY\n<b>Estimation de la population :</b> 800 000\n<b>Langues :</b> Mandarin, Anglais\n<b>Religions :</b> Bouddhisme",
        "field": "strDesc",
        "path": "$[71].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "0dbc83cdd773fa3fb85db36a06795e4b798bc35f": {
        "source": "DataWIKIJadeRabbit",
