        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "ff72536c5a1a454e99c29e3aa41383a80f68acdd": {
        "source": "HQCH LEO Begins Arresting Criminal for Stealing a Ship",
        "translation": "HQCH LEO commence à arrêter un criminel pour avoir volé un navire",
        "field": "strTitle",
        "path": "$[16].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "2c27ee99de7e3ebd15e0010ff8fec90811bc18b1": {
        "source": "\"You've been reported as flying a stolen ship,\" [us] [says], looking at [them].\"We're bringing you in.\"",
        "translation": "\"On vous a signalé que vous pilotiez un vaisseau volé\", [us] [says], regardant [them]. \"Nous vous emmenons.\"",
        "field": "strDesc",
        "path": "$[16].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
