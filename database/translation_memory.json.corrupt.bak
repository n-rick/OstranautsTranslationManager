    },
    "5efe12726b90c810bbfa5ed602d7e5730f49b4c5": {
        "source": "Agree to fight",
        "translation": "Accepter de se battre",
        "field": "strTitle",
        "path": "$[82].strTitle",
        "relative_path": "interactions/interactions_combat.json"
    },
    "5cc846fdf6f8907b289921ab1fdfaf1d05e6b669": {
        "source": "[us] [agrees] to join the fight.",
        "translation": "[us] [agrees] pour rejoindre le combat.",
        "field": "strDesc",
        "path": "$[82].strDesc",
        "relative_path": "interactions/interactions_combat.json"
    },
    "8e0d76b925d98025910ce1a7b177f4e46ddaa0aa": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "7365efbfd56b07d545039b6d791a3b273f06d4c3": {
        "source": "They haul you before a Galilean Confederacy tribunal for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Port Mojave Brig for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un tribunal de la Confédération galiléenne pour jugement, laissant derrière eux votre navire et votre équipement.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payable en totalité ou en plusieurs versements - ou vous partez à Port Mojave Brig pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "f5db68c4a66e6156223cdee003a9948c6c1a6192": {
        "source": "ENCHeatGalConFineEnd",
        "translation": "ENCHeatGalConFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "cf5477b340589cd462aa9ed6b7b15b64e033b557": {
        "source": "ENCHeatGalConFineDebtEnd",
        "translation": "ENCHeatGalConFineDebtEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "48681d136b0943f385786021e57a76c11c53829f": {
        "source": "ENCHeatGalConPrisonStart",
        "translation": "ENCHeatGalConPrisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "8e18b4711c000ec7a39a4c5cd58f0177f65955f2": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "ed519f17be63be8ecb89e730712c64e094bb16b1": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "c6ee4dde03898900fd44fca2f58a9e2f3d63ef42": {
        "source": "ENCHeatGalConFineFinish",
        "translation": "ENCHeatGalConFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "a9d1a1dcad2fb2a7d897a66422407cafefb97e91": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "6dc67386f62ce0bc90dccfc520ac0fc975fc9321": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "5aa48c817b944a16ac27988dd1907af86f5f561c": {
        "source": "ENCHeatGalConFineFinish",
        "translation": "ENCHeatGalConFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "e3f7f58766a5fcb1aac2da7790615cc14f607be5": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "0d02327cd0ca22a36fd12bd607dcf6f93c9f73d3": {
        "source": "After processing, you are unceremoniously dumped outside the Galilean Confederacy Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l’extérieur du bureau de sécurité de la Confédération galiléenne. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "6d450f42ec325a25f3385dcd6474445e07afc0ab": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "23f518e06f2130021a3b0dec724859cab4f60973": {
        "source": "Off to Port Mojave Brig",
        "translation": "En route pour Port Mojave Brick",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "211167df957ce202d82e51c0b7a217ba9168da9f": {
        "source": "You are hauled off to Port Mojave Brig.",
        "translation": "Vous êtes transporté à Port Mojave Brig.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "003ebf2235bf9e78a79c09f200aeb1f659032edd": {
        "source": "ENCHeatGalConPrisonEnd",
        "translation": "ENCHeatGalConPrisonEnd",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "65aa61e5b73f2767238d7fb884b38701868ed738": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "94b5b00e4cd8ecd642c27b3e1c363868136b7340": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "a6d23bf462ae7533784afb010db0dc266d5e1013": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "f29612e89316378ee9a9018ec59a551aaf48fd4e": {
        "source": "ENCHeatGalConPrisonFinish",
        "translation": "ENCHeatGalConPrisonFinish",
        "field": "aInverse",
        "path": "$[5].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "f344a68b720cfe44beb1545f818e27f2baa8af2a": {
        "source": "CGEncHomeworldLEOEnemy",
        "translation": "CGEncHomeworldLEOEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "cb8458d0e49c7c014abe43e5a11fd83fb61dfca0": {
        "source": "CGEncHomeworldPrisonerFriend",
        "translation": "CGEncHomeworldPrisonerAmi",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[1]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "10e3ec385dd5bbb26b5e303e5ad856ac633f2e90": {
        "source": "CGEncHomeworldCriminalEnemy",
        "translation": "CGEncHomeworldCriminalEnemy",
        "field": "aSocialNew",
