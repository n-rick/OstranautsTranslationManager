    "a42afab7fedf07eeb689fc57e75dbdca14bffe15": {
        "source": "Adds JFTS LEO Arrest pledge to us",
        "translation": "Nous ajoute l'engagement d'arrestation JFTS LEO",
        "field": "strTitle",
        "path": "$[28].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "2c1eb91fc2a6341ebed4a8138e8bb63e110f7dad": {
        "source": "[us] [gains] JFTS LEO Arrest pledge.",
        "translation": "[us] [gains] JFTS LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "04dd733f95655874d0d202c76d52b0864dc6bcd6": {
        "source": "Adds JFTS LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement JFTS LEO Arrest parce que le joueur a volé un navire.",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "e754c9d46914a4db21cab31e982dc40c93b43d7a": {
        "source": "[us] [gains] JFTS LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] JFTS LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "e46d9d22e6b3bae7debd7e0b9c9939b33c661fba": {
        "source": "Adds JFTS LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement JFTS LEO Threat",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "4de411074ff7dcf115c565c66341552bf4f9b774": {
        "source": "[us] [gains] JFTS LEO Threat pledge.",
        "translation": "[us] [gains] Engagement de menace JFTS LEO.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "4273d240e1e85f07d8b0121404de58160252a413": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "e5ff88f0438e2ce9660b1ba323b7c7f580922f64": {
        "source": "They haul you before a Hangzhou magistrate for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Tharsis Landing Brig for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un magistrat de Hangzhou pour jugement, laissant derrière eux votre navire et votre équipement.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payable en totalité ou en plusieurs versements - ou vous partez à Tharsis Landing Brig pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "f1372a1a8f29da56bd12432d3fded13c5d98bac3": {
        "source": "ENCHeatMHNGFineEnd",
        "translation": "ENCHeatMHNGFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "9f32f3c7ae02931594d5bbb17fac207b209c1e84": {
        "source": "ENCHeatMHNGFineDebtEnd",
        "translation": "ENCHeatMHNGFineDetteFin",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "bc3e0a15227b864d523c3b968e8bcbecd1d874fe": {
        "source": "ENCHeatMHNGPrisonStart",
        "translation": "ENCHeatMHNGPrisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "4d610c0281f3830b036ae044152dd7cc6935a76a": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "cef6ff3c51dcae16578a726dd5df9e9c87a1dc7d": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "9d4e6a1bfa5270a747cb36cfa18d2c076230d35a": {
        "source": "ENCHeatMHNGFineFinish",
        "translation": "ENCHeatMHNGFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "4b1371a5fe803008efde02248c34a55a12beb389": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "7e4cfe801682fca31675333ef54b95af93fb029e": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "b10328cfb503c8838ea3c1c010ade6f3829ff794": {
        "source": "ENCHeatMHNGFineFinish",
        "translation": "ENCHeatMHNGFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "5d5c79d57200750372a25f6a3463689a525c8018": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "020fda5887756a5332d240d1788c125b773bebc2": {
        "source": "After processing, you are unceremoniously dumped outside the Tharsis Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l'extérieur du bureau de sécurité de Tharsis. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "954ec4988168aca937b4b7e55f8d4271ad8cb23b": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "e838b9adb099610a2bff75e7b01396ae2440b3c8": {
        "source": "Off to Hangzhou Brig",
        "translation": "En route pour Hangzhou Brick",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "c8a23bd0ce5db126f92fba8e6eb7a2e2f6d7af38": {
        "source": "You are hauled off to Hangzhou Brig.",
        "translation": "Vous êtes transporté à Hangzhou Brig.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "c285df5cc7352546a6583a74ed623cd4d751655c": {
        "source": "ENCHeatMHNGPrisonEnd",
        "translation": "ENCHeatMHNGPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "dffb8414c23bce80c73017987dfee516a67b6796": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "dd761c1e19347577e79ffca290067c7948b4717e": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "71ffc11f21f09e2e669b61c76c4560c8918c7e88": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "5a57ce7518c8dc828bf8e25adea44f3529e2cd64": {
        "source": "ENCHeatMHNGPrisonFinish",
        "translation": "ENCHeatMHNGPrisonTerminer",
        "field": "aInverse",
        "path": "$[5].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "8221e1a4d2aa2d2576a9ffcf071d4ae622202a63": {
        "source": "CGEncHomeworldLEOEnemy",
        "translation": "CGEncHomeworldLEOEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[0]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "4590aa296bdb0d51a12b1fb71aabc10b578e2d56": {
        "source": "CGEncHomeworldPrisonerFriend",
