    "4b5c4df71230d4a8e78ff075d659660579214fe1": {
        "source": "Use PDA Cracking Software",
        "translation": "Utiliser un logiciel de piratage de PDA",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "5f649846fbb2de944847e2ae563af1a80626c2fa": {
        "source": "Even without much hacking practice, you know your way around software well enough to use cracking software.\n\nUsing your unlocked device to run R3N-B00, you scan for compatible devices, and select your target.",
        "translation": "Même sans beaucoup de pratique en matière de piratage informatique, vous connaissez suffisamment bien les logiciels pour utiliser un logiciel de piratage.\n\nEn utilisant votre appareil déverrouillé pour exécuter R3N-B00, vous recherchez des appareils compatibles et sélectionnez votre cible.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "6c9c014f0948194c4f594480b1ef1936610c028e": {
