    "d3c34144e60e643ca4f9812064751d652840e7fd": {
        "source": "JFTS LEO Begins Arresting Criminal for Stealing a Ship",
        "translation": "JFTS LEO commence à arrêter un criminel pour avoir volé un navire",
        "field": "strTitle",
        "path": "$[16].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "641a9a18bb99263242472dadb6432ed68b121921": {
        "source": "\"You've been reported as flying a stolen ship,\" [us] [says], looking at [them].\"We're bringing you in.\"",
        "translation": "\"On vous a signalé que vous pilotiez un vaisseau volé\", [us] [says], regardant [them]. \"Nous vous emmenons.\"",
        "field": "strDesc",
        "path": "$[16].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
