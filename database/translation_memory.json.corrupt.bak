    "d16e1c741e0fb2a182830c50b694dda78d7b5636": {
        "source": "Describe Growing Up on Mars",
        "translation": "Décrire le fait de grandir sur Mars",
        "field": "strTitle",
        "path": "$[258].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "d77df4207b12bf713668857eb76d171e8c5c5d66": {
        "source": "[us] [says] that [us-subj] grew up on Hangzhou Orbital, which is a paradise for those who can afford it. [us-subj] [hopes] to one day have enough money to return there and buy a residential visa.",
        "translation": "[us] [says] que [us-subj] a grandi sur Hangzhou Orbital, qui est un paradis pour ceux qui peuvent se le permettre. [us-subj] [hopes] pour avoir un jour assez d'argent pour y retourner et acheter un visa résidentiel.",
        "field": "strDesc",
        "path": "$[258].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "f67592cb850fd20962fde0f340f765f518afc688": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[258].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "633f354c9b814a3fe82ea429525b2d481d9461c7": {
        "source": "Describe the Worst Parts of Mars",
        "translation": "Décrivez les pires parties de Mars",
        "field": "strTitle",
        "path": "$[259].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "2e8888ff58c49f4609fc3cb03465faf7a7a388f7": {
        "source": "[us] [says] that Tharsis Landing is riven by factional violence. Residents of The Labyrinth are constantly clashing with Martian Security, or else taking their bribes.",
        "translation": "[us] [says] that Tharsis Landing is riven by factional violence. Residents of The Labyrinth are constantly clashing with Martian Security, or else taking their bribes.",
        "field": "strDesc",
        "path": "$[259].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "987dd518b560b5b27182e1b473a3ea17840c1ade": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[259].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "2a4392c662240ec1f269672137b8b59e66239ed4": {
        "source": "Describe a Memory from Mars",
        "translation": "Décrire un souvenir de Mars",
        "field": "strTitle",
        "path": "$[260].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "258eeba60ef30b6037851c8fc882ea0d2d46c5ea": {
        "source": "[us] [recalls] thousands of low single story homes surrounded green siheyuan courtyards. [us] would ride pedicabs down through the hutong because [us-pos] parents wouldn't let [us-obj] ride the metro.",
        "translation": "[us] [recalls] des milliers de maisons basses à un étage entouraient les cours vertes des Siheyuan. [us] voyageait en cyclo-pousse à travers le hutong parce que les parents de [us-pos] ne laissaient pas [us-obj] prendre le métro.",
        "field": "strDesc",
        "path": "$[260].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "e200d485367637c475a0d3cb25a744c0c86b95a2": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[260].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
