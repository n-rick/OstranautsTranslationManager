    "3a03ad9a3502c361699f935506af5dddefc47e78": {
        "source": "OWNG Controversy",
        "translation": "OWNG Controversy",
        "field": "strTitle",
        "path": "$[134].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "dc073cc52af24d7c3dec0dca5cd5db4a657f18e1": {
        "source": "OWNG news is given priority transmission status on all Harper Xiang owned networks such as the Aphrodite-series fixed service satellites. Other sources are frequently deprioritized or even halted completely, such as the live coverage of the Meridian riots by rival news service The New Times in favour of Channel One's interview with Maurice Kapur.\n\nHarper Xiang does not respond to content throttling complaints.",
        "translation": "Les informations OWNG bénéficient d'un statut de transmission prioritaire sur tous les réseaux appartenant à Harper Xiang, tels que les satellites du service fixe de la série Aphrodite. D'autres sources sont souvent dépriorisées, voire complètement interrompues, comme la couverture en direct des émeutes de Meridian par le service d'information rival The New Times en faveur de l'interview de Channel One avec Maurice Kapur.\n\nHarper Xiang ne répond pas aux plaintes de limitation de contenu.",
        "field": "strDesc",
        "path": "$[134].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "7d3ae75595c5c325abb06e2825b08596a116a4e3": {
