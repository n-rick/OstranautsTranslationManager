    "822a6b6ccf323b9be2da8362719764a8892f0c84": {
        "source": "Notify Ayotimiwa Corporate",
        "translation": "Avertir la société Ayotimiwa",
        "field": "strTitle",
        "path": "$[372].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "6736bf85aef841afa6f2224114ac6d27b85833c4": {
        "source": "Maybe you disapprove of the practice, or perhaps it just isn't worth the risk this time. You've been audited before. It's never fun trying to explain where your extra spending money comes from. Whatever your reason, you notify your supervisor, who in turn notifies their supervisor, and again, and so on. A special team is dispatched from the Ayotimiwa HQ prism, who carefully cut out the offending part, place it in a sealed container, and promptly leave it in the exhaust path of a fusion torch.\n\nYou are considered for, but ultimately not awarded, an official letter of commendation. In lieu of said honor you are gifted a t-shirt emblazoned with the Ayotimiwa logo.",
        "translation": "Peut-être que vous désapprouvez cette pratique, ou peut-être que cela n’en vaut tout simplement pas la peine cette fois-ci. Vous avez déjà été audité. Ce n’est jamais amusant d’essayer d’expliquer d’où vient votre argent de poche supplémentaire. Quelle que soit votre raison, vous informez votre superviseur, qui à son tour informe son superviseur, et encore, et ainsi de suite. Une équipe spéciale est dépêchée depuis le prisme du QG d'Ayotimiwa, qui découpe soigneusement la pièce incriminée, la place dans un conteneur scellé et la laisse rapidement dans le chemin d'échappement d'une torche à fusion.\n\nVous êtes pris en considération pour une lettre de félicitations officielle, mais vous ne la recevez finalement pas. Au lieu de cet honneur, vous recevez un t-shirt arborant le logo Ayotimiwa.",
        "field": "strDesc",
        "path": "$[372].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "362a886972fc9165badb2064c73d7daa17104dfa": {
        "source": "CGEncHomeworldManagerContact",
        "translation": "CGEncAccueilmondeManagerContact",
        "field": "aSocialNew",
