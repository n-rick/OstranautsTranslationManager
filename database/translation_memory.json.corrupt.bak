    "8c3c4d09d102734c3bc90c5714c1473b1f956e93": {
        "source": "A file indicating it was triggered to send in case of the sender's death. The rambling contents include paranoid ravings about ghosts out to get them due to what they know.",
        "translation": "Un fichier indiquant que son envoi a été déclenché en cas de décès de l'expéditeur. Le contenu décousu comprend des délires paranoïaques sur les fantômes pour les chasser en raison de ce qu'ils savent.",
        "field": "strDesc",
        "path": "$[46].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "8efea1fa63c91e1f001928e57470fbbc4dfed262": {
        "source": "HAND_OF_DEATH.IMG",
        "translation": "HAND_OF_DEATH.IMG",
        "field": "strTitle",
        "path": "$[47].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "a7d206ed7dcfefd7bfb944e51cb10eddc5c5816a": {
        "source": "A low-res image of somebody's skin with a bruised or blackened wound in the shape of a long-fingered hand.",
        "translation": "Image basse résolution de la peau d'une personne présentant une plaie meurtrie ou noircie en forme de main aux longs doigts.",
        "field": "strDesc",
        "path": "$[47].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "6b41fdbc17611a6522b4f43fec9bf1223ad97e24": {
        "source": "BEWARE_THE_HAND.TXT",
        "translation": "BEWARE_THE_HAND.TXT",
        "field": "strTitle",
        "path": "$[48].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "21fcb0f2969203fa976f7a13ae45e1467028fa01": {
        "source": "Meandering serial killer creepypasta about a string of probably-fictional people turning up dead without fatal injuries, only skin burns or bruises in the shape of a long-fingered hand.",
        "translation": "Creepypasta de tueur en série sinueux sur une série de personnes probablement fictives retrouvées mortes sans blessures mortelles, seulement des brûlures cutanées ou des contusions en forme de main aux longs doigts.",
        "field": "strDesc",
        "path": "$[48].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "64d1c3dd9d43ffda7a426dae0794078ba401afa3": {
        "source": "DEATH_OF_A_LEGEND.TXT",
