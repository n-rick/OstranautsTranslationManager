    },
    "34993e93f982b5317ed50031610b7ceb9d15e64b": {
        "source": "<b>Government:</b> Presidential republic\n<b>Head of state:</b> President Lydia Walker\n<b>Sovereignty:</b> Independent (formerly US-owned)\n<b>Location:</b> Europa\n<b>Established:</b> 2035\n<b>Major ports:</b> Porto Nuevo\n<b>Industries:</b> Water mining, xenobiology\n<b>Currency:</b> USD\n<b>Population estimate:</b> 200,000\n<b>Languages:</b> English\n<b>Religions:</b> Christianity",
        "translation": "<b>Gouvernement :</b> République présidentielle\n<b>Chef de l'État :</b> Présidente Lydia Walker\n<b>Souveraineté :</b> Indépendant (anciennement détenu par les États-Unis)\n<b>Lieu :</b> Europe\n<b>Créé :</b> 2035\n<b>Principaux ports :</b> Porto Nuevo\n<b>Industries :</b> Extraction de l'eau, xénobiologie\n<b>Devise :</b> USD\n<b>Estimation de la population :</b> 200 000\n<b>Langues :</b> Anglais\n<b>Religions :</b> Christianisme",
        "field": "strDesc",
        "path": "$[56].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "f9b74c39f896ff8403d5fe171bb8343310c8da25": {
        "source": "DataWIKIAtlantis",
