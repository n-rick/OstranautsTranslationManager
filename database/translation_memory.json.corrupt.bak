    "278a4fd61b8ce86463200341040338921df87da9": {
        "source": "Jade Rabbit, Luna, moon of Earth",
        "translation": "Lapin de Jade, Luna, lune de la Terre",
        "field": "strTitle",
        "path": "$[70].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "92352a093b24cd1f2722c555abb14db3a7e0fa7d": {
        "source": "Jade Rabbit (Yutu, 玉兔) is the oldest offworld colony in the System besides the International Space Station. It began as a research base established in 2021, shortly after the completion of China's space elevator. It was named for the Chinese lunar rover, which was itself named for the pet rabbit of Chang'e, the goddess of the Moon in Chinese mythology.",
        "translation": "Jade Rabbit (Yutu, 玉兔) est la plus ancienne colonie extra-mondaine du système en dehors de la Station spatiale internationale. Il s'agissait à l'origine d'une base de recherche créée en 2021, peu après l'achèvement de l'ascenseur spatial chinois. Il doit son nom au rover lunaire chinois, lui-même nommé en hommage au lapin de compagnie de Chang'e, la déesse de la Lune dans la mythologie chinoise.",
        "field": "strDesc",
        "path": "$[70].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
