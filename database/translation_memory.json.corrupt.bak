    "64316efbdcbdc89b57b64a40b6998c3eb12c6579": {
        "source": "[us] [gains] EJDR LEO Arrest pledge.",
        "translation": "[us] [gains] EJDR LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "5da3c6bc791df9e1026506b902958aec30399b3d": {
        "source": "Adds EJDR LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement d'arrestation EJDR LEO car le joueur a volé un navire.",
        "field": "strTitle",
