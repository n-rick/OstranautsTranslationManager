    "6a7aefce6d5623f26880ec393db075e00ac669ab": {
        "source": "Ring Station, near Ceres in the Belt",
        "translation": "Ring Station, près de Cérès dans la Ceinture",
        "field": "strTitle",
        "path": "$[99].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "96589141e18a274fbc22a7457966712168774fa7": {
        "source": "Ring Station (Quanzhan, 圈站) is a large centrifugal habitat in near-Ceres space, and the administrative centre of the Coalition for Ceres Resource Extraction. Its sphere of influence includes Calico City, a settlement on Ceres' surface. The CCRE maintains the Belt's mining operations, its member entities being the thirty largest mining corporations in the region. Smaller corporations must apply for associate status, approved on a case-by-case basis.",
        "translation": "Ring Station (Quanzhan, 圈站) est un grand habitat centrifuge dans l'espace proche de Cérès et le centre administratif de la Coalition pour l'extraction des ressources de Cérès. Sa sphère d'influence comprend Calico City, une colonie située à la surface de Cérès. Le CCRE maintient les opérations minières de la Ceinture, ses entités membres étant les trente plus grandes sociétés minières de la région. Les petites entreprises doivent demander le statut d'associé, approuvé au cas par cas.",
        "field": "strDesc",
        "path": "$[99].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
