    "5d0b44a61f3e5016c76d9c82fdd8805d968fe0c4": {
        "source": "Hangzhou Statistics",
        "translation": "Statistiques de Hangzhou",
        "field": "strTitle",
        "path": "$[66].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "e7a9e25926f4bef6788cf02565cc8868c1a4ec6d": {
        "source": "<b>Government:</b> Plutocracy\n<b>Head of state:</b> President Bai Zhihao\n<b>Sovereignty:</b> Independent\n<b>Location:</b> Mars L5\n<b>Established:</b> Construction began 2035, completed 2055\n<b>Major ports:</b> Qiantangmen (钱塘门)\n<b>Industries:</b> Financial services, agriculture\n<b>Currency:</b> XNY\n<b>Population estimate:</b> 3,000,000\n<b>Languages:</b> Mandarin, English\n<b>Religions:</b> Buddhism, Christianity, Islam, Hinduism",
        "translation": "<b>Gouvernement :</b> Plutocratie\n<b>Chef de l'État :</b> Président Bai Zhihao\n<b>Souveraineté :</b> Indépendant\n<b>Emplacement :</b> Mars L5\n<b>Établi :</b> La construction a commencé en 2035 et s'est achevée en 2055\n<b>Principaux ports :</b> Qiantangmen (钱塘门)\n<b>Industries :</b> Services financiers, agriculture\n<b>Devise :</b> XNY\n<b>Estimation de la population :</b> 3 000 000\n<b>Langues :</b> Mandarin, Anglais\n<b>Religions :</b> Bouddhisme, Christianisme, Islam, Hindouisme",
        "field": "strDesc",
        "path": "$[66].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "b5a35c17822189a827fbaa9a674487b0bbf51481": {
        "source": "DataWIKIHangzhou",
