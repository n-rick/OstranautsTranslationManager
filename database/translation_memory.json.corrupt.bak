    "c795410cc0dd62b34833564d201d5c8c132c63ef": {
        "source": "Moretti Coffee",
        "translation": "Café Moretti",
        "field": "strTitle",
        "path": "$[124].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "8764502589bd2c3ca5868b3cf4a274a8bd531a5b": {
        "source": "The Moretti brand was established in 2023. Moretti Coffee today is a rebranding of Pan Euspresso, which was a rebranding of the original Moretti Coffee. The brand was subject to prevailing opinion on the cohesion of the European Union. It was rebranded first to appeal to a reaffirmed, reunited Europe, then changed back during Europe's decline, in the hope that the Moretti name still sold coffee. To the surprise of investors, it did.\n\n<b>Product:</b> Coffee\n<b>Manufacturer:</b> Moretti Coffee Company\n<b>Country of origin:</b> societas Europaea\n<b>Ticker symbol:</b> MORC\n\n<b>Slogans:</b>\nRich, dark, the way you like it.\nHave more. Have Moretti.\nWhen you can choose, you choose Moretti.\nSpecial brew, just for you.\nOur blend. Your brew.",
        "translation": "La marque Moretti a été créée en 2023. Moretti Coffee est aujourd'hui une nouvelle image de Pan Euspresso, qui était une nouvelle image de marque du Moretti Coffee original. La marque était soumise à l'opinion dominante sur la cohésion de l'Union européenne. Il a d'abord été rebaptisé pour faire appel à une Europe réaffirmée et réunifiée, puis modifié lors du déclin de l'Europe, dans l'espoir que le nom Moretti vende toujours du café. À la surprise des investisseurs, ce fut le cas.\n\n<b>Produit :</b> Café\n<b>Fabricant :</b> Moretti Coffee Company\n<b>Pays d'origine :</b> societas Europaea\n<b>Symbole boursier :</b> MORC\n\n<b>Slogans :</b>\nRiche, sombre, comme vous l'aimez.\nAyez plus. Demandez à Moretti.\nQuand vous pouvez choisir, vous choisissez Moretti.\nInfusion spéciale, rien que pour vous.\nNotre mélange. Votre bière.",
        "field": "strDesc",
        "path": "$[124].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "06299d1da1d794dd70d2b5476f8d99888ec77007": {
        "source": "DataWIKIMorettiCoffeeHistory",
        "translation": "DataWIKIMorettiCoffeeHistory",
        "field": "aInverse",
        "path": "$[124].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "fb574e145e0cf25450083586fc2ab203962947ca": {
        "source": "Moretti Coffee Marketing",
        "translation": "Marketing du café Moretti",
        "field": "strTitle",
        "path": "$[125].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "36b03f0f82d0d99685c8815567cf74768f70c096": {
        "source": "Moretti is a personification used as the brand's mascot. In the twenties he spread across social media by streaming regular 'fireside chats' set in a snowed-in chalet. Moretti shuffled around the chalet as he made coffee, told stories, and played checkers against viewers. Today Moretti Coffee Company sells hologram sims of Moretti designed to keep coffee drinkers company, or regale audiences with dynamically generated stories of the old country.\n\nThe coffee is a Robusta blend targeted at high-income consumers. Moretti Coffee is partnered with upmarket cafe culture and supplies large scale corporate demands.",
        "translation": "Moretti is a personification used as the brand's mascot. In the twenties he spread across social media by streaming regular 'fireside chats' set in a snowed-in chalet. Moretti shuffled around the chalet as he made coffee, told stories, and played checkers against viewers. Today Moretti Coffee Company sells hologram sims of Moretti designed to keep coffee drinkers company, or regale audiences with dynamically generated stories of the old country.\n\nThe coffee is a Robusta blend targeted at high-income consumers. Moretti Coffee is partnered with upmarket cafe culture and supplies large scale corporate demands.",
        "field": "strDesc",
        "path": "$[125].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "c682294f272a94370c6c8f2bf7ebb2a115e6f797": {
        "source": "DataWIKIMorettiCoffee",
        "translation": "DonnéesWIKIMorettiCoffee",
        "field": "aInverse",
        "path": "$[125].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "f41ea533b27127a3368d47d741d5586541ae9c8c": {
        "source": "Ogiso's Register",
        "translation": "Ogiso's Register",
        "field": "strTitle",
        "path": "$[126].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "4fb49a96e4d1f5aa86f124e6651e2a1e9796099d": {
        "source": "Ogiso's Register is an insurance marketplace, the largest insurance service for space travel-related ventures in the System. Members of Ogiso's provide capital to underwrite the insurance policies, and come together in syndicates to spread risk. Ogiso's Brokers facilitate the risk transfer between syndicates and policyholders. Ogiso's also assesses the maintenance and worthiness of vessels and stations and publishes these assessments in a titular Register of Ships. Discrete, unincorporated members of the marketplace are known and referred to in media as Agencies. Ogiso's Register is reputed both for honouring its contracts and recovering the debts it is owed.\n\n<b>Industry:</b> Insurance\n<b>Country of origin:</b> Nigeria\n<b>Key people:</b> Adaku Temile (CEO)\n<b>Headquarters:</b> Lombardy, Suzhou Orbital\n<b>Ticker symbol:</b> OGIS\n\n<b>Slogans:</b>\n\nPrimum inter pares ('First among peers')\n\nLong arms and deep pockets",
        "translation": "Ogiso's Register is an insurance marketplace, the largest insurance service for space travel-related ventures in the System. Members of Ogiso's provide capital to underwrite the insurance policies, and come together in syndicates to spread risk. Ogiso's Brokers facilitate the risk transfer between syndicates and policyholders. Ogiso's also assesses the maintenance and worthiness of vessels and stations and publishes these assessments in a titular Register of Ships. Discrete, unincorporated members of the marketplace are known and referred to in media as Agencies. Ogiso's Register is reputed both for honouring its contracts and recovering the debts it is owed.\n\n<b>Industry:</b> Insurance\n<b>Country of origin:</b> Nigeria\n<b>Key people:</b> Adaku Temile (CEO)\n<b>Headquarters:</b> Lombardy, Suzhou Orbital\n<b>Ticker symbol:</b> OGIS\n\n<b>Slogans:</b>\n\nPrimum inter pares ('First among peers')\n\nLong arms and deep pockets",
        "field": "strDesc",
        "path": "$[126].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "86c9b912d6be13518fc6c27268f7b5c3e3bbf3b4": {
        "source": "DataWIKIOgisosRegisterHistory",
        "translation": "DonnéesWIKIOgisosRegisterHistorique",
