    "7da12dafb3eb0bc812fe1febb1e579c80397c1f4": {
        "source": "MSUZ LEO Attacking Criminal",
        "translation": "MSUZ LEO attaquant un criminel",
        "field": "strTitle",
        "path": "$[15].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "e912ae140e14330792ad62cd17e7ed05d7e53666": {
        "source": "\"Hey, it's that criminal! Get 'em!\" [us-shouts] [us], pointing towards [them].",
        "translation": "\"Hé, c'est si criminel ! Attrapez-les !\" [us-shouts] [us], pointant vers [them].",
        "field": "strDesc",
        "path": "$[15].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "48a52ca72dc2899dc0f8be3e5ea6f6abd70b9839": {
        "source": "PLGAICrimeMSUZLEOInterruptSelf",
        "translation": "PLGAICrimeMSUZLEOInterruptionLui",
        "field": "aInverse",
        "path": "$[15].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "cd8daefefcee0226cd54eaaa6fc59127b9b1af78": {
        "source": "MSUZ LEO Begins Arresting Criminal for Stealing a Ship",
        "translation": "MSUZ LEO commence à arrêter un criminel pour avoir volé un navire",
        "field": "strTitle",
        "path": "$[16].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "f195b1ef1ce016397da97aab85c37da0cd93f24d": {
        "source": "\"You've been reported as flying a stolen ship,\" [us] [says], looking at [them].\"We're bringing you in.\"",
        "translation": "\"On vous a signalé que vous pilotiez un vaisseau volé\", [us] [says], regardant [them]. \"Nous vous emmenons.\"",
        "field": "strDesc",
        "path": "$[16].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "b7364f23719d26b4491f06ec8dd81dadf2bafb17": {
