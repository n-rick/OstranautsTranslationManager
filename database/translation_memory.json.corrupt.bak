    "41d0735b8398d3727eded6ed9fc8cfcc36ca534f": {
        "source": "Tripura Marketing Vision",
        "translation": "Tripura Marketing Vision",
        "field": "strTitle",
        "path": "$[155].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "4fe0fa6ad803250edba815fe4f3f82a5729dc2c7": {
        "source": "<b>Common Branding:</b>\n\nBrewed with 100% natural ingredients and love, our teas bring you to a higher plane of CONSCIOUSNESS and WELL-BEING with every cup :) Each hand-picked tea blossom is the result of hours of CARE and ATTENTION by our venerable growers :) So you know that when you buy from TRIPURA you are buying PEACE OF MIND\n\nTRIPURA: There are THREE CITIES of God's creation. The PHYSICAL, the ASTRAL, and the CAUSAL. SUNDARI: BEAUTY without parallel. TRIPURA SUNDARI is the GREAT COSMIC WISDOM who manifests the fundamental aspects of DIVINITY. She is with you while you WAKE, when you DREAM, when you SLEEP WITHOUT DREAMING. Whether you drink Tripura for a PURE MIND or PEACEFUL SLEEP, you enter a COMMUNE with the SUPREME BEAUTY OF PURE PERCEPTION",
        "translation": "<b>Marque commune :</b>\n\nInfusés avec des ingrédients 100 % naturels et avec amour, nos thés vous amènent à un niveau supérieur de CONSCIENCE et de BIEN-ÊTRE à chaque tasse :) Chaque fleur de thé cueillie à la main est le résultat d'heures de SOINS et d'ATTENTION de la part de nos vénérables producteurs :) Vous savez donc que lorsque vous achetez chez TRIPURA, vous achetez la TRANQUILLITÉ D'ESPRIT.\n\nTRIPURA : Il y a TROIS VILLES de la création de Dieu. Le PHYSIQUE, l’ASTRAL et le CAUSAL. SUNDARI : BEAUTÉ sans parallèle. TRIPURA SUNDARI est la GRANDE SAGESSE COSMIQUE qui manifeste les aspects fondamentaux de la DIVINITÉ. Elle est avec vous pendant que vous vous RÉVEILLEZ, lorsque vous RÊVEZ, lorsque vous DORMEZ SANS RÊVER. Que vous buviez du Tripura pour un ESPRIT PUR ou un SOMMEIL PAISIBLE, vous entrez dans une COMMUNE avec la BEAUTÉ SUPRÊME DE LA PURE PERCEPTION",
        "field": "strDesc",
        "path": "$[155].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "3209a334fb7303a83b2f1d78def8de6528ed5c55": {
        "source": "DataWIKITripura",
        "translation": "DataWIKITripura",
        "field": "aInverse",
        "path": "$[155].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
