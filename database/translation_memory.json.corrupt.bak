    "c6d41ea5cdd06d92640be18236dc7c99eca457b5": {
        "source": "Offer Party Supplies",
        "translation": "Offrir des fournitures de fête",
        "field": "strTitle",
        "path": "$[181].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "94d278d638a5a767c05cc97add2e486b2e091b30": {
        "source": "[us] [says] [us-subj] pulled security detail for Ayo exec party up in NoCo and it was quite the soiree.\nThe host gave them a case of leftover booze as a parting gift.\nWant it?",
        "translation": "[us] [says] [us-subj] a rassemblé les services de sécurité pour la fête des dirigeants d'Ayo à NoCo et c'était toute une soirée.\nL'hôte leur a offert une caisse d'alcool restant en guise de cadeau d'adieu.\nVous le voulez ?",
        "field": "strDesc",
        "path": "$[181].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "12448fa0dd7f8079b7fd899ad2f0af33b8e3d0fe": {
