        "relative_path": "interactions/interactions_datafiles.json"
    },
    "cab6cfc386e0580a8eb64ea06393a32d3bb6adbd": {
        "source": "A tabloid obituary sensationalizing the life of a famous local lounge-singer Black Orchid.",
        "translation": "Une nécrologie de tabloïd sensationnalisant la vie d'un célèbre chanteur de lounge local, Black Orchid.",
        "field": "strDesc",
        "path": "$[49].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "ddcb03d47ca54bfce6382b72051a4c0db697fe1b": {
        "source": "Nnamdi Azikiwe Station, 'K-Leg'",
        "translation": "Station Nnamdi Azikiwe, « K-Leg »",
        "field": "strTitle",
        "path": "$[50].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "4ac4f3742ae6a6c79999327fca3f699dc45397bb": {
        "source": "K-Leg is the customary name for Nnamdi Azikiwe Station, a wildcat Nigerian colony on 1036 Ganymed. Ganymed is a 33 km diameter asteroid in an eccentric near-Earth orbit, like Eros, which also passes near Mars. K-Leg acts both as an occasional stopover point for Belt/Mars/Earth travel and a hub for spacefarers, but is most well-known for its shipbreaking services and facilities.",
        "translation": "K-Leg est le nom habituel de la station Nnamdi Azikiwe, une colonie sauvage nigériane située sur 1036 Ganymed. Ganymed est un astéroïde de 33 km de diamètre sur une orbite géocroiseur excentrique, comme Eros, qui passe également près de Mars. K-Leg sert à la fois de point d'escale occasionnel pour les voyages Ceinture/Mars/Terre et de plaque tournante pour les astronautes, mais est surtout connu pour ses services et installations de démolition de navires.",
        "field": "strDesc",
        "path": "$[50].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
