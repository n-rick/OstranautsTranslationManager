        "relative_path": "interactions/interactions_datafiles.json"
    },
    "23d5498a045ad18efe3da45c49df7c597bf003c1": {
        "source": "DataWIKIOgisosRegisterInsurance",
        "translation": "DonnéesWIKIOgisosS'inscrireAssurance",
        "field": "aInverse",
        "path": "$[129].aInverse[2]",
