    "12bd998a8ffc115603e29be986185e44fb622be0": {
        "source": "Talk About the Black Market",
        "translation": "Parlez du marché noir",
        "field": "strTitle",
        "path": "$[169].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "0db87b95ff506d389d15512c57a5315daa7df16b": {
        "source": "[us] [says] [us-subj] are beginning to think that the Black Market fixer who hangs out in The Mescaform is actually on the Ayotimiwa payroll.",
        "translation": "[us] [says] [us-subj] commencent à penser que les fixateurs du marché noir qui traînent au Mescaform sont en fait salariés d'Ayotimiwa.",
        "field": "strDesc",
        "path": "$[169].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "5b298fb038e3d9f6d37f3bcbba56224ee12ea7be": {
