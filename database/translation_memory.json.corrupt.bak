        "translation": "MVOL LEO attaquant un criminel",
        "field": "strTitle",
        "path": "$[15].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "8c99a162d60f369704d1d2bd583012a25792e7d9": {
        "source": "\"Hey, it's that criminal! Get 'em!\" [us-shouts] [us], pointing towards [them].",
        "translation": "\"Hé, c'est si criminel ! Attrapez-les !\" [us-shouts] [us], pointant vers [them].",
        "field": "strDesc",
        "path": "$[15].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "b214fd4ec9838a5c21b3340f05b07716a7cebf09": {
