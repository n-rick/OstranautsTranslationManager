    },
    "e1bb13cd34813ad0deac7f98be8a3408fba125c7": {
        "source": "[us] says you're a criminal, but that won't stop me from talking favors with you.",
        "translation": "[us] dit que vous êtes un criminel, mais cela ne m'empêchera pas de vous demander des services.",
        "field": "strDesc",
        "path": "$[9].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "72017130a7825958a93611de8070ab30923cbef0": {
        "source": "Agree to Discuss Favors Filthy",
        "translation": "Accepter de discuter de faveurs sales",
        "field": "strTitle",
        "path": "$[10].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "c9ab0fe892970657f09bc6c2cffdac21d96ba71b": {
        "source": "[us] says god you're filthy. But okay, we can talk favors.",
        "translation": "[us] dit que tu es sale. Mais d'accord, nous pouvons parler de faveurs.",
        "field": "strDesc",
        "path": "$[10].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "3b1750d919607c8dddc16204ea4facd99459f91f": {
        "source": "Agree to Discuss Favors Physio Bad",
        "translation": "Accepter de discuter des faveurs de Physio Bad",
        "field": "strTitle",
        "path": "$[11].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "5f635017aa04b42c3a2ceef07c496980b07acfb9": {
        "source": "[us] says you look like you need an ambulance, not a favor.",
        "translation": "[us] dit que vous semblez avoir besoin d'une ambulance, pas d'une faveur.",
        "field": "strDesc",
        "path": "$[11].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "2f61a15e7f251425411b1a04425bc66390e9beb4": {
        "source": "Agree to Discuss Favors Us Has Blank Trait",
        "translation": "Accepter de discuter des faveurs dont nous disposons a un trait vide",
        "field": "strTitle",
        "path": "$[12].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "6b0bf3f92261f20d85f5d0d556058a5ad3ea5626": {
        "source": "[us] says I have the blank trait, so I will discuss favors.",
        "translation": "[us] dit que j'ai le trait vide, je vais donc discuter des faveurs.",
        "field": "strDesc",
        "path": "$[12].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "515482634c962e8ff6543961f7fce23057eb8b09": {
        "source": "Agree to Discuss Favors Us Ignoring Cooldown",
        "translation": "Accepter de discuter de nos faveurs en ignorant le temps de recharge",
        "field": "strTitle",
        "path": "$[13].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "03ea92cf27a1838788d40183d4d11c7071618e44": {
        "source": "[us] says I don't care what I said before, so I will discuss favors.",
        "translation": "[us] dit que je me fiche de ce que j'ai dit auparavant, alors je vais discuter des faveurs.",
        "field": "strDesc",
        "path": "$[13].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "9d13d7493ff04a2c0b2b17eedc6acc236b98a4bb": {
