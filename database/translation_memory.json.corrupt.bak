    "06640ee4de4d786e7da61fc2deeede62e5d37be0": {
        "source": "Ring Station Government",
        "translation": "Gouvernement de la station périphérique",
        "field": "strTitle",
        "path": "$[102].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "a534a344f74e2902abc94af0d087ce5433211c91": {
        "source": "The CCRE is an oligarchy of the 30 biggest regional corporations. This status is determined by the Ceres Bureau of Business Valuation, one of its few independent branches of government. 'The Thirty' each choose a delegate to represent their interests in the Coalition. The delegates elect the Speaker for the Coalition, and negotiate and debate Coalition policy which, in theory, should benefit all the participants equally, or at least, in aggregate, preference none. Votes are typically blind and the sessions are in camera. In practise, this means that informal deals, voting blocs, and trading favours are commonplace in the Coalition government.",
        "translation": "Le CCRE est une oligarchie des 30 plus grandes sociétés régionales. Ce statut est déterminé par le Ceres Bureau of Business Valuation, l'une de ses rares branches indépendantes du gouvernement. Les « Trente » choisissent chacun un délégué pour représenter leurs intérêts au sein de la Coalition. Les délégués élisent le président de la coalition, négocient et débattent de la politique de la coalition qui, en théorie, devrait bénéficier à tous les participants de manière égale, ou du moins globalement, de préférence à aucun. Les votes se déroulent généralement à l’aveugle et les séances se déroulent à huis clos. En pratique, cela signifie que les accords informels, les blocs de vote et les échanges de faveurs sont monnaie courante au sein du gouvernement de coalition.",
        "field": "strDesc",
        "path": "$[102].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "da9ee590678054a51f2568c5018fa38d9751318c": {
        "source": "DataWIKIRingStation",
        "translation": "DonnéesWIKIRingStation",
        "field": "aInverse",
