    "ce8ab57c19a7581d21c300ca1eee1eb688f0f34a": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "a6c4d1e24685c213c4731d3258b408e1577a89d1": {
        "source": "After processing, you are unceremoniously dumped outside the Hangzhou Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie devant le bureau de sécurité de Hangzhou. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "c925788046118294623dac056a54ffb8b648e58c": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[6].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
