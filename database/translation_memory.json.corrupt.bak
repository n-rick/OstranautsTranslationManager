    "4e0e4a074dd96ad9fff5376ae10f37748f88d6f3": {
        "source": "Adds MTRS LEO Arrest pledge to us",
        "translation": "Nous ajoute l'engagement d'arrestation MTRS LEO",
        "field": "strTitle",
        "path": "$[28].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "155220bbe81c8055d1b1386efad31c441b6355ef": {
        "source": "[us] [gains] MTRS LEO Arrest pledge.",
        "translation": "[us] [gains] MTRS LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "8446bef360b7cce62157902871ca21f807467662": {
        "source": "Adds MTRS LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement MTRS LEO Arrest parce que le joueur a volé un navire.",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "8e3fc66356d8c744cbd18488677d9ae3b5954109": {
        "source": "[us] [gains] MTRS LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] MTRS LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "4364631ff7fa167c3ff797f49ff6fb758201899e": {
        "source": "Adds MTRS LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement MTRS LEO Threat",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "1f5e8fc492cba7bd4c4f5adfa6f4436a3e61f837": {
        "source": "[us] [gains] MTRS LEO Threat pledge.",
        "translation": "[us] [gains] Engagement de menace MTRS LEO.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "31b50f87c0f2ce5fb13e9c48bf5b74e9a8febaf5": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "0344f8143b12692d97e24de4ae0cdca0be960ce6": {
        "source": "They haul you before a Xinhua magistrate for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Voltaire Brig for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un magistrat de Xinhua pour jugement, laissant derrière eux votre navire et votre équipement.\n\nLors de l'audience, vous pouvez mendier une simple amende - 15 000 $ payable en totalité ou en plusieurs fois - ou vous partez à Voltaire Brig pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "8db2b63d24ab87f5fef99fa484ddb66482812a55": {
        "source": "ENCHeatMVOLFineEnd",
        "translation": "ENCHeatMVOLFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "66969c36ead8dc0700900a0d7d5c815773075d11": {
        "source": "ENCHeatMVOLFineDebtEnd",
        "translation": "ENCHeatMVOLFineDetteFin",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "83eab8567667db4cd1c3b75860a9e4c12d125d11": {
        "source": "ENCHeatMVOLPrisonStart",
        "translation": "ENCHeatMVOLPrisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "0d5e9542d34a33939fb17c7366b9e2d951d769ac": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "cb4ca9936bf7e55e47582148797c02e6221979d2": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "65d5b0f83c0d8880455a920c6b8a5907b492bd5c": {
        "source": "ENCHeatMVOLFineFinish",
        "translation": "ENCHeatMVOLFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "0bca635dfafc6577cda41f9d0cc2d843ea721122": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "53ccd23aca64bfbc4f0159a4f103268b0039d659": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "abb69a2cbf1acdf61cc4d4070965c76c44a0a48b": {
        "source": "ENCHeatMVOLFineFinish",
        "translation": "ENCHeatMVOLFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "ab0f19651b780ad6d4aa2500795b7470c4e0ae6e": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "2f6494ace87636763ac1820284e6a920599eb12b": {
        "source": "After processing, you are unceremoniously dumped outside the Voltaire Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après traitement, vous êtes jeté sans cérémonie à l’extérieur du bureau de sécurité de Voltaire. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "82b1f6f869634a87c605cda7348a09e7481af816": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "f1bbbb901f0159f00f3052585f647f9931565043": {
        "source": "Off to Voltaire Brig",
        "translation": "En route pour Voltaire Brick",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "e2ab6a6404b8fcbaaea1c3d0e55a79b942b7d437": {
        "source": "You are hauled off to Voltaire Brig.",
        "translation": "Vous êtes transporté à Voltaire Brick.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "b8dc77d4292dcddfdedff9644a72fadd2385f7bb": {
        "source": "ENCHeatMVOLPrisonEnd",
        "translation": "ENCHeatMVOLPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "cdbe53e92cedd147bd7d81ebc1a913781ab68c68": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "8cb856f3431981ea05ff1d7297733922b9d1c812": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "60f708103e6e6092eb85fe0de3b29abd4eab6f3d": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "7cecf4f586167ce6bb1cfc2ba7fb361fb526c82a": {
        "source": "ENCHeatMVOLPrisonFinish",
        "translation": "ENCHeatMVOLPrisonFinish",
        "field": "aInverse",
        "path": "$[5].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "3aeb9b1bec6acd59485469be5fb414b0167b7bf0": {
        "source": "CGEncHomeworldLEOEnemy",
        "translation": "CGEncHomeworldLEOEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "19ba2f0eba6b1ac6d9fa768f14bb009211af030a": {
        "source": "CGEncHomeworldPrisonerFriend",
        "translation": "CGEncHomeworldPrisonerAmi",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[1]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "f7bf7370fb6a5905bde5a0421a75ba0ba63cd0bf": {
        "source": "CGEncHomeworldCriminalEnemy",
        "translation": "CGEncHomeworldCriminalEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[2]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "e2d92624232d14999fa5466323f18b75efc7df11": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "085145c13aab5f37b386cfaaad4a76c63e0bf68f": {
        "source": "After processing, you are unceremoniously dumped outside the Voltaire Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après traitement, vous êtes jeté sans cérémonie à l’extérieur du bureau de sécurité de Voltaire. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "8ab2789360f5bdd7dac9456b21efbc996aef5eaa": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[6].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "7d8f18425f527512e1bb2082e92b980820792c34": {
        "source": "MVOL LEO Begins Arresting Criminal",
        "translation": "MVOL LEO commence à arrêter un criminel",
        "field": "strTitle",
        "path": "$[7].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "a0a75fe78c65c2b4bea4164c209beaffbf84daa4": {
        "source": "\"Suspect spotted,\" [us] [says], looking at [them].",
        "translation": "\"Suspect repéré\", [us] [says], regardant [them].",
        "field": "strDesc",
        "path": "$[7].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "ea837688d11affc3a1cac4950341afbb6e3541f1": {
        "source": "PLGAICrimeMVOLLEOInterruptSelf",
        "translation": "PLGAICrimeMVOLLEOInterruptionLui",
        "field": "aInverse",
        "path": "$[7].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "7ed1ce2c5bd458ec92d67795ed12b4140b47f0ad": {
        "source": "MVOL LEO Is Interrupted by Crime",
        "translation": "MVOL LEO est interrompu par le crime",
        "field": "strTitle",
        "path": "$[8].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "4432ef9c1f2eaf0090845bc0ae112573cc30140d": {
        "source": "Interrupt them.",
        "translation": "Interrompez-les.",
        "field": "strDesc",
        "path": "$[8].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "8735dcd896c30d4fb9557d69d113ec3e79db71de": {
        "source": "Arresting Criminal",
        "translation": "Arrêter un criminel",
        "field": "strTitle",
        "path": "$[9].strTitle",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "a75e9a5eed38188f000631b85dde33c2ed2f1a4b": {
        "source": "\"Stop right there! You're under arrest!\" [us] [shouts] at [them].",
        "translation": "\"Arrêtez-vous là ! Vous êtes en état d'arrestation !\" [us] [shouts] à [them].",
        "field": "strDesc",
        "path": "$[9].strDesc",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "b39fa5411cbb7a6cd77740296494600a4159c16b": {
        "source": "PLGAICrimeMVOLLEOArrestDoDeny",
        "translation": "PLGAICrimeMVOLLEOArrestationFaireRefuser",
        "field": "aInverse",
        "path": "$[9].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MVOL.json"
    },
    "31b3a701236d48b3f7c2d43ad592c71abfae1ac8": {
