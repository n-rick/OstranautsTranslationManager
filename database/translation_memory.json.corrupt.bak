    "d04903854ad4e9c9df3345e5d80aecce6f27ba63": {
        "source": "[us] [says] that Officer [3rd] [has] caught wind of a black market being run out of the Mescaform. But seeing as Officer [3rd] is a friend, [us] might be able to throw [3rd-obj] off the scent. Assuming [them] [is] willing to play nice.",
        "translation": "[us] [says] que l'agent [3rd] [has] a eu vent d'un marché noir géré à partir du Mescaform. Mais étant donné que l'agent [3rd] est un ami, [us] pourrait peut-être dérouter [3rd-obj]. En supposant que [them] [is] soit prêt à jouer gentiment.",
        "field": "strDesc",
        "path": "$[22].strDesc",
        "relative_path": "interactions/interactions_fixer.json"
    },
    "12f0c1a2a347c15b418a128a3febdc65aa45bcb4": {
