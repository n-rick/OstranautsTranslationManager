    "afad16a0ac5989c9838c36c10e73c472717aa3bd": {
        "source": "Unlock PDA",
        "translation": "Déverrouiller le PDA",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "7efb084a14440493ea7db8d76d084d752b6b5044": {
        "source": "This PDA is locked, and requires authentication to access its contents.\n\nMost PDAs feature a variety of authenticators, including passwords, PINs, and various sensor-based biometrics. But simply brute-forcing through those will be futile due to failed login attempt limits and lock-outs.\n\nIf you want to use this device, you'll need to find another way in.",
        "translation": "Ce PDA est verrouillé et nécessite une authentification pour accéder à son contenu.\n\nLa plupart des PDA disposent d'une variété d'authentifiants, notamment des mots de passe, des codes PIN et diverses données biométriques basées sur des capteurs. Mais le simple fait de les forcer brutalement sera inutile en raison des limites de tentatives de connexion échouées et des verrouillages.\n\nSi vous souhaitez utiliser cet appareil, vous devrez trouver un autre moyen d'y accéder.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "d40e5c84dc069288a55227892141db5c908a8d43": {
        "source": "Attempt to access this PDA.",
        "translation": "Essayez d'accéder à ce PDA.",
        "field": "strTooltip",
        "path": "$[0].strTooltip",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "2e798a6d4e9ec8fd689337dc61de12dc6310e427": {
        "source": "ENCHackPDASkill,[us],[them]",
        "translation": "ENCHackPDASkill,[us],[them]",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
