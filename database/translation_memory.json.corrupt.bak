    },
    "65ab54800085fedea43f40cfccdeab9f116d200b": {
        "source": "Agree to Discuss Favors Triumphant",
        "translation": "Accepter de discuter des faveurs triomphantes",
        "field": "strTitle",
        "path": "$[15].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "64da03506e95ea037f56dff50c159c2effdba25d": {
        "source": "[us] says I've been nailing everything today, so sure, let's talk favors!",
        "translation": "[us] dit que j'ai tout réussi aujourd'hui, alors bien sûr, parlons de faveurs !",
        "field": "strDesc",
        "path": "$[15].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "e1b3085d99f3e739fcab5317bc7c3788ddb9354a": {
        "source": "Agree to Discuss Favors Useless",
        "translation": "Accepter de discuter de faveurs inutiles",
        "field": "strTitle",
        "path": "$[16].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "cb6d7c24eb2c26b1870de166ce3088465a8ed1fc": {
        "source": "[us] says I've been screwing up everything today, so I'm eager to try and succeed at a favor.",
        "translation": "[us] dit que j'ai tout gâché aujourd'hui, alors j'ai hâte d'essayer d'obtenir une faveur.",
        "field": "strDesc",
        "path": "$[16].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "aacfeb4cfbd9fd1bd915e689bf0a69ead62e8883": {
        "source": "Agree to Discuss Favors Selfless",
        "translation": "Accepter de discuter de faveurs altruistes",
        "field": "strTitle",
        "path": "$[17].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "b23ab74fa44c2d477022d5ad76bfaa752ef863cf": {
        "source": "[us] says I can't help doing favors for everone lately, so why change that now?",
        "translation": "[us] dit que je ne peux m'empêcher de rendre service à tout le monde ces derniers temps, alors pourquoi changer cela maintenant ?",
        "field": "strDesc",
        "path": "$[17].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "dcd49185ac321e0424bee77918bd730efa508ffa": {
        "source": "Agree to Discuss Favors Greedy",
        "translation": "Accepter de discuter des faveurs gourmandes",
        "field": "strTitle",
        "path": "$[18].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "bbb534017652e795966475ced58255ab19cf76c9": {
        "source": "[us] says I haven't been very helpful lately, so I want to do someone a favor.",
        "translation": "[us] dit que je n'ai pas été très utile ces derniers temps, alors je veux rendre service à quelqu'un.",
        "field": "strDesc",
        "path": "$[18].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "0409a8e8f8c62022d3bd782df2e96d20a05b79cd": {
        "source": "Agree to Discuss Favors Liberated",
        "translation": "Accepter de discuter des faveurs libérées",
        "field": "strTitle",
        "path": "$[19].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "15f3608bff40e4bba05fddaa3fc6f38b1211b2cb": {
        "source": "[us] says I'm doing whatever I want today, so let's talk favors!",
        "translation": "[us] dit que je fais ce que je veux aujourd'hui, alors parlons de faveurs !",
        "field": "strDesc",
        "path": "$[19].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "7a8f684aa2a65a0c53bdd2d7883ffe1344c65d3f": {
        "source": "Agree to Discuss Favors Oppressed",
        "translation": "Accepter de discuter des faveurs opprimées",
        "field": "strTitle",
        "path": "$[20].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "3d6f6de504dfc75c472ffe4d2a7e8a635fc20432": {
        "source": "[us] says people keep telling me what to do, so this better not be a big favor.",
        "translation": "[us] dit que les gens n'arrêtent pas de me dire quoi faire, donc il vaut mieux que ce ne soit pas une grande faveur.",
        "field": "strDesc",
        "path": "$[20].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "a4493fbd4a9c5edd6ff41cebcbd0ae1c741a50f9": {
        "source": "Agree to Discuss Favors Limelight",
        "translation": "Accepter de discuter des faveurs Limelight",
        "field": "strTitle",
        "path": "$[21].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "08a9603682b871e4b359759e426f212834201fed": {
        "source": "[us] says everyone's talking to me today, but fine. Let's talk favors.",
        "translation": "[us] dit que tout le monde me parle aujourd'hui, mais très bien. Parlons des faveurs.",
        "field": "strDesc",
        "path": "$[21].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "8e00e4b9770c266a0bcfcd3d8826a73e269d3032": {
        "source": "Agree to Discuss Favors Neglected",
        "translation": "Accepter de discuter des faveurs négligées",
        "field": "strTitle",
        "path": "$[22].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "eec8d39303b7164de35047df836f13fadc50b534": {
        "source": "[us] says yay! Someone's talking to me! Let's talk about favors, and don't leave any detail out.",
        "translation": "[us] dit oui ! Quelqu'un me parle ! Parlons de faveurs et n'oublions aucun détail.",
        "field": "strDesc",
        "path": "$[22].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "6f45ed84af9a16e99d974b293249be3861273afb": {
        "source": "Agree to Discuss Favors Celebrated",
        "translation": "Accepter de discuter des faveurs célébrées",
        "field": "strTitle",
        "path": "$[23].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "aeb3171505c923eba1bd7aee4a364b205d04c71a": {
        "source": "[us] says people have been so nice to me lately! Let's talk about favors.",
        "translation": "[us] dit que les gens ont été si gentils avec moi ces derniers temps ! Parlons de faveurs.",
        "field": "strDesc",
        "path": "$[23].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "9a3900ea48df63e34a0b9628e0ece8546e5e35d2": {
        "source": "Agree to Discuss Favors Humiliated",
        "translation": "Accepter de discuter des faveurs humiliées",
        "field": "strTitle",
        "path": "$[24].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "3814f4b54733a5f9d246b6fade5fe1aa33591153": {
        "source": "[us] says people have been stepping all over me lately, maybe doing a favor will help?",
        "translation": "[us] dit que les gens m'ont marché dessus ces derniers temps, peut-être que me rendre service m'aidera ?",
        "field": "strDesc",
        "path": "$[24].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "6c3d78b0866f1999fbc9d34243d4af36055db222": {
        "source": "Agree to Discuss Favors Cherished",
        "translation": "Accepter de discuter des faveurs chéries",
        "field": "strTitle",
        "path": "$[25].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "9c18075fd888cd1fefde908195f3b44d5350c771": {
        "source": "[us] says I know people have my back here, so I am well-equipped to have this favor discussion.",
        "translation": "[us] dit que je sais que les gens me soutiennent ici, je suis donc bien équipé pour avoir cette discussion favorable.",
        "field": "strDesc",
        "path": "$[25].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "b3aa6c795089cebb4c99b1b4b0ad0874edb62f8e": {
        "source": "Agree to Discuss Favors Outcast",
        "translation": "Accepter de discuter des faveurs des exclus",
        "field": "strTitle",
        "path": "$[26].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "62b83e1ebbda5fa7afb4836a1c3b484460c0c1ac": {
        "source": "[us] says nobody here cares about me, so maybe doing you a favor will make an ally.",
        "translation": "[us] dit que personne ici ne se soucie de moi, alors peut-être que vous rendre service fera un allié.",
        "field": "strDesc",
        "path": "$[26].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "f9b7f1eb5b877d8050dacfec6478557195814f08": {
        "source": "Agree to Discuss Favors Loved",
        "translation": "Accepter de discuter des faveurs aimées",
        "field": "strTitle",
        "path": "$[27].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "a8426384d1fab8125d1163b8daa47ec37e9a458f": {
        "source": "[us] says sorry, I was daydreaming about my bae. What is this about favors?",
        "translation": "[us] dit désolé, je rêvais de mon bébé. C'est quoi cette histoire de faveurs ?",
        "field": "strDesc",
        "path": "$[27].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "57cedd183677813cb57f6bf998f7eb898f93622b": {
        "source": "Agree to Discuss Favors Desperate",
        "translation": "Accepter de discuter de faveurs désespérées",
        "field": "strTitle",
        "path": "$[28].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "08e77229a7193218811251015d38e5dc8521b734": {
        "source": "[us] says I'm always ready to talk favors with a fine piece of space meat like you.",
        "translation": "[us] dit que je suis toujours prêt à rendre service à un beau morceau de viande spatiale comme vous.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "dbc34e0e07242ff5575d44c44d62c51fd069d3f0": {
        "source": "Agree to Discuss Favors Zealous",
        "translation": "Accepter de discuter des faveurs avec zèle",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "c1bcabdf05f08983e6e29ab2fd32023d9c079066": {
        "source": "[us] says everything's running smoothly, so sure, I have time to talk about favors.",
        "translation": "[us] dit que tout se passe bien, alors bien sûr, j'ai le temps de parler de faveurs.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "8fd8ede1e2add83eb26f639cbb35a8ac5e784a44": {
        "source": "Agree to Discuss Favors Ennui",
        "translation": "Accepter de discuter des faveurs Ennui",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "5e5f1e486d22d69e8365506ed4e2fa33cac036b7": {
        "source": "[us] says nothing really matters, so maybe doing you a favor will make it make sense.",
        "translation": "[us] dit que rien n'a vraiment d'importance, alors peut-être que vous rendre service aura du sens.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "6161233c11e5f0beb3f8cc61736bde539c848eed": {
        "source": "Agree to Discuss Favors Solitude",
        "translation": "Accepter de discuter favorise la solitude",
        "field": "strTitle",
        "path": "$[31].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "d33c46d709edf8058b12194ca00d70c2c47f671d": {
        "source": "[us] says it has been so long since someone bothered me. Sure, let's talk favors.",
        "translation": "[us] dit que cela fait si longtemps que personne ne m'a dérangé. Bien sûr, parlons de faveurs.",
        "field": "strDesc",
        "path": "$[31].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "94f4fd33867377886b72aabf72cfa4012a8e29a4": {
        "source": "Agree to Discuss Favors Badgered",
        "translation": "Accepter de discuter des faveurs Badgered",
        "field": "strTitle",
        "path": "$[32].strTitle",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "a79939b18e9d4a9807957510f1f811c5ef4ce2eb": {
        "source": "[us] says I wish I could get a moment's peace, maybe if I do this favor you'll leave me alone.",
        "translation": "[us] dit que j'aimerais pouvoir avoir un moment de paix, peut-être que si je fais cette faveur, tu me laisseras tranquille.",
        "field": "strDesc",
        "path": "$[32].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "aa370d90ec55b4a02388909c110c33a43a25e006": {
        "source": "Agree to Discuss Favors Calm",
