        "source": "LONE_STAR_GAMEBOOK.TXT",
        "translation": "LONE_STAR_GAMEBOOK.TXT",
        "field": "strNameFriendly",
        "path": "$[69].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "d4fe5b72ebf077d0c37beb618fca6e2a1a682cea": {
        "source": "A Select Your Own Escapade interactive gamebook featuring a thrilling interactive story of intrigue that follows Lone Star, a noir anti-hero with background and abilities defined by the reader's choices.",
        "translation": "Un livre-jeu interactif Select Your Own Escapade présentant une histoire interactive et passionnante d'intrigues qui suit Lone Star, un anti-héros noir dont l'histoire et les capacités sont définies par les choix du lecteur.",
        "field": "strDesc",
        "path": "$[69].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "b6ca45f5ef6379deaa952123095cbe05ebd26ea1": {
        "source": "SILVERSMYTH_RIP.SND",
        "translation": "SILVERSMYTH_RIP.SND",
        "field": "strNameFriendly",
        "path": "$[70].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "c6bdc7d2182685d1afd54d9b4aa3dbfe11b616aa": {
        "source": "SILVERSMYTH_GOLD.SND",
        "translation": "SILVERSMYTH_GOLD.SND",
        "field": "strNameFriendly",
        "path": "$[71].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "b0efbbc030d4bf2a4f05fd1558368b35ef785905": {
        "source": "A torrent of the full \"Gold\" album by popular K-Pop group Silversmyth. A rare collectors item that could be worth money to the right buyer.",
        "translation": "Un torrent de l'album complet \"Gold\" du populaire groupe de K-Pop Silversmyth. Un objet de collection rare qui pourrait valoir de l’argent au bon acheteur.",
        "field": "strDesc",
        "path": "$[71].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "bb3020f08170f66934aa868b8bd3a58006db7c20": {
        "source": "SILVERSMYTH_BLOOPERS.SND",
        "translation": "SILVERSMYTH_BLOOPERS.SND",
        "field": "strNameFriendly",
        "path": "$[72].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "10058e4d9b6c373fb7e7c3e76811bb6949356324": {
        "source": "Candid audio of backstage and tour bloopers by winsome Kapyong Station-based musical group Silversmyth.",
        "translation": "Audio franc des coulisses et des erreurs de tournée du groupe musical Silversmyth, basé à Kapyong Station.",
        "field": "strDesc",
        "path": "$[72].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "7d551104679b6c951a2f6029b2b79648415a319c": {
        "source": "BREATH.SND",
        "translation": "SOUFFLE.SND",
        "field": "strNameFriendly",
        "path": "$[73].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "324b80c65751534ae71c9cc1378ba0db7cb76796": {
        "source": "White noise ASMR track of calm breathing in a sealed vacuum helmet. Occasional humming, coughs, multilingual curses, or elevated breathing punctuates the monotony.",
        "translation": "Piste ASMR à bruit blanc de respiration calme dans un casque à vide scellé. Des bourdonnements occasionnels, de la toux, des jurons multilingues ou une respiration élevée ponctuent la monotonie.",
        "field": "strDesc",
        "path": "$[73].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "f4a4831ea56ccf4075b22e59279460b9bb5ce922": {
        "source": "BEATS.SND",
        "translation": "BEATS.SND",
        "field": "strNameFriendly",
        "path": "$[74].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "243cbc19f8be06b149da7afac0f807f702b28cf8": {
        "source": "An ASMR track of close mic-ed reverberations from drumming on every concievable mundane item and material in a spacer's everyday environment. The spacer in question narrates calmly and reassuringly throughout with a beautifully sonorous voice.",
        "translation": "Une piste ASMR de réverbérations rapprochées du micro provenant de la batterie sur tous les objets et matériaux banals imaginables dans l'environnement quotidien d'un spacer. L'espaceur en question raconte de manière calme et rassurante avec une voix magnifiquement sonore.",
        "field": "strDesc",
        "path": "$[74].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "52028866ad36a22ff27d96b1008f97e2030778d0": {
        "source": "SAKURANOIR.SND",
        "translation": "SAKURANOIR.SND",
        "field": "strNameFriendly",
        "path": "$[75].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "ecebbce83bc697f4f47038f19022bf2eb8f81d15": {
        "source": "CAPTAIN_LOG.SND",
        "translation": "CAPTAIN_LOG.SND",
        "field": "strNameFriendly",
        "path": "$[76].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "9ddfad1810e2608c89e1941d2d9cc6feaeb62b77": {
        "source": "A paranoid-sounding captain's log about a doomed expedition. The report is interrupted partway through by sounds of violence, angry voices, and ship alarms.",
        "translation": "Le journal de bord d'un capitaine à l'air paranoïaque sur une expédition vouée à l'échec. Le reportage est interrompu en cours de route par des bruits de violence, des voix en colère et des alarmes de navires.",
        "field": "strDesc",
        "path": "$[76].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "88e74af3e7d60b3f64d28e1e1560ca4cd7eb2fea": {
        "source": "MAYDAY.SND",
        "translation": "MAYDAY.SND",
        "field": "strNameFriendly",
        "path": "$[77].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "cc4e365bae36f78752858a11ce889b1b2cfcd717": {
        "source": "A bridge-recording of the moment assailants breach the doors, the ensuing firefight, and the panicked cursing and somber cheering of the survivors.",
        "translation": "Un enregistrement de pont du moment où les assaillants franchissent les portes, de la fusillade qui s'ensuit, ainsi que des jurons paniqués et des acclamations sombres des survivants.",
        "field": "strDesc",
        "path": "$[77].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "5d5666d02de1fc3da37b5d1c79aee97f9fe22efe": {
        "source": "BREACHINGTEAM.SND",
        "translation": "BREACHINGTEAM.SND",
        "field": "strNameFriendly",
        "path": "$[78].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "2394f9edd78a2404a217aad1537c148737f1575f": {
        "source": "A bravado-laced comms recording of a breaching team on assault of another vessel. The team's coordination is ruthless and they mock their enemies as they fall before them.\n\nThe discipline, cadence, and background heavy metal music imply a well-trained PMC or pirate crew more than any formal Naval force.",
        "translation": "Un enregistrement de communication plein de bravade d'une équipe en brèche lors de l'assaut d'un autre navire. La coordination de l'équipe est impitoyable et ils se moquent de leurs ennemis lorsqu'ils tombent devant eux.\n\nLa discipline, la cadence et la musique de fond heavy metal impliquent un PMC ou un équipage de pirates bien entraîné plus que n'importe quelle force navale formelle.",
        "field": "strDesc",
        "path": "$[78].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "341b1a0eb97c5eeeef7578c1ce23c0ab3bc2de62": {
        "source": "GHOST.SND",
        "translation": "FANTÔME.SND",
        "field": "strNameFriendly",
        "path": "$[79].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "9216c1ad7163358845244aa649d995c3d0dc264c": {
        "source": "A terrified spacer describes witnessing the Mariner during an EVA spacewalk. They wonder inconclusively if its helmet contains a skull, and whether that would be worse or better than a full, unblinking human face.",
        "translation": "Un espaceur terrifié décrit avoir été témoin du Mariner lors d'une sortie dans l'espace en EVA. Ils se demandent sans succès si son casque contient un crâne, et si ce serait pire ou mieux qu'un visage humain plein et impassible.",
        "field": "strDesc",
        "path": "$[79].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "20d34ac0934cf6d0c45a946fe4487f509a214fca": {
        "source": "FIREFLIES.SND",
        "translation": "LUCIOCOLLES.SND",
        "field": "strNameFriendly",
        "path": "$[80].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "de3aa7938efeaf85775483bcb7dbfeb7afdc97b5": {
        "source": "An engineer's log details a fateful swarm of undefined energy signals that intervened to prevent a pirate boarding. The speaker wonders if these are the Fireflies they've heard in spacer superstitions.",
        "translation": "Le journal d'un ingénieur détaille un essaim fatidique de signaux d'énergie indéfinis qui sont intervenus pour empêcher l'abordage d'un pirate. L'orateur se demande si ce sont les lucioles qu'ils ont entendues dans les superstitions spatiales.",
        "field": "strDesc",
        "path": "$[80].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "5d3ace27050d967f9974d312a40e2c4aa8258b65": {
        "source": "WHY_DOESNT_IT_ROT?.SND",
        "translation": "POURQUOI_DOESNT_IT_ROT ?.SND",
        "field": "strNameFriendly",
        "path": "$[81].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "a1153d91f11787be07fbc794d2fc6c6d53e72b09": {
        "source": "A fast-talking spacer expounds on corporate negligence and detailed theories about various ubercorp conspiracies, ending with a long rant about vacuum- and decay-proof meat that whispers maddeningly and moves when you're not looking at it.",
        "translation": "Un internaute au discours rapide expose la négligence des entreprises et des théories détaillées sur diverses conspirations de l'ubercorp, se terminant par un long discours sur la viande résistante au vide et à la pourriture qui murmure de manière exaspérante et bouge lorsque vous ne la regardez pas.",
        "field": "strDesc",
        "path": "$[81].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "55c352cdda2851ee16c73318d3c3071f5ba685b9": {
        "source": "CREEPYKIDS.SND",
        "translation": "CREEPYKIDS.SND",
        "field": "strNameFriendly",
        "path": "$[82].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "0ff768e66fa508f8eed82d9ed4639cc3ab089929": {
        "source": "A talk radio personality rants about how wrong it is that the whole colony of Neverland, on the dwarf planet Makemake, is be populated by children. The creepiness and questionable humanity of the Neverlanders is discussed at length without nuance, empathy, or apology.",
        "translation": "Une personnalité de la radio dénonce à quel point il est faux que toute la colonie de Neverland, sur la planète naine Makemake, soit peuplée d'enfants. L'humanité effrayante et douteuse des Neverlanders est longuement discutée sans nuance, empathie ou excuses.",
        "field": "strDesc",
        "path": "$[82].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "aef1039cb9e0b7029f7eb9a276150e1c49933b81": {
        "source": "LASTGOODBYE.SND",
        "translation": "DERNIER AU REVOIR.SND",
        "field": "strNameFriendly",
        "path": "$[83].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "0ab05efaf4b00e2fc2ad04d09198cecad9c0ffca": {
        "source": "A scratchy, lo-fi voice message saved from an old-format device of a loved one wishing a warm farewell in case they don't make it.",
        "translation": "Un message vocal rauque et lo-fi enregistré à partir d'un appareil ancien format d'un être cher souhaitant un adieu chaleureux au cas où il n'y parviendrait pas.",
        "field": "strDesc",
        "path": "$[83].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "e6254b8266d87a8a16eadc9e0658157877ceb22a": {
        "source": "APOLOGY.SND",
        "translation": "EXCUSES.SND",
        "field": "strNameFriendly",
        "path": "$[84].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "56c457edcb758e9a98c6118100bd890bfb202470": {
        "source": "A succinct recorded apology message by someone who gets choked up hoping for relational reconciliation.",
        "translation": "Un message d'excuses succinct enregistré par quelqu'un qui s'étouffe dans l'espoir d'une réconciliation relationnelle.",
        "field": "strDesc",
        "path": "$[84].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "9b3114ec58c19c55904558f5c62683c54a4480bf": {
        "source": "REMINDER.SND",
        "translation": "RAPPEL.SND",
        "field": "strNameFriendly",
        "path": "$[85].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "9c76a1a25f33e41c34fb96ce3196a3a7e93c06c3": {
        "source": "A voice memo of various mundane spacer tasks requiring semi-regular notifications and frequent reference.",
        "translation": "Un mémo vocal de diverses tâches d'espacement banales nécessitant des notifications semi-régulières et une référence fréquente.",
        "field": "strDesc",
        "path": "$[85].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "81f90a0cf7ded6a6800bdaaa21e981aa15ba1939": {
        "source": "WHAT_IS_THIS.SND",
        "translation": "QUOI_IS_THIS.SND",
        "field": "strNameFriendly",
        "path": "$[86].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "b818ac41704ed625a17750e297453dfd8afd7bdb": {
        "source": "A monstrous roar and clacking of clawed footsteps, echoing off bulkheads through narrow ship or station corridors. A human whisper wonders if it's gone right before the recording ends mid-scream.",
        "translation": "Un rugissement monstrueux et un claquement de pas griffus, résonnant sur les cloisons des couloirs étroits des navires ou des gares. Un murmure humain se demande s'il a disparu juste avant la fin de l'enregistrement au milieu d'un cri.",
        "field": "strDesc",
        "path": "$[86].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "8c9535232fe9f00b43a6d8a1b1db7a89cc6f2bdc": {
        "source": "THEGANGALLTOGETHER.SND",
        "translation": "THEGANGALLTOGETHER.SND",
        "field": "strNameFriendly",
        "path": "$[87].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "5a766109e2a93defa62af685bf1018d25217840d": {
        "source": "A series of old-timey barbershop quartet songs sung well but recorded poorly.",
        "translation": "Une série de chansons du quatuor de barbiers à l’ancienne bien chantées mais mal enregistrées.",
        "field": "strDesc",
        "path": "$[87].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "5bbe16b870748c522332810c03996640abc13d37": {
        "source": "THE_BARD.SND",
        "translation": "THE_BARD.SND",
        "field": "strNameFriendly",
        "path": "$[88].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "15f7aee2ccd76ab2b2c4a60c8878cf528369d826": {
        "source": "Dramatic readings of poetic works of Shakespeare and other classics.",
        "translation": "Lectures dramatiques d'œuvres poétiques de Shakespeare et d'autres classiques.",
        "field": "strDesc",
        "path": "$[88].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "71b10fec7f229cfbf98d171ee624372ebca7bf50": {
        "source": "UNCLE.SND",
        "translation": "ONCLE.SND",
        "field": "strNameFriendly",
        "path": "$[89].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "0e96007fc00dbf3aca9aec81832d9015c9376726": {
        "source": "An old man telling all the stories and folklore he can remember from Old Nigeria.",
        "translation": "Un vieil homme racontant toutes les histoires et le folklore dont il se souvient du vieux Nigeria.",
        "field": "strDesc",
        "path": "$[89].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "9ee6c39b43de5f7f4eff51a3240c0f4b15c31292": {
        "source": "TESTAMENT.SND",
        "translation": "TESTAMENT.SND",
        "field": "strNameFriendly",
        "path": "$[90].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "52f4592270fe8eb35fcbbd77a8215550f165d1d0": {
        "source": "The last will and testament of a seemingly well-off citizen. It's not clear if this format holds up in court.",
        "translation": "Le dernier testament d'un citoyen apparemment aisé. Il n'est pas clair si ce format résiste devant les tribunaux.",
        "field": "strDesc",
        "path": "$[90].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "77a80d97daed1f79d410acf67ec4c30cacfc266e": {
        "source": "CONFIDENTIAL_BOARDMEETING.SND",
        "translation": "CONFIDENTIAL_BOARDMEETING.SND",
        "field": "strNameFriendly",
        "path": "$[91].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "d4c5aaf3b0c61092289fe1e098626a948b98aafb": {
        "source": "A probably illicitly recorded corporate board meeting where economy-shifting changes are discussed and decided.",
        "translation": "Une réunion du conseil d’administration d’une entreprise probablement enregistrée illégalement où les changements qui changent l’économie sont discutés et décidés.",
        "field": "strDesc",
        "path": "$[91].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "d3c34bbb50f573c8819db47792c15b2a4a39fc54": {
        "source": "PLEA_DEAL.SND",
        "translation": "PLEA_DEAL.SND",
        "field": "strNameFriendly",
        "path": "$[92].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "9e4536b9302b751a25e3c95d84759b19c1cdc838": {
        "source": "A confession to heinous crimes under intensive interrogation by private security contractors. This probably is not meant for public access.",
        "translation": "Un aveu de crimes odieux sous interrogatoire intensif par des prestataires de sécurité privés. Ce n'est probablement pas destiné à être accessible au public.",
        "field": "strDesc",
        "path": "$[92].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "c3aee4329ebbae3fd96639cef319b12588b822e1": {
        "source": "INTERNALAFFAIRS.SND",
        "translation": "AFFAIRES INTERNES.SND",
        "field": "strNameFriendly",
        "path": "$[93].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "4cca4162765df27777de022ea70b8177eda81e85": {
        "source": "A remorseful confession to terrible crimes that is met with assurances that this would all go away.",
        "translation": "Une confession pleine de remords pour des crimes terribles qui s'accompagne de l'assurance que tout cela disparaîtrait.",
        "field": "strDesc",
        "path": "$[93].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "f16e334c1706cddc3d93a66cdff88ffb7c9e0abe": {
        "source": "MANIFESTO.SND",
        "translation": "MANIFESTE.SND",
        "field": "strNameFriendly",
        "path": "$[94].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "135ae4d13af8c6adf71823348f01e147860a1133": {
        "source": "FOR_STRESS_RELIEF.SND",
        "translation": "FOR_STRESS_RELIEF.SND",
        "field": "strNameFriendly",
        "path": "$[95].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "b2fbb869a623e1301c2f4f8669362eeec781492a": {
        "source": "A collection of meditation and stress-relief audio tracks with chanting and electronic-world rhythms, behind a steady, guiding voice. The platitudes are nice, if naive.",
        "translation": "Une collection de pistes audio de méditation et de soulagement du stress avec des chants et des rythmes du monde électronique, derrière une voix ferme et directrice. Les platitudes sont sympathiques, quoique naïves.",
        "field": "strDesc",
        "path": "$[95].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "b7ee37e34302bc264998c226d4f10a1341367de3": {
        "source": "SPACE_PROTOTYPE.BIN",
        "translation": "ESPACE_PROTOTYPE.BIN",
        "field": "strNameFriendly",
        "path": "$[96].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "23e4f148ecf54f1357fbedfa4494cadd618ea04a": {
        "source": "An illegally obtained rip of a minor hit space simulation game from the early 20s taken from a backup of a russian website. Known for its outrageous bugs and lack of 'content'. Players still rate it favorably, if a little esoteric, well into the 70s.",
        "translation": "Un rip obtenu illégalement d'un jeu de simulation spatiale à succès mineur du début des années 20, tiré d'une sauvegarde d'un site Web russe. Connu pour ses bugs scandaleux et son manque de « contenu ». Les joueurs l'apprécient toujours favorablement, même s'il est un peu ésotérique, jusque dans les années 70.",
        "field": "strDesc",
        "path": "$[96].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "d2c9339e8c6419ff03a6fc46647fe1980623611c": {
        "source": "DRONE_OS.BIN",
        "translation": "DRONE_OS.BIN",
        "field": "strNameFriendly",
        "path": "$[97].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "68fe377e8a71bdcca721be28a75496e9209d7a48": {
        "source": "A drone operating system and behavior log with some anomalies in the AI.",
        "translation": "Un système d'exploitation et un journal de comportement du drone avec quelques anomalies dans l'IA.",
        "field": "strDesc",
