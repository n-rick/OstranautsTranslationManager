        "translation": "COURRIER",
        "field": "strTitle",
        "path": "$[567].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "971f2e336fa17da4fbec02bdaccefb9b2b8dd50d": {
        "source": "[us] is seeking secure and prompt delivery of [itm] to [them], who needs the item in question [txt1].",
        "translation": "[us] recherche une livraison rapide et sécurisée de [itm] à [them], qui a besoin de l'article en question [txt1].",
        "field": "strDesc",
        "path": "$[567].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "66480023c658aaa3914e26f1ce8228fded0bf559": {
        "source": "SENSITIVE ITEM DELIVERY (POWER, TEMP)",
        "translation": "LIVRAISON D'ARTICLES SENSIBLES (PUISSANCE, TEMP)",
        "field": "strTitle",
        "path": "$[568].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "5f3401b0b201c49894c944a7df2227b59f4e0d25": {
        "source": "[us] is seeking secure and prompt delivery of an advanced AI supercomputer with significant power requirements and thermal output. The computer houses [txt1]\n\nRemove the computer from the Pick-Up Locker and install it into a ship with a live power source before the internal battery runs out. After reaching the location of the Drop-off Locker, uninstall the computer and deliver it before it loses remaining power.\n\nWARNING: the device above has power needs that can only be met by an enormous battery bank or a live Inertial Confinement Fusion Reactor. Failure to adequately power the device results in the forfeiture of the gig cost. Client and Gig Nexus accept no responsibility for damage or injury as a result of the device's heat output.",
        "translation": "[us] recherche la livraison sécurisée et rapide d'un supercalculateur d'IA avancé avec des besoins en énergie et une puissance thermique importants. L'ordinateur abrite [txt1]\n\nRetirez l'ordinateur du Pick-Up Locker et installez-le dans un navire doté d'une source d'alimentation sous tension avant que la batterie interne ne soit épuisée. Après avoir atteint l'emplacement du casier de dépôt, désinstallez l'ordinateur et remettez-le avant qu'il ne perde l'énergie restante.\n\nAVERTISSEMENT : l'appareil ci-dessus a des besoins en énergie qui ne peuvent être satisfaits que par un énorme parc de batteries ou un réacteur à fusion à confinement inertiel sous tension. Le fait de ne pas alimenter correctement l'appareil entraîne la perte du coût du concert. Le client et Gig Nexus n'acceptent aucune responsabilité pour les dommages ou blessures résultant de la puissance thermique de l'appareil.",
        "field": "strDesc",
        "path": "$[568].strDesc",
        "relative_path": "interactions/interactions.json"
    },
