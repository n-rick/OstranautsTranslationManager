    "504aa173504fed755327df79679619ef9a77f6bf": {
        "source": "Tharsis Landing, Mars",
        "translation": "Atterrissage de Tharsis, sur Mars",
        "field": "strTitle",
        "path": "$[94].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "87de31474b9bc0ae438faf5b03e32528ad4a5aab": {
        "source": "Tharsis Landing (Tasijin, 塔寺津) is the oldest and most populous city-state of Mars. On the surface it appears to be a few shielded dwellings in clusters often tens of kilometres apart, but beneath that lies the majority of the city itself, threaded through a series of long, thin lava tubes under Tharsis Plateau and Arsia Mons. Tharsis and Hangzhou Orbital are together the economic heart of the Inner System.",
        "translation": "Tharsis Landing (Tasijin, 塔寺津) est la cité-état la plus ancienne et la plus peuplée de Mars. En surface, il semble s'agir de quelques habitations protégées regroupées en groupes souvent distants de plusieurs dizaines de kilomètres, mais en dessous se trouve la majorité de la ville elle-même, traversée par une série de longs et minces tubes de lave sous le plateau de Tharsis et Arsia Mons. Tharsis et Hangzhou Orbital constituent ensemble le cœur économique du système intérieur.",
        "field": "strDesc",
        "path": "$[94].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "c0a6522db2bf9bb068c601e900e19d60f0dd4ed4": {
        "source": "DataWIKITharsisLandingStats",
