        "relative_path": "interactions/interactions_hacking.json"
    },
    "acc271671b69c18b17a09630431cf9c9a8a4375a": {
        "source": "Try To Crack PDA",
        "translation": "Essayez de cracker un PDA",
        "field": "strTitle",
