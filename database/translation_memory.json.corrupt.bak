    "a1777867ff2c3842ea0d8dfaea8fcf40e7b30f3c": {
        "source": "Trenchers began as a skunkworks project to deliver maximum nutritional value inside a specific volume and mass, intended for long haul operations. The result was an MRE packet which was itself edible, made of a proprietary digestible fibre. After months of product research, the fibre was dyed white and dubbed StyrofauxmTM.",
        "translation": "Trenchers began as a skunkworks project to deliver maximum nutritional value inside a specific volume and mass, intended for long haul operations. The result was an MRE packet which was itself edible, made of a proprietary digestible fibre. After months of product research, the fibre was dyed white and dubbed StyrofauxmTM.",
        "field": "strDesc",
        "path": "$[149].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "5de6c93d0e9b2437260df1f70bbbe574787eac2c": {
