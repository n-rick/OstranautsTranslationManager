    "eaa057701912d7b6fd01e737f4a17429af11652d": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "37ac52c5146b0fd2ff7cc675c9071ab20922bcdf": {
        "source": "After processing, you are unceremoniously dumped outside the Tharsis Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l'extérieur du bureau de sécurité de Tharsis. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "a562276a86196f34a451d80150c3d9a4566aef7f": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
