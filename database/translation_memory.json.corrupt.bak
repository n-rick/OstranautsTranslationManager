    },
    "98a57849ec4dcac966394eb3dda657385d17d9bb": {
        "source": "[us] [gains] JATL LEO Arrest pledge.",
        "translation": "[us] [gains] JATL LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "b7de5d1280ea2520dbfa5380b0c8ebef7b4dc7fd": {
        "source": "Adds JATL LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement JATL LEO Arrest parce que le joueur a volé un navire.",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "8d4bd6fe3d7c7841022f5ddaf74fbd4c1cf34cae": {
        "source": "[us] [gains] JATL LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] JATL LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "4d8c7234e1f3f9e91f9cddeab1186d4298edb4b1": {
        "source": "Adds JATL LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement JATL LEO Threat",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "12e8a545d0e81093a3780cc6f5727f4065e22620": {
        "source": "[us] [gains] JATL LEO Threat pledge.",
        "translation": "[us] [gains] JATL LEO Engagement de menace.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "67c121750f0955560a204d673ad0b4bb9ea56f9f": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "cc2c54e38e5d2c8659f7d66bf9caf1a40635438f": {
        "source": "They haul you before a Galilean Confederacy tribunal for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Fort Simpson Brig for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un tribunal de la Confédération galiléenne pour jugement, laissant derrière eux votre navire et votre équipement.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payable en totalité ou en plusieurs versements - ou vous partez à Fort Simpson Brig pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "8f6c5127bd862f7351d7946dead6c67b99605a81": {
        "source": "ENCHeatJFTSFineEnd",
        "translation": "ENCHeatJFTSFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "bf03a06fb10c2959027550a9a81cd76fafb6921c": {
        "source": "ENCHeatJFTSFineDebtEnd",
        "translation": "ENCHeatJFTSFineDebtEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "0a89a56218838135e4b96d7b98476cebc6caf12d": {
        "source": "ENCHeatJFTSPrisonStart",
        "translation": "ENCHeatJFTSPisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "c39e6f7f2e9d9b0bd6862326ece4028911613097": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "bc0d72e6b07c6b59c28ad70d3c6849d70a396331": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "7211c19fc62891a5da1957150333813df8286dbb": {
        "source": "ENCHeatJFTSFineFinish",
        "translation": "ENCHeatJFTSFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "06fcf9c3dcbf69916c2c956a40b01d7a8fc865d9": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "455778a0dad094536550757969e9b64249026304": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "663342109c4fc3a0e8a06fcaed455e4529e025f4": {
        "source": "ENCHeatJFTSFineFinish",
        "translation": "ENCHeatJFTSFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "4f78200418b64fdd317e4efe97ff88255e8595e5": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "bddf43fe7715eec393db1e271f7ca7f6582abafa": {
        "source": "After processing, you are unceremoniously dumped outside the Fort Simpson Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l'extérieur du bureau de sécurité de Fort Simpson. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "a393d50568427c9a1120b3ce71533297b0d9817d": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "5cc548c7874b90e944c61a76c41b66cacf8a99f1": {
        "source": "Off to Fort Simpson Brig",
        "translation": "En route pour Fort Simpson Brick",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "20014072c80622ebeca23e250093d36b851b7a5d": {
        "source": "You are hauled off to Fort Simpson Brig.",
        "translation": "Vous êtes transporté à Fort Simpson Brig.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "4016cc7e82f1d4f4a0f87db797b79ffd8236ec01": {
        "source": "ENCHeatJFTSPrisonEnd",
        "translation": "ENCHeatJFTSPrisonEnd",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "5d2aad59269be7d99ef9fbf60280541220fc55b8": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "5bf8458099c6d9e44eb4f568ecd6a0cb0555867c": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "4cc7226f1d9d15d13fe67dfec2b543c0ee7ad861": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "d7ddc7daf03665dd3e3a3de477a471a284e3cbd1": {
        "source": "ENCHeatJFTSPrisonFinish",
        "translation": "ENCHeatJFTSPrisonFinish",
        "field": "aInverse",
        "path": "$[5].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "c55f84ee0f9cf65996c02f7b91ebbf43b96dc55a": {
        "source": "CGEncHomeworldLEOEnemy",
        "translation": "CGEncHomeworldLEOEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "42b1c51c727170d3794c43b5a7afb5bbb4ff7c33": {
