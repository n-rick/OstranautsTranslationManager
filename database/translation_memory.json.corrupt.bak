    "4869643ef796c3fe41ed44481acdf1f0aea84386": {
        "source": "Damask Rose",
        "translation": "Rose de Damas",
        "field": "strTitle",
        "path": "$[116].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "88075ab8bd6ce6e6bda9ff0ca372609512214c4f": {
        "source": "Damask Rose is a brand of sativa-strain marijuana manufactured and distributed by The Green Energy Company. It is the leading brand of marijuana off world due to its history, quality, and affordability.\n\n<b>Product:</b> Marijuana\n<b>Manufacturer:</b> The Green Energy Company\n<b>Country of origin:</b> Old United States\n<b>Variants:</b> Unicorn Dream (indica strain)\n<b>Produced in:</b> Old United States, Tharsis Landing, Newcal\n<b>Sold in:</b> Inner System, Old Earth\n<b>Ticker symbol:</b> DAMA\n\n<b>Slogans:</b>\n\nSmoke a rose\nDrift away\nThe flower of the oasis",
        "translation": "Damask Rose is a brand of sativa-strain marijuana manufactured and distributed by The Green Energy Company. It is the leading brand of marijuana off world due to its history, quality, and affordability.\n\n<b>Product:</b> Marijuana\n<b>Manufacturer:</b> The Green Energy Company\n<b>Country of origin:</b> Old United States\n<b>Variants:</b> Unicorn Dream (indica strain)\n<b>Produced in:</b> Old United States, Tharsis Landing, Newcal\n<b>Sold in:</b> Inner System, Old Earth\n<b>Ticker symbol:</b> DAMA\n\n<b>Slogans:</b>\n\nSmoke a rose\nDrift away\nThe flower of the oasis",
        "field": "strDesc",
        "path": "$[116].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "6b7dc361b97a30499ec7bdfc06f29d7a16ef0a83": {
        "source": "DataWIKIDamaskRoseHistory",
        "translation": "DonnéesWIKIDamaskRoseHistorique",
        "field": "aInverse",
