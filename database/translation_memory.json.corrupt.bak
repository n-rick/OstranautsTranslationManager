    "48bb10b2414e05522727c94f9986e9bf48ad863f": {
        "source": "Ubiq Mobile",
        "translation": "UbiqMobile",
        "field": "strTitle",
        "path": "$[156].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "faae7289707dbd411e2a3fb74c837f9f86aa5a7a": {
        "source": "Ubiq Mobile is a telecommunications company and Wireless Internet Service Provider (WISP) which provides internet services for colonies and corporate territories across the Inner System. Its core product is the 'grid', the manufacture and maintenance of hundreds of thousands of dedicated network nodes which form the backbone of a network topology. Because of their mass produced regularity, Ubiq refers to its nodes as the 'Joe Chip'.\n\n<b>Service:</b> WISP\n<b>Origin:</b> Mars\n\n<b>Slogan:</b>\nWe're your everywhere",
        "translation": "Ubiq Mobile est une société de télécommunications et un fournisseur de services Internet sans fil (WISP) qui fournit des services Internet aux colonies et aux territoires corporatifs du système interne. Son produit principal est le « grid », la fabrication et la maintenance de centaines de milliers de nœuds de réseau dédiés qui constituent l'épine dorsale d'une topologie de réseau. En raison de leur régularité produite en masse, Ubiq appelle ses nœuds le « Joe Chip ».\n\n<b>Service :</b> WISP\n<b>Origine :</b> Mars\n\n<b>Slogan :</b>\nNous sommes à votre disposition partout",
        "field": "strDesc",
        "path": "$[156].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "00f933fdbc8068ecfde615ecfc9549d82bd0b5f0": {
        "source": "DataWIKIUbiqMobileRole",
