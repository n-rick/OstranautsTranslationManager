    },
    "d512a16fd9dab87e2a8d61e9e083e41d646070d4": {
        "source": "[us] says good to see a fellow faction! Sure, let's talk favors.",
        "translation": "[us] ça fait plaisir de voir une autre faction ! Bien sûr, parlons de faveurs.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
