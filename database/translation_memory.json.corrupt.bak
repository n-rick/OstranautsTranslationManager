    "d35e1af45bc717248ec07a10b355c879fcd4ea68": {
        "source": "Shim interaction to test us = AI character before continuing.",
        "translation": "Interaction cale pour nous tester = personnage IA avant de continuer.",
        "field": "strDesc",
        "path": "$[13].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
