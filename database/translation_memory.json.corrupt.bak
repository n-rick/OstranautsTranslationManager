    "d53fd5064845417a3f54469ead71d79d9095d4dd": {
        "source": "SECURITY RECON",
        "translation": "RECONNAISSANCE DE SÉCURITÉ",
        "field": "strTitle",
        "path": "$[614].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "1aa88e59a836ab4940eeeef7ef915842dd26c738": {
        "source": "[us] wants to frame [them] on [them-shipfriendly], but first [us] needs someone to scope it out and see if [them-contractIs] there.\n\n - Board [them-shipfriendly]\n - Use a PDA to take recon photo of [them]\n - Return to Job Kiosk and Turn-In gig.",
        "translation": "[us] veut encadrer [them] sur [them-shipfriendly], mais [us] a d'abord besoin de quelqu'un pour l'examiner et voir si [them-contractIs] s'y trouve.\n\n - Tableau [them-shipfriendly]\n - Utilisez un PDA pour prendre une photo de reconnaissance de [them]\n - Retour au kiosque d'emploi et concert de remise.",
        "field": "strDesc",
        "path": "$[614].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "c742cd5b3c23c60dd3c08177b52f5487ef63c864": {
        "source": "SECURITY RECON",
        "translation": "RECONNAISSANCE DE SÉCURITÉ",
        "field": "strTitle",
        "path": "$[615].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "3b62dd5f218ef1148a76e678d2941df3bb337419": {
        "source": "[us] is seeking information on the whereabouts of [them], who [txt1]\n\nYou are to locate [them] on [them-shipfriendly] and use the PDA to take a photograph proving latest location.",
        "translation": "[us] recherche des informations sur l'endroit où se trouve [them], qui [txt1]\n\nVous devez localiser [them] sur [them-shipfriendly] et utiliser le PDA pour prendre une photo prouvant le dernier emplacement.",
        "field": "strDesc",
        "path": "$[615].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "8302493cdc3e4be5a32ebcdbdae6abcd5f421a71": {
        "source": "HEAVY HITTING",
        "translation": "FRAPPEMENT LOURD",
        "field": "strTitle",
        "path": "$[616].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "ec8f2f0b2f96495860b1b884513b80399c549b88": {
        "source": "[us] wants to show [them] how serious [us-subj] [is] after [them] [txt1]\n\n\n - Board [them-shipfriendly]\n - Find and hurt [them] badly, without killing [them-obj]\n - Tell [them] [us] sends [us-pos] regards \n - Return to Job Kiosk and Turn-In gig",
        "translation": "[us] veut montrer à [them] à quel point [us-subj] [is] après [them] [txt1]\n\n\n - Tableau [them-shipfriendly]\n - Trouver et blesser gravement [them], sans tuer [them-obj]\n - Dites à [them] [us] envoie [us-pos] salutations \n - Retour au kiosque d'emploi et concert de remise",
        "field": "strDesc",
        "path": "$[616].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "56bb1afea7afe97a7a819c17633d75663e392000": {
        "source": "HONEYPOT",
        "translation": "POT DE MIEL",
        "field": "strTitle",
        "path": "$[617].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "c6cbe7cccaf730808b0e57e9724c5d1163889a62": {
        "source": "[us] is seeking a skilled operator in romantic entrapment who can compromise [them] as part of a plan to [txt1]\n\nLocate [them] on [them-shipfriendly] and develop a romantic relationship with [them-obj]. Once trust is established, extract the relevant information from [them-obj] and return to the kiosk.",
        "translation": "[us] recherche un opérateur qualifié en matière de piégeage romantique qui peut compromettre [them] dans le cadre d'un plan visant à [txt1]\n\nLocalisez [them] sur [them-shipfriendly] et développez une relation amoureuse avec [them-obj]. Une fois la confiance établie, extrayez les informations pertinentes de [them-obj] et retournez au kiosque.",
        "field": "strDesc",
        "path": "$[617].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "f8731f05142c962d121132ba019ee967cbbfe1e9": {
        "source": "INVESTIGATE DEATH",
        "translation": "ENQUÊTER SUR LA MORT",
        "field": "strTitle",
        "path": "$[618].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "64060707e51208b30781931fc92ad96e74331d31": {
        "source": "[us] is seeking the services of a private investigator who can investigate the reported death of [them]. The subject was [txt1]\n\nLocate [them-pos] body on [them-shipfriendly], inspect [them-pos] body to verify the cause of death, then return that information to the Gig Nexus kiosk.",
        "translation": "[us] recherche les services d'un enquêteur privé qui pourra enquêter sur le décès signalé de [them]. Le sujet était [txt1]\n\nLocalisez le corps de [them-pos] sur [them-shipfriendly], inspectez le corps de [them-pos] pour vérifier la cause du décès, puis renvoyez ces informations au kiosque Gig Nexus.",
        "field": "strDesc",
        "path": "$[618].strDesc",
        "relative_path": "interactions/interactions.json"
    },
