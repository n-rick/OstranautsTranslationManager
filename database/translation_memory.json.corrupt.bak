    "5bde55db510cf43b59d36796b84d7d802f27e8c9": {
        "source": "Ask For a Break",
        "translation": "Demandez une pause",
        "field": "strTitle",
        "path": "$[21].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "5705d772fce32ef21f5dc5ee2ea6b3c335d55fdf": {
        "source": "[us] [asks] if [us-subj] can have a break just this one time.",
        "translation": "[us] [asks] si [us-subj] peut faire une pause juste cette fois.",
        "field": "strDesc",
        "path": "$[21].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "d2e8cf1a68950488b62f8eb1599ce454b71bca08": {
        "source": "SOCPortAuthorityFinisherAskForBreakSuccumb",
        "translation": "SOCPortAuthorityFinisherAskForBreakSuccumb",
        "field": "aInverse",
        "path": "$[21].aInverse[0]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "886c3165a586e9e60ca3d1b6cd38c07345cc39ab": {
        "source": "SOCPortAuthorityFinisherAskForBreakResist",
        "translation": "SOCPortAuthorityFinisherAskForBreakResist",
        "field": "aInverse",
        "path": "$[21].aInverse[1]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "680ac3a37ba1d5cf8febccb94eaaba006512d7b0": {
        "source": "Succumb: Ask For a Break",
        "translation": "Succomber : demandez une pause",
        "field": "strTitle",
        "path": "$[22].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "8b2fae37510d1c14cd1c1bcfe4460e104089055b": {
        "source": "[us] [smiles] and says what the hell, it's a dead-end job anyway, and then absolves your docking fee.",
        "translation": "[us] [smiles] et dit que diable, c'est un travail sans issue de toute façon, puis il exonère vos frais d'amarrage.",
        "field": "strDesc",
        "path": "$[22].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "bf5daabedee033ad764e0ceb404a6437ced47ac4": {
        "source": "SocialCombatExit,[us],[them]",
        "translation": "SocialCombatSortie,[us],[them]",
        "field": "aInverse",
        "path": "$[22].aInverse[0]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "d2f50b4b871e87cd4f1909126c4e18bb3df8859f": {
        "source": "Resist: Ask For a Break",
        "translation": "Résistez : demandez une pause",
        "field": "strTitle",
        "path": "$[23].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "55a5c96ff08c236430b9180af0daed9f36946302": {
        "source": "[us] [says] if they gave every comedian around here a break [us-subj] would lose [us-pos] job. [us] [asks] [them] to pay their fee if they want to leave the station.",
        "translation": "[us] [says] s'ils donnaient une pause à tous les comédiens d'ici, [us-subj] perdrait leur emploi [us-pos]. [us] [asks] [them] de payer leurs frais s'ils souhaitent quitter la gare.",
        "field": "strDesc",
        "path": "$[23].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "58372e81682581fd58293286ec128d6c769ef478": {
        "source": "SocialCombatExit,[us],[them]",
        "translation": "SocialCombatSortie,[us],[them]",
        "field": "aInverse",
        "path": "$[23].aInverse[0]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "b41ee88aee657dbe274088ca5ffbb36023ac5a21": {
        "source": "Promise to Pay Later",
        "translation": "Promesse de payer plus tard",
        "field": "strTitle",
        "path": "$[24].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "ac7f58a31fb1eaa6354a0a30738e862883abb7b0": {
        "source": "[us] [asks] [them] to waive the docking fee so that [us-subj] can address [us-pos] urgent mission. [us] [promises] that [us-subj] will pay the fee next time they dock.",
        "translation": "[us] [asks] [them] pour renoncer aux frais d'amarrage afin que [us-subj] puisse répondre à [us-pos] mission urgente. [us] [promises] que [us-subj] paiera les frais la prochaine fois qu'il accostera.",
        "field": "strDesc",
        "path": "$[24].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "eb15d6cd5be026f4b4a0b2d1b9c2bbe8e5b8841f": {
        "source": "SOCPortAuthorityFinisherPromiseSuccumb",
        "translation": "SOCPortAuthorityFinisherPromiseSuccumb",
        "field": "aInverse",
        "path": "$[24].aInverse[0]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "94d094687f53ae8e45dbbfc035222d2c010d92bb": {
        "source": "SOCPortAuthorityFinisherPromiseResist",
        "translation": "SOCPortAuthorityFinisherPromiseResist",
        "field": "aInverse",
        "path": "$[24].aInverse[1]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "2fe780ff007c2412fa275aea678f5471d9cc5784": {
        "source": "Succumb: Ask For a Break",
        "translation": "Succomber : demandez une pause",
        "field": "strTitle",
        "path": "$[25].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "14aad856c85ce28d7208b8ce82a9862d32479126": {
        "source": "[us] [narrows] their eyes, [glances] over their shoulder, and [says] [us-subj] will waive the docking fee in this one case.",
        "translation": "[us] [narrows] leurs yeux, [glances] par-dessus leur épaule et [says] [us-subj] renonceront aux frais d'amarrage dans ce cas.",
        "field": "strDesc",
        "path": "$[25].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "a894cd09e9c518a7e075ec41ead8adbebdc99268": {
        "source": "SocialCombatExit,[us],[them]",
        "translation": "SocialCombatSortie,[us],[them]",
        "field": "aInverse",
        "path": "$[25].aInverse[0]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "5c2e15ec56947206c30cd4b716966516d1691b1e": {
        "source": "Resist: Ask For a Break",
        "translation": "Résistez : demandez une pause",
        "field": "strTitle",
        "path": "$[26].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "74a02805c533f8788d29245b65a17844338abb4a": {
        "source": "[us] [declines] and [says] that if [us-subj] broke the rules everytime someone was in crisis, nobody would ever pay the docking fee.",
        "translation": "[us] [declines] et [says] que si [us-subj] enfreignait les règles à chaque fois que quelqu'un était en crise, personne ne paierait jamais les frais d'amarrage.",
        "field": "strDesc",
        "path": "$[26].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "69950e8220f4daa8e20db2e6f62de0256679908e": {
        "source": "SocialCombatExit,[us],[them]",
        "translation": "SocialCombatSortie,[us],[them]",
        "field": "aInverse",
        "path": "$[26].aInverse[0]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "e13732b6236cc1933578dcc776f08b89b1f0dc84": {
        "source": "Threaten to Call Manager",
        "translation": "Menacer d'appeler le gestionnaire",
        "field": "strTitle",
        "path": "$[27].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "f1594b3f54f64448488ca6e4f8a06b9ff1aa5036": {
        "source": "[us] [says] that if [them] can't sort out this mistaken charge then [us-subj] will have to call in a Manager who can.",
        "translation": "[us] [says] que si [them] ne peut pas régler cette erreur de facturation, alors [us-subj] devra faire appel à un responsable qui le pourra.",
        "field": "strDesc",
        "path": "$[27].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "de8f0095b507a3aac848418803ea560cdd918696": {
        "source": "SOCPortAuthorityFinisherReportToManagerSuccumb",
        "translation": "SOCPortAuthorityFinisherReportToManagerSuccumb",
        "field": "aInverse",
        "path": "$[27].aInverse[0]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "2830f41b384a5636b66f38fc96c70f13dff8d6d1": {
        "source": "SOCPortAuthorityFinisherReportToManagerResist",
        "translation": "SOCPortAuthorityFinisherReportToManagerResist",
        "field": "aInverse",
        "path": "$[27].aInverse[1]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "373bfb5f5290365701a32fe468e5bb95fdb036f6": {
        "source": "Succumb: Ask For a Break",
        "translation": "Succomber : demandez une pause",
        "field": "strTitle",
        "path": "$[28].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "34bea1d71624abed50040fa34516fbc0538851bc": {
        "source": "[us] [sighs] and [says] there is no reason to call the manager. [us] [says] you can undock one time but your fee will remain on the books until you pay it off.",
        "translation": "[us] [sighs] et [says] il n'y a aucune raison d'appeler le gestionnaire. [us] [says] vous pouvez vous désamarrer une seule fois, mais vos frais resteront inscrits jusqu'à ce que vous les payiez.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "938d4e7d661af9873d179c071be661506ce0897a": {
        "source": "SocialCombatExit,[us],[them]",
        "translation": "SocialCombatSortie,[us],[them]",
        "field": "aInverse",
        "path": "$[28].aInverse[0]",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "ae1c876b8ec367617c959ede5a64044f25e75781": {
        "source": "Resist: Ask For a Break",
        "translation": "Résistez : demandez une pause",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_port_authority.json"
    },
    "1ee787e14eab82c4f1b1b990c3deb5bf3f4a83d7": {
        "source": "[us] [says] [them] [is] welcome to find a manager and come back when [them-subj] [does].",
        "translation": "[us] [says] [them] [is] bienvenue pour trouver un manager et revenir quand [them-subj] [does].",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_port_authority.json"
    },
