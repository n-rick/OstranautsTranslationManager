    "d9a72929f44551db33f1bce252289156d4d32b56": {
        "source": "[us] [gains] MHNG LEO Arrest pledge.",
        "translation": "[us] [gains] MHNG LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "ce1094c00106b69f693f6a57a7904728e2c35b0a": {
        "source": "Adds MHNG LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement d'arrestation de MHNG LEO car le joueur a volé un navire.",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "436ef0485b7a79dc892fa21c6c2f00e8048873b1": {
        "source": "[us] [gains] MHNG LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] MHNG LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "b55f8863073a16507ecb4e9f8328ba1b4a03a643": {
        "source": "Adds MHNG LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement de menace MHNG LEO",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "d5cb6d49df9c02f1a97576549a9b020c552a9995": {
        "source": "[us] [gains] MHNG LEO Threat pledge.",
        "translation": "[us] [gains] MHNG LEO Engagement de menace.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "aacdb73de26387ca1a145d5a364eddd12c906f1c": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "b070343c8cceecebf3c3ccfe81ce37681300dade": {
        "source": "They haul you before a Suzhou magistrate for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Suzhou Brig for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un magistrat de Suzhou pour jugement, laissant derrière eux votre navire et votre équipement.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payables en totalité ou en plusieurs versements - ou partir à Suzhou Brig pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "c17da7c178356707c1cc1008b8a6e6f2203bc65d": {
        "source": "ENCHeatMSUZFineEnd",
        "translation": "ENCHeatMSUZFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "f232d5220baba5cde99b267ffd0256fcdabab44f": {
        "source": "ENCHeatMSUZFineDebtEnd",
        "translation": "ENCHeatMSUZFineDetteFin",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "92c5a2aac0d656a625e60e69b81668b3628a997c": {
        "source": "ENCHeatMSUZPrisonStart",
        "translation": "ENCHeatMSUZPrisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "47f836d72e152d303934ba529d121dd2925bff35": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "31d93cf6d8d6f207d7152fdec1bc1ea8e7d601de": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "7046920f40b5783453b123779d4fc08591150801": {
        "source": "ENCHeatMSUZFineFinish",
        "translation": "ENCHeatMSUZFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "8aa92e8b88220fd8088101f4eb82f2737cf35316": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "d66b12d75e0bd9c5af0f423ab098575a6b9751f1": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "41725af87cffae9d383a656b6b5042211b015b33": {
        "source": "ENCHeatMSUZFineFinish",
        "translation": "ENCHeatMSUZFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "d479c687c6cab9f8c668fa64611d90f4f69d2fe3": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "99e4e9ad66031c0e378c7722f1083f3c1893207c": {
        "source": "After processing, you are unceremoniously dumped outside the Suzhou Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie devant le bureau de sécurité de Suzhou. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "2da5e69ad15240346805c8ce8679a1b59a0039cf": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "3692081aa36c68f26a853b02ca5f6450ac11f0b4": {
        "source": "Off to Suzhou Brig",
        "translation": "En route pour Suzhou Brick",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "1588419e858002f41499e8ae503ed54f2833e7bc": {
        "source": "You are hauled off to Suzhou Brig.",
        "translation": "Vous êtes transporté à Suzhou Brig.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "388f3f2e91ed52d7914feb0eb6d18a59a81e5d70": {
        "source": "ENCHeatMSUZPrisonEnd",
        "translation": "ENCHeatMSUZPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "2729e1e40403f348f20a626412a9ceb790bccf18": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "6d54c12e149161eab63a4befa3be34b2db0dced7": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "5f8259f2ce594e43e5efc407537af6015f5d49ca": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "e7e0cec03731def828c9473caa5e0d06ca37f3d6": {
        "source": "ENCHeatMSUZPrisonFinish",
        "translation": "ENCHeatMSUZPrisonFinish",
        "field": "aInverse",
        "path": "$[5].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "9980edb567e7e8185d8b6d254d9a608a525ab90b": {
        "source": "CGEncHomeworldLEOEnemy",
        "translation": "CGEncHomeworldLEOEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
