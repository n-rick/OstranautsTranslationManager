    "f770d506965e57c75afa61f78998b18a1dc8bb00": {
        "source": "Trenchers History",
        "translation": "Histoire des trancheuses",
        "field": "strTitle",
        "path": "$[149].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
