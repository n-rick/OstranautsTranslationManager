    "bce8f8da25a7821dc884c863796a36adcf810deb": {
        "source": "SOCPoliceShakedownRecognizeFriendGossipReply2",
        "translation": "SOCPoliceShakedownRecognizeFriendGossipReply2",
        "field": "aInverse",
        "path": "$[172].aInverse[1]",
        "relative_path": "interactions/interactions2.json"
    },
    "e5f46ec2779aaf62f550c7d264ea225c7bc7d328": {
        "source": "SOCPoliceShakedownRecognizeFriendGossipReply3",
        "translation": "SOCPoliceShakedownReconnaîtreAmiGossipRépondre3",
        "field": "aInverse",
        "path": "$[172].aInverse[2]",
        "relative_path": "interactions/interactions2.json"
    },
    "574d04c8cab9c3dd998655437c95ca495b647b27": {
        "source": "Gossip About Harbourmaster Adeyemi",
        "translation": "Potins sur le capitaine du port Adeyemi",
        "field": "strTitle",
        "path": "$[173].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "f139cd3a49eb5603a2eac8b407729c71a1949d66": {
        "source": "[us] [says] that Harbourmaster Adeyemi just built a new wing on his place in the NoCo Villas.\nIt has a private port in the case the Big Man needs a quick exit.\nHe's growing more paranoid by the day. Thinks every slamming door is the inaugural gunshot of La Revolucion.",
        "translation": "[us] [says] que le capitaine du port Adeyemi vient de construire une nouvelle aile chez lui dans les villas NoCo.\nIl dispose d'un port privé au cas où le Big Man aurait besoin d'une sortie rapide.\nIl devient de plus en plus paranoïaque de jour en jour. Il pense que chaque claquement de porte est le coup de feu inaugural de La Révolution.",
        "field": "strDesc",
        "path": "$[173].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "1df1c3094c51d91c5b63dabe4c117358aa77b318": {
        "source": "SOCBlank",
        "translation": "SOCBlanque",
        "field": "aInverse",
        "path": "$[173].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "799ca2dfa67f4aa23bca9a945255e84ede3cf83e": {
        "source": "Gossip About Old Emporium",
        "translation": "Potins sur le vieux magasin",
        "field": "strTitle",
        "path": "$[174].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "0faffb1f68aeb52454e019bec9dc5be06e41c048": {
        "source": "[us] [says] the more puritanical Ayo execs are squawking about shuttering the Old Emporium again.\nSomething about productivity loss.\nWhat those humps don't realize is the Mescaform is the only reason spacers on this rock don't kill eachother.\nNot too often, anyway.",
        "translation": "[us] [says], les dirigeants d'Ayo les plus puritains hurlent à l'idée de fermer à nouveau le Old Emporium.\nQuelque chose à propos de la perte de productivité.\nCe que ces bosses ne réalisent pas, c'est que la Mescaforme est la seule raison pour laquelle les espaceurs sur ce rocher ne s'entretuent pas.\nPas très souvent, en tout cas.",
        "field": "strDesc",
        "path": "$[174].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "c593c817692245910c459fae600d1f437edbdbc8": {
        "source": "SOCBlank",
        "translation": "SOCBlanque",
        "field": "aInverse",
        "path": "$[174].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "a97602615e24fd6a0d87c3ab26ec2620d791a5e4": {
        "source": "Gossip About Scrapper Fines",
        "translation": "Potins sur les amendes des ferrailleurs",
        "field": "strTitle",
        "path": "$[175].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "09300169650ac8a0740d06e1f4a7006a92aa7895": {
        "source": "[us] [says] the fines for illegal salvage are scheduled to go up again next year.\nAyo loves the resale business, but you better believe they are going to find out exactly how much they can squeeze you without making you stop.",
        "translation": "[us] [says] les amendes pour récupération illégale devraient encore augmenter l'année prochaine.\nAyo adore le business de la revente, mais vous feriez mieux de croire qu'ils vont découvrir exactement à quel point ils peuvent vous presser sans vous faire arrêter.",
        "field": "strDesc",
        "path": "$[175].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "dbb8d21289ceb81c2bb657f84f222a1177af972e": {
        "source": "SOCBlank",
        "translation": "SOCBlanque",
        "field": "aInverse",
        "path": "$[175].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "f4c888d5c04da6db970b6d4f97eb2b45ee716872": {
        "source": "Ask About the Evidence Locker",
        "translation": "Renseignez-vous sur le casier de preuves",
        "field": "strTitle",
        "path": "$[176].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "b55b4092a47a4eeaa4a56cc52ff00e928ca4ec03": {
        "source": "[us] [asks] [them] if [them-subj] [has] confiscated anything good lately.",
        "translation": "[us] [asks] [them] si [them-subj] [has] a confisqué quelque chose de bon récemment.",
        "field": "strDesc",
        "path": "$[176].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "b6e56409ed5475487d08438c6aa4b8c0f132462a": {
        "source": "SOCPoliceShakedownRecognizeFriendEvidenceReply2",
        "translation": "SOCPoliceShakedownReconnaîtreAmiPreuveRépondre2",
        "field": "aInverse",
        "path": "$[176].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "ad267d1935a139466f291d88dca2796a1020270f": {
        "source": "Offer Murder Tool",
        "translation": "Offrir un outil de meurtre",
        "field": "strTitle",
        "path": "$[177].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "f62eaeee188db287991ace6977543afaa385412f": {
        "source": "[us] [says] some headcase on the shipbreaker floor killed his boss with the first tool he could find. Guy confessed immediately so the murder weapon is of no evidentiary value. [them] can have it if they want.",
        "translation": "[us] [says] un casque sur le sol du démolisseur a tué son patron avec le premier outil qu'il a pu trouver. Guy a immédiatement avoué, l'arme du crime n'a donc aucune valeur probante. [them] peut l'avoir s'il le souhaite.",
        "field": "strDesc",
        "path": "$[177].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "9a54351380c4817b04157c5687ca927df344fa73": {
        "source": "SOCPoliceShakedownRecognizeFriendEvidenceReply1Yes",
        "translation": "SOCPoliceShakedownReconnaîtreAmiPreuveRépondre1Oui",
        "field": "aInverse",
        "path": "$[177].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "6e421feb3f9b7b81f3c596892ffb7d6b5109342c": {
        "source": "SOCPoliceShakedownRecognizeFriendEvidenceReply1No",
        "translation": "SOCPoliceShakedownReconnaîtreAmiPreuveRépondre1Non",
        "field": "aInverse",
        "path": "$[177].aInverse[1]",
        "relative_path": "interactions/interactions2.json"
    },
    "d3af74159aefdb0961788318c0858d5944035dfc": {
        "source": "Take the Murder Tool.",
        "translation": "Prenez l'outil du meurtre.",
        "field": "strTitle",
        "path": "$[178].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "e7f773c3711b07239c0da4af581e2f750f0e3965": {
        "source": "[us] [says] why not? Guy clearly doesn't need it anymore.",
        "translation": "[us] [says] pourquoi pas ? Guy n’en a clairement plus besoin.",
        "field": "strDesc",
        "path": "$[178].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "ea7724faf07c68e2d27e072f9ba5c6bbb3ed5247": {
        "source": "SOCPoliceShakedownRecognizeFriendEvidenceReply1YesGiveItem",
        "translation": "SOCPoliceShakedownReconnaîtreAmiPreuveRépondre1OuiDonner un élément",
        "field": "aInverse",
        "path": "$[178].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "aa527d8fc974caee2110905b0778f077998dc4b2": {
        "source": "Give Them the Murder Tool",
        "translation": "Donnez-leur l'outil du meurtre",
        "field": "strTitle",
        "path": "$[179].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "fd1d9a35f796d740e10bd375a8b17ed906d3d89f": {
        "source": "[us] [hands] over the tool, [tells] [them-obj] not to do anything too stupid with it, and [us-heads] back to [us-pos] patrol ship.",
        "translation": "[us] [hands] sur l'outil, [tells] [them-obj] de ne rien faire de trop stupide avec, et [us-heads] de retour au [us-pos] navire de patrouille.",
        "field": "strDesc",
        "path": "$[179].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "c4fc883c7692983d1c5a13a7c99507e87fb4c16c": {
        "source": "SocialCombatExit,[us],[them]",
        "translation": "SocialCombatSortie,[us],[them]",
        "field": "aInverse",
        "path": "$[179].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "8c6552609126a11064898d872b85056d7fb9ddc9": {
        "source": "addthem,ItmEvidenceLockerMurderWeapon",
        "translation": "ajoutez-les, ItmEvidenceLockerMurderWeapon",
        "field": "aLootItms",
        "path": "$[179].aLootItms[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "5cb781e1f8ce0de4e972fdcd5de88a0ff86cc1a2": {
        "source": "Decline the Murder Tool",
        "translation": "Refusez l’outil de meurtre",
        "field": "strTitle",
        "path": "$[180].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "18a9626e6438581d73c7e2579b8c460cae736a3c": {
        "source": "[us] [says] thanks but [us-subj] [doesn't] need a tool that badly.\n[them] [shrugs], then [departs] for their patrol vehicle.",
        "translation": "[us] [says] merci mais [us-subj] [doesn't] a vraiment besoin d'un outil.\n[them] [shrugs], puis [departs] pour leur véhicule de patrouille.",
        "field": "strDesc",
        "path": "$[180].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
