    "1aa7e11d3435dd12b08ddec7177ce9bc8ceae028": {
        "source": "Virginia Technology",
        "translation": "Technologie de Virginie",
        "field": "strTitle",
        "path": "$[89].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "117b4586aa7ec7d995a315e7f83c2d7d6a5a7bc9": {
        "source": "Titan ships and habitats are state of the art, and the wealth of scientific and engineering acumen on Virginia and other Titan-controlled colonies exceeded the rest of the System until very recently. The United States military-industrial complex - multinational military contractors like Langdon-Phillips, Weber Tools & Oil, and Smartlink, as well as NASA's Outer Space Command - made Titan its offworld headquarters.",
        "translation": "Les vaisseaux et les habitats des Titans sont à la pointe de la technologie, et la richesse des connaissances scientifiques et techniques de la Virginie et des autres colonies contrôlées par les Titans dépassait celle du reste du système jusqu'à très récemment. Le complexe militaro-industriel américain – des entrepreneurs militaires multinationaux comme Langdon-Phillips, Weber Tools & Oil et Smartlink, ainsi que le Commandement de l'espace extra-atmosphérique de la NASA – a fait de Titan son quartier général hors du monde.",
        "field": "strDesc",
        "path": "$[89].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "01beee1c3bc004088b6836d36f17ef3604b7f98c": {
