    "1e80060487ce41109a1b933f0023014474590807": {
        "source": "JFTS LEO Attacking Criminal",
        "translation": "JFTS LEO attaquant un criminel",
        "field": "strTitle",
        "path": "$[15].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "4f0e5e94f48d1901f09a51a0cf5fd8a38a538ae2": {
        "source": "\"Hey, it's that criminal! Get 'em!\" [us-shouts] [us], pointing towards [them].",
        "translation": "\"Hé, c'est si criminel ! Attrapez-les !\" [us-shouts] [us], pointant vers [them].",
        "field": "strDesc",
        "path": "$[15].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
