    "4692277d77103eb4eceda6ed8aa6fd5397c87f3a": {
        "source": "Describe Growing Up on Venus",
        "translation": "Décrire le fait de grandir sur Vénus",
        "field": "strTitle",
        "path": "$[263].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "86ab92fa524521f8c4bd7c7f4b88bf8c79de2db7": {
        "source": "[us] [says] that life on a Venusian aerostat isn't so different than life on a big station. But Newcal is getting very crowded and [us] [is] excited for the upcoming launch of the aerostat Los Angeles.",
        "translation": "[us] [says] que la vie sur un aérostat vénusien n'est pas si différente de la vie sur une grande station. Mais Newcal devient très fréquenté et [us] [is] excité par le lancement prochain de l'aérostat Los Angeles.",
        "field": "strDesc",
        "path": "$[263].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "a18e373dc5d7bdba58ffc1667ac2fbe5cfdbb0bd": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[263].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "5a3a62ef8fcc403a15218cefa460f721cfdaa94d": {
        "source": "Describe the Worst Parts of Venus",
        "translation": "Décrivez les pires parties de Vénus",
        "field": "strTitle",
        "path": "$[264].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "1a5df176179a1422eaf89238008007c00af8b39c": {
        "source": "[us] [says] that the piracy around the Newcal aerostat colony is getting worse every day. If the crew refuses to cooperate, the pirates will force the entire ship down to the crushing atmosphere at Venus's surface.",
        "translation": "[us] [says] that the piracy around the Newcal aerostat colony is getting worse every day. If the crew refuses to cooperate, the pirates will force the entire ship down to the crushing atmosphere at Venus's surface.",
        "field": "strDesc",
        "path": "$[264].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "5237f3cde51932e31e20848521b967081d4cf989": {
        "source": "addthem,VenusStory",
        "translation": "ajoutez-les, VenusStory",
        "field": "aLootItms",
        "path": "$[264].aLootItms[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "d6b879a5dbba535e124c127ff2e7a4d46e0a82ed": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[264].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "9678800cfb254c702abbfab22211714995d9065a": {
        "source": "Describe a Memory from Venus",
        "translation": "Décrire un souvenir de Vénus",
        "field": "strTitle",
        "path": "$[265].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "246040f69babb751aa931ba88cf46c640f03f985": {
        "source": "[us] [says] [us-subj] grew up watching the RCS drag races outside the Brazilian aerostat colony 'Cloudbreak.' The little coffins cut through the dense yellow sulfuric fog of the Venusian atmosphere like it wasn't even there.",
        "translation": "[us] [says] [us-subj] a grandi en regardant les courses de dragsters du RCS à l'extérieur de la colonie d'aérostats brésilienne « Cloudbreak ». Les petits cercueils traversaient le dense brouillard sulfurique jaune de l'atmosphère vénusienne comme s'il n'était même pas là.",
        "field": "strDesc",
        "path": "$[265].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "3335e6d87a2a16b0c8fe78f2bb0ce35132f8c1a6": {
