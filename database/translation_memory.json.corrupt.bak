    "e4018b35ca188e74672f25ddef7c7974808c1a4d": {
        "source": "Adds HQCH LEO Arrest pledge to us",
        "translation": "Nous ajoute l'engagement d'arrestation HQCH LEO",
        "field": "strTitle",
        "path": "$[28].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "19247af450788677b26728b168d31dbb4e6ae171": {
        "source": "[us] [gains] HQCH LEO Arrest pledge.",
        "translation": "[us] [gains] HQCH LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "45130fc31af6e88cda48282d1dc53fc4e7dbd738": {
        "source": "Adds HQCH LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement d'arrestation HQCH LEO car le joueur a volé un navire.",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "f5b51545478603308852916405ce7d6bb51cec99": {
        "source": "[us] [gains] HQCH LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] HQCH LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "58073d4ef5a4e528159e4780d446da97dde2ca88": {
        "source": "Adds HQCH LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement HQCH LEO Threat",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "bdc149e1e51046b69d76ecc980cef9514853e0da": {
        "source": "[us] [gains] HQCH LEO Threat pledge.",
        "translation": "[us] [gains] HQCH LEO Engagement de menace.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "f5bfdd9fb5ed2bcadff12ceecd97536a2db47dbf": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "332e8e2baf613b74b4e8b1cb9c17e81cf27796fa": {
        "source": "They haul you before an Atlantean magistrate for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Atlantis Brig for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un magistrat atlante pour jugement, laissant derrière eux votre vaisseau et votre équipement.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payable en totalité ou en plusieurs versements - ou vous partez à Atlantis Brig pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "2857bf4835b2d3cf05d9853eb6b6ed090c026dd4": {
        "source": "ENCHeatJATLFineEnd",
        "translation": "ENCHeatJATLFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "9966369f144e7a66a99480592d896db6695b0109": {
        "source": "ENCHeatJATLFineDebtEnd",
        "translation": "ENCHeatJATLFineDebtEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "c4d9d94623f4f3b9879e65b04df5c2458da351c3": {
        "source": "ENCHeatJATLPrisonStart",
        "translation": "ENCHeatJATLPrisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "c658e74ca69ac4fa16f131efe48733167b30ad66": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "389ce6b20a1d44b36078fbe52d5a905a5fed259f": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "8db4231cd20ec8a12d795dd65f80b79e7325e7c9": {
        "source": "ENCHeatJATLFineFinish",
        "translation": "ENCHeatJATLFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "471c0573f994dbd64278662ebca859f11c80e198": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "c23ce4e60903912fec12a4a292c515294e95ac0c": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "629af92903c4523b0b8366eae4ad285694957b54": {
        "source": "ENCHeatJATLFineFinish",
        "translation": "ENCHeatJATLFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "677c531913fdba1a26aca14b13a049fb1cf42131": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "7fd7be303a60e66dee128178dae1b1f4a28c7442": {
        "source": "After processing, you are unceremoniously dumped outside the Atlantis Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l’extérieur du bureau de sécurité d’Atlantis. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "7887103e6324e4048803e2673ede8f07bb767d93": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "dec60582c0fccb29f13d939c17fc18d79235761f": {
        "source": "Off to Atlantis Brig",
        "translation": "En route vers le brick Atlantis",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "b5dc6910714755229fc0c8c7ccb28f1f4e760aa7": {
        "source": "You are hauled off to Atlantis Brig.",
        "translation": "Vous êtes transporté à Atlantis Brig.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_JATL.json"
    },
    "4d509f0850cca2076382f2b2f72f9e61330f80e5": {
        "source": "ENCHeatJATLPrisonEnd",
        "translation": "ENCHeatJATLPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
