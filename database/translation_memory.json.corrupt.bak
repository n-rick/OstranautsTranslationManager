    "5942ba8de8d975aa6f49e8165c35470f840297b1": {
        "source": "Crack Drone OS (Hacking Skill)",
        "translation": "Crack Drone OS (compétence de piratage)",
        "field": "strTitle",
        "path": "$[19].strTitle",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "f584bbb56a25a7bb9c0d1cfce674d15433298471": {
        "source": "Defeating the security on operating systems like these was always a siren's call. A puzzle you could sink your teeth into in your down time.\nAnd thanks to various governmental authorities, plus the manufacturer's recovery pipeline, each device has multiple backdoors for you to find an exploit. Like a puzzle with multiple solutions!\nAnyway, you try to remember the trick to this particular model...",
        "translation": "Defeating the security on operating systems like these was always a siren's call. A puzzle you could sink your teeth into in your down time.\nAnd thanks to various governmental authorities, plus the manufacturer's recovery pipeline, each device has multiple backdoors for you to find an exploit. Like a puzzle with multiple solutions!\nAnyway, you try to remember the trick to this particular model...",
        "field": "strDesc",
        "path": "$[19].strDesc",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "078c1397996c7fabf744d11e3539327ace093df4": {
        "source": "Use hacking skill to access the drone OS.",
        "translation": "Utilisez vos compétences de piratage pour accéder au système d'exploitation du drone.",
        "field": "strTooltip",
        "path": "$[19].strTooltip",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "6ac5b53dfaed8bbb39433d0a32ba357287851bb3": {
        "source": "HackRobotSkillFinished,[us],[them]",
        "translation": "HackRobotSkillFinished,[us],[them]",
        "field": "aInverse",
        "path": "$[19].aInverse[0]",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "c07a452dee4c5fdd689a53c22f788af4b832f86b": {
        "source": "Use Exploit to Force Reboot",
        "translation": "Utiliser Exploit pour forcer le redémarrage",
        "field": "strTitle",
        "path": "$[20].strTitle",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "572d342a44751588f1041659a1c900e2d6fdff67": {
        "source": "Sure enough, nobody bothered to patch the exploit you chose this time, and you're greeted with the home screen.\nThat's the problem with behemoth orgs: not very nimble. And the hacker community chews through them too fast.\nOh well, at least it was worth the little nostalgia kick.",
        "translation": "Effectivement, personne n'a pris la peine de corriger l'exploit que vous avez choisi cette fois-ci, et vous êtes accueilli par l'écran d'accueil.\nC’est le problème des organisations géantes : elles ne sont pas très agiles. Et la communauté des hackers les ronge trop vite.\nEh bien, au moins, ça valait le petit coup de nostalgie.",
        "field": "strDesc",
        "path": "$[20].strDesc",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "ef95a97f7b7403c718e770a81b371d9ebd119b4e": {
        "source": "See the outcome of your hacking attempt.",
        "translation": "Consultez le résultat de votre tentative de piratage.",
        "field": "strTooltip",
        "path": "$[20].strTooltip",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "158bb6fca48a413075ff24741d3ad4cb08e64ed6": {
        "source": "HackRobotReboot,[them],[them]",
        "translation": "HackRobotReboot,[them],[them]",
        "field": "aInverse",
        "path": "$[20].aInverse[0]",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "e1e96e657ac5d76ab0d5fcbdf590605b23bf5f83": {
        "source": "Let's Crack Some Stuff!",
        "translation": "Cassons quelques trucs !",
        "field": "strTitle",
        "path": "$[21].strTitle",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "fc1f4a4883b70fc94043b016f8bd96b3f83d3675": {
        "source": "You launch the cracking program, but it doesn't take long to realize you're in over your head.\nWhat does this software even do? Does it work on devices like these? Do you plug the target device in somewhere? Or do you need to start the software first?\nYou wish there was a tutorial or something. Or even some menus.\nOh well, no 1337 h4x0r5 for you.",
        "translation": "Vous lancez le programme de craquage, mais il ne faut pas longtemps pour réaliser que vous êtes dépassé.\nQue fait ce logiciel ? Est-ce que ça marche sur des appareils comme ceux-ci ? Branchez-vous l'appareil cible quelque part ? Ou faut-il d'abord démarrer le logiciel ?\nVous souhaiteriez qu'il y ait un tutoriel ou quelque chose comme ça. Ou même certains menus.\nEh bien, pas de 1337 h4x0r5 pour vous.",
        "field": "strDesc",
        "path": "$[21].strDesc",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "61509a496f28052912df31bfb36a359bf676f455": {
        "source": "Attempt to crack into the drone OS using a cracking software",
        "translation": "Tentative de piratage du système d'exploitation du drone à l'aide d'un logiciel de piratage",
        "field": "strTooltip",
        "path": "$[21].strTooltip",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "f2829940717b8075cbf409526c78097c88e545d2": {
        "source": "Use,CTHackPDAOnNotLocked,false",
        "translation": "Utiliser, CTHackPDAOnNotLocked, faux",
        "field": "aLootItms",
        "path": "$[21].aLootItms[0]",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "752410bae2453fa293752d581d5d149338dedd5c": {
        "source": "Try To Crack Drone OS",
        "translation": "Essayez de cracker le système d'exploitation du drone",
        "field": "strTitle",
        "path": "$[22].strTitle",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "5f7f39d4b45e6cdf756fb4f351755cf152e782dc": {
        "source": "Hacking was never your thing, but you decide it never hurts to try anyway. Maybe there's a boot menu or something? Safe mode?",
        "translation": "Le piratage n'a jamais été votre truc, mais vous décidez que ça ne fait jamais de mal d'essayer de toute façon. Peut-être qu'il y a un menu de démarrage ou quelque chose du genre ? Mode sans échec ?",
        "field": "strDesc",
        "path": "$[22].strDesc",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "eb4633e6073e3c5bda43389947da52c7f8c58f42": {
