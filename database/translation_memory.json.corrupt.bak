        "path": "$[7].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "f0a1463060185f7ae17427a9104a5466361699d0": {
        "source": "\"Suspect spotted,\" [us] [says], looking at [them].",
        "translation": "\"Suspect repéré\", [us] [says], regardant [them].",
        "field": "strDesc",
        "path": "$[7].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "eceed45d3cefbf93a8229075cd21b9ccf1ab6d90": {
