        "translation": "Prenez l'alcool.",
        "field": "strTitle",
        "path": "$[182].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "1a4c599ea8950bb687e74faa69ba4cd2c1cf106d": {
        "source": "[us] [says] hell yeah. Love drinking on the boss's dime.",
