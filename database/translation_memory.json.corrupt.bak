        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "6b7bc765747682580ecd33e5ef70baa932472442": {
        "source": "GalCon LEO Done Arresting Criminal",
        "translation": "GalCon LEO a arrêté le criminel",
        "field": "strTitle",
        "path": "$[12].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "caaafeba6cd9d6cb2111f26d3a1632570d2b05b7": {
        "source": "\"Another win for the law,\" [us] [says].",
        "translation": "\"Une autre victoire pour la loi\", [us] [says].",
        "field": "strDesc",
        "path": "$[12].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
