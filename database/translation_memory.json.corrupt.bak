    "6124f941f11dff0f8799362bf0e6fad826bb4cbc": {
        "source": "Hangzhou Orbital, O'Neill cylinder in Mars orbit",
        "translation": "Hangzhou Orbital, cylindre O'Neill en orbite sur Mars",
        "field": "strTitle",
        "path": "$[65].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "3f4afc794d72ba286fae4c44c6d844f0079f8548": {
        "source": "Hangzhou Orbital (Hangzhou Gong, 杭州宫) is an O'Neill Cylinder space habitat. Over two decades, it was constructed from mineral-rich trojan asteroids at Mars' 5th Lagrange point. The interior of the colony was designed to resemble, and even improve on, Earth environments, from its near 1G spin gravity, its 24-hour Earth day, and its sustainable, symbiotic ecosystem.",
        "translation": "Hangzhou Orbital (Hangzhou Gong, 杭州宫) est un habitat spatial du cylindre O'Neill. Pendant deux décennies, il a été construit à partir d’astéroïdes troyens riches en minéraux au 5ème point de Lagrange de Mars. L'intérieur de la colonie a été conçu pour ressembler, voire améliorer, aux environnements terrestres, de par sa gravité de spin proche de 1G, son jour terrestre de 24 heures et son écosystème symbiotique durable.",
        "field": "strDesc",
        "path": "$[65].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
