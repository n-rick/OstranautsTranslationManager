        "relative_path": "interactions/interactions_datafiles.json"
    },
    "48b56223e6407017c729cb8bd28aeed05de4b23d": {
        "source": "The K-Leg Shipbreaker's Yard",
        "translation": "Le chantier de démolition de navires K-Leg",
        "field": "strTitle",
        "path": "$[53].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "7c30d7d8c1a7fd0ec3215da398b5a570fca15ccb": {
        "source": "Ships are deconstructed in one of three Main Bays near the centre of the Shipbreaker's Yard. Ayotimiwa maximises its profit by completing its contracts as quickly as possible, stripping and salvaging raw materials and easily accessible components. This has led to a secondary economy in the Boneyard of scavengers who hunt for rarer parts. Deconstruction may take several weeks for smaller vessels and up to several months for larger vessels like deep space freighters or barges.",
        "translation": "Les navires sont déconstruits dans l'une des trois baies principales proches du centre du chantier de déconstruction. Ayotimiwa maximise ses profits en complétant ses contrats le plus rapidement possible, en dépouillant et en récupérant les matières premières et les composants facilement accessibles. Cela a conduit à une économie secondaire dans le Boneyard de charognards qui recherchent des pièces plus rares. La déconstruction peut prendre plusieurs semaines pour les petits navires et jusqu'à plusieurs mois pour les plus gros navires comme les cargos ou les barges de l'espace lointain.",
        "field": "strDesc",
        "path": "$[53].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "3e8343b0783e98dc0409138e531a131f04c9d97a": {
        "source": "DataWIKIOKLG",
        "translation": "DonnéesWIKIOKLG",
        "field": "aInverse",
        "path": "$[53].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "c32b57903b07fd271f600b11d4c839f60be38d1a": {
        "source": "DataWIKIOKLGStats",
        "translation": "DonnéesWIKIOKLGStats",
        "field": "aInverse",
        "path": "$[53].aInverse[1]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "f6bacf09dc28b83d6b1df1e9077e3fce510a4bfc": {
        "source": "DataWIKIOKLGHistory",
        "translation": "DonnéesWIKIOKLGHistoire",
        "field": "aInverse",
        "path": "$[53].aInverse[2]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "cc63993650001c0afcaf2fc624ef8e95296e8063": {
        "source": "DataWIKIOKLGBoneyard",
        "translation": "DonnéesWIKIOKLGBoneyard",
        "field": "aInverse",
        "path": "$[53].aInverse[3]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "a4226f998157363ff2db33e7937deaddc3bf6386": {
        "source": "The K-Leg Boneyard",
        "translation": "Le cimetière des jambes K",
        "field": "strTitle",
        "path": "$[54].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "d9a897998b8519914ab0578ed81a2fbbe94805e3": {
        "source": "Around the Shipbreaker's Yard is the Boneyard, where dozens, even hundreds of low priority derelicts await deconstruction. Ayotimiwa allows scavengers to pick over its wrecks for rare or legacy parts - publicly it condemns the practise but makes no real effort to end it - knowing that it benefits from the secondary economy their existence creates on K-Leg, and from the traffic of ships which seek it out. Finding old or rare parts in the System is very often simply a matter of trying your luck at K-Leg, and much cheaper than tracking down the original manufacturer.",
        "translation": "Autour du Shipbreaker's Yard se trouve le Boneyard, où des dizaines, voire des centaines d'épaves de faible priorité attendent d'être déconstruites. Ayotimiwa permet aux charognards de récupérer ses épaves à la recherche de pièces rares ou héritées - elle condamne publiquement cette pratique mais ne fait aucun effort réel pour y mettre fin - sachant qu'elle bénéficie de l'économie secondaire que leur existence crée sur K-Leg et du trafic de navires qui la recherchent. Trouver des pièces anciennes ou rares dans le système consiste très souvent simplement à tenter votre chance chez K-Leg, et c'est beaucoup moins cher que de rechercher le fabricant d'origine.",
        "field": "strDesc",
        "path": "$[54].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "e31a42d54123bc576c0584dafe952ef8f4209451": {
        "source": "DataWIKIOKLG",
        "translation": "DonnéesWIKIOKLG",
        "field": "aInverse",
        "path": "$[54].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
