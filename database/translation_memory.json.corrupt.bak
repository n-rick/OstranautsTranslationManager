    "05d84e8ad9bef803f50c0b398a8415199edb4563": {
        "source": "Tripura Supreme Blend",
        "translation": "Mélange suprême Tripura",
        "field": "strTitle",
        "path": "$[152].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "6e478898e5e77b11ddcdac8305d5e36d9c111b00": {
        "source": "Tripura is an Indian manufacturer and distributer of tea that has been in continuous operation for over two hundred years.\n\n<b>Product:</b> Tea\n<b>Manufacturer:</b> Tripura Tea Incorporated\n<b>Country of origin:</b> Old India\n<b>Variants:</b> Tripura Breakfast Tea, Tripura Ceremonial Tea, Tripura Cleansing Blend\n<b>Produced in:</b> Old India, Xinhua, Mars\n<b>Ticker symbol:</b> TRIP\n<b>Slogans:</b>\nDiscover bliss\nTea brewed with love",
        "translation": "Tripura est un fabricant et distributeur indien de thé en activité depuis plus de deux cents ans.\n\n<b>Produit :</b> Thé\n<b>Fabricant :</b> Tripura Tea Incorporated\n<b>Pays d'origine :</b> Vieille Inde\n<b>Variantes :</b> Thé du petit-déjeuner Tripura, Thé de cérémonie Tripura, Mélange nettoyant Tripura\n<b>Produit en :</b> Vieille Inde, Xinhua, Mars\n<b>Symbole boursier :</b> VOYAGE\n<b>Slogans :</b>\nDécouvrez le bonheur\nThé infusé avec amour",
        "field": "strDesc",
        "path": "$[152].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "6cdfeb4f3efa634c6c058ef0a3ca73141bdf2659": {
        "source": "DataWIKITripuraHistory",
