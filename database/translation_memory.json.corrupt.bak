    "3dd36a5ba92b69fd2475c4db900b1814e0590642": {
        "source": "Voltaire Layout",
        "translation": "Disposition Voltaire",
        "field": "strTitle",
        "path": "$[83].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "6be28dc5a9b99796e37930d9b4e8874b1c08c800": {
        "source": "Bases in the BNW network are named for the Greek alphabet. This list, though incomplete, succinctly characterises the nature of the BNW network:\n\n<b>Alpha:</b> Originally a weapons test range, now the core administrative hub of BNW.\n<b>Beta:</b> Informatics and biology.\n<b>Delta:</b> Medical science and major hospital, as well as a teaching hospital.\n<b>Lambda:</b> High-energy physics.\n<b>Mu:</b> Metallurgy and manufacturing.\n<b>Rho:</b> Rocketry & aerospace design.\n<b>Sigma:</b> Psychology and social sciences.\n<b>Tau:</b> Private facility, paradoxically notorious for its secrecy.\n<b>Upsilon:</b> Voltaire's main launch facility and port.\n<b>Phi:</b> Site of Voltaire University. Close proximity to Upsilon.\n<b>Omega:</b> Located in Robinson Crater, site of heavy payload weapons experiments",
        "translation": "Les bases du réseau BNW portent le nom de l'alphabet grec. Cette liste, bien qu'incomplète, caractérise succinctement la nature du réseau BNW :\n\n<b>Alpha :</b> À l'origine un stand d'essai d'armes, aujourd'hui le principal centre administratif du BNW.\n<b>Beta :</b> Informatique et biologie.\n<b>Delta :</b> Sciences médicales et grand hôpital, ainsi qu'un hôpital universitaire.\n<b>Lambda :</b> Physique des hautes énergies.\n<b>Mu:</b> Métallurgie et fabrication.\n<b>Rho :</b> Conception de fusées et d'aérospatiales.\n<b>Sigma:</b> Psychologie et sciences sociales.\n<b>Tau:</b> Établissement privé, paradoxalement connu pour son secret.\n<b>Upsilon :</b> Principale installation de lancement et port de Voltaire.\n<b>Phi:</b> Site de l'Université Voltaire. Proche d'Upsilon.\n<b>Omega :</b> Situé dans le cratère Robinson, site d'expériences sur les armes à charge utile lourde.",
        "field": "strDesc",
        "path": "$[83].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
