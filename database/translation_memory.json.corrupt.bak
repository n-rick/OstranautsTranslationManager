    },
    "b0685f37534e7ed01011e0c62b1d026c31ef1895": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "58fb471dce59765a6ce0db6a0cd3262125ee86ff": {
        "source": "After processing, you are unceremoniously dumped outside the Fort Simpson Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l'extérieur du bureau de sécurité de Fort Simpson. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "6076afabe26e5a1b83517c17ff82276bc121aeea": {
