    "ce0bab92a919509af299f3ca9b989e26568fddf7": {
        "source": "Continue Career",
        "translation": "Continuer la carrière",
        "field": "strTitle",
        "path": "$[341].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "485de98d7bfbff628619fed547a163dc39dc1652": {
        "source": "You decide the time isn't right. Yet.",
        "translation": "Vous décidez que le moment n’est pas le bon. Encore.",
        "field": "strDesc",
        "path": "$[341].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "46d609d1fccae9b193004d13e79f56a54a1bdb99": {
        "source": "King Incognito",
        "translation": "Roi Incognito",
        "field": "strTitle",
        "path": "$[342].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "6f721f5ab11609f26e1c4fffc0836147adcea99f": {
        "source": "You're drinking at the local watering hole after your shift, when you see the unicorn. They're the scion of an Ayotimiwa executive, sneaking out to rub shoulders and bump uglies with the common folk. You wince as they try to pay for their round in yuan - it's dollars for the likes of us, friend.\n\nIf you're careful, and lucky, they could be an opportunity.",
        "translation": "Vous buvez au point d'eau local après votre travail, lorsque vous voyez la licorne. Ils sont les descendants d'un cadre d'Ayotimiwa, qui se faufilent pour côtoyer et cogner les laids avec les gens ordinaires. Vous grimacez quand ils essaient de payer leur tournée en yuans – c'est des dollars pour nous comme nous, mon ami.\n\nSi vous êtes prudent et chanceux, cela pourrait être une opportunité.",
        "field": "strDesc",
        "path": "$[342].strDesc",
        "relative_path": "interactions/interactions.json"
    },
