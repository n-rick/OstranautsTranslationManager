    },
    "f353eb9228907ddc395df1c52f7ceecc6e871e2a": {
        "source": "After a while of messing with it, you don't really make any headway. And you're out of ideas. Without more hacking skills, you'll probably need an unlocked PDA and some sort of specialized software to crack this drone.",
        "translation": "After a while of messing with it, you don't really make any headway. And you're out of ideas. Without more hacking skills, you'll probably need an unlocked PDA and some sort of specialized software to crack this drone.",
        "field": "strDesc",
        "path": "$[23].strDesc",
        "relative_path": "interactions/interactions_hacking.json"
    },
    "d5d1c097dc25ad1728c20c75840bd294bafaf114": {
