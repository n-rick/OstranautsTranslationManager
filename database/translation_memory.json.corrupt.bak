    "8cb89c88214800cfde22617236fb68fc1d03a135": {
        "source": "OWNG History",
        "translation": "Historique de PROPRIÉTÉ",
        "field": "strTitle",
        "path": "$[133].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "7777600a3ab11809346298c026b0d3a0bcde0a80": {
        "source": "The Off World News Group launched with Olympus Networks' first rollout of unified wireless network coverage to Tharsis Landing in 2035. The launch was preceded by both the merger of Harper Communications with Shanghai News Limited to create Harper Xiang, and the celebrity wedding of the media moguls in charge. OWNG began with its flagship 24-hour news service 'Channel One', and has since begun Channel Two and Channel Three for entertainment and live sports respectively.",
        "translation": "The Off World News Group launched with Olympus Networks' first rollout of unified wireless network coverage to Tharsis Landing in 2035. The launch was preceded by both the merger of Harper Communications with Shanghai News Limited to create Harper Xiang, and the celebrity wedding of the media moguls in charge. OWNG began with its flagship 24-hour news service 'Channel One', and has since begun Channel Two and Channel Three for entertainment and live sports respectively.",
        "field": "strDesc",
        "path": "$[133].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
