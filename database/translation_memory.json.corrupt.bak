    "721b421435982512edcf0710af9ded134377db99": {
        "source": "Pick their Pocket",
        "translation": "Choisissez leur poche",
        "field": "strTitle",
        "path": "$[348].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "d25877d42a9e84952532f758d5975f53d7eae732": {
        "source": "They're a mark if ever there was one. They might as well have a target embroidered on the back of their bamboo silk tunic.\n\nYou wait until after the fourth round. When they stagger back from the head, you make your move, brush into them on their way out. They don't notice a thing.",
        "translation": "Ils sont une marque s'il en est une. Autant faire broder une cible au dos de leur tunique en soie de bambou.\n\nVous attendez après le quatrième tour. Lorsqu'ils reculent de la tête, vous bougez et les effleurez en sortant. Ils ne remarquent rien.",
        "field": "strDesc",
        "path": "$[348].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "9f44f1d833b3d269f853deb2917f6b5721b14ba9": {
        "source": "Just Mug Them",
        "translation": "Agitez-les simplement",
        "field": "strTitle",
        "path": "$[349].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "15801740cbd95f0a24ac7fd35172247c883aed18": {
        "source": "Fuck it. Sometimes the path to riches is a straight line.\n\nPity you don't notice the security detail until it's too late, which happens to be when she's drawing on you. You grab the gun, you struggle - there's a shot -\n\nAnd a dead body on your conscience. But you had to have known this was a possibility, right? Eggs, omelettes.",
        "translation": "Putain. Parfois, le chemin vers la richesse est une ligne droite.\n\nDommage que vous ne remarquiez les détails de la sécurité que lorsqu'il est trop tard, ce qui se produit lorsqu'elle fait appel à vous. Vous prenez le pistolet, vous luttez - il y a un coup de feu -\n\nEt un cadavre sur votre conscience. Mais tu devais savoir que c'était une possibilité, non ? Oeufs, omelettes.",
        "field": "strDesc",
        "path": "$[349].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "2b478f9ae869e9e58286a1948c2b725ecf523aaa": {
        "source": "CGEncImprisoned",
        "translation": "CGEncEmprisonné",
        "field": "aInverse",
        "path": "$[349].aInverse[0]",
        "relative_path": "interactions/interactions.json"
    },
