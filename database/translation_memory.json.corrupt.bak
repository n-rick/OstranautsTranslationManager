    "1d30b68a9e9388488cab1bc1b9ef024fb1c9b16a": {
        "source": "Newcal Technical Design",
        "translation": "Conception technique Newcal",
        "field": "strTitle",
        "path": "$[78].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "fed7b1deb3a174aaa1a3d0af3a1ccb93ae23ffc7": {
        "source": "Newcal's lifting components are technically airships, not aerostats, because they are untethered and capable of self-propulsion; however the propulsion is rarely used, and then only for correctional purposes, the lifters are shaped un-aerodynamically for stability, and the term aerostat is habitual. All aerostats are filled with breathable air, which at 50km above Venus's surface is a lifting gas. To withstand the corrosive Venusian atmosphere, and the clouds of sulfuric acid, Newcal aerostats are made from the purpose-designed plastic fiber Caylon.",
        "translation": "Les composants de levage de Newcal sont techniquement des dirigeables, et non des aérostats, car ils ne sont pas attachés et capables de s'autopropulser ; cependant, la propulsion est rarement utilisée, et seulement à des fins correctionnelles, les élévateurs ont une forme non aérodynamique pour plus de stabilité, et le terme aérostat est habituel. Tous les aérostats sont remplis d'air respirable qui, à 50 km au-dessus de la surface de Vénus, est un gaz élévateur. Pour résister à l'atmosphère corrosive de Vénus et aux nuages ​​d'acide sulfurique, les aérostats Newcal sont fabriqués à partir de la fibre plastique spécialement conçue Caylon.",
        "field": "strDesc",
        "path": "$[78].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "316d99e606d448a7c8993dacee76bfb05e98943b": {
        "source": "DataWIKINewcal",
        "translation": "DonnéesWIKINewcal",
        "field": "aInverse",
        "path": "$[78].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
