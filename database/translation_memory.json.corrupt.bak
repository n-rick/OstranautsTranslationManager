        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[6].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "074acb1a4234c5a051b98526cff43c2813bb1cac": {
        "source": "JFTS LEO Begins Arresting Criminal",
        "translation": "JFTS LEO commence à arrêter un criminel",
        "field": "strTitle",
        "path": "$[7].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "bb42b86eda872e0fe6970e630f9f4e030dade17e": {
        "source": "\"Suspect spotted,\" [us] [says], looking at [them].",
        "translation": "\"Suspect repéré\", [us] [says], regardant [them].",
        "field": "strDesc",
        "path": "$[7].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "b61594971796cfaf1d19870c7603937439da1019": {
        "source": "PLGAICrimeJFTSLEOInterruptSelf",
        "translation": "PLGAICrimeJFTSLEOInterruptionSoi",
        "field": "aInverse",
        "path": "$[7].aInverse[0]",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "b8726b3018612b4e2b0064928dafd0af5cb27f1d": {
        "source": "JFTS LEO Is Interrupted by Crime",
        "translation": "JFTS LEO est interrompu par le crime",
        "field": "strTitle",
        "path": "$[8].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "836084f878d4fb101116adeb7ab87043fa8cf80b": {
        "source": "Interrupt them.",
        "translation": "Interrompez-les.",
        "field": "strDesc",
        "path": "$[8].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "c856fb36e2b10265b89025b95f79504b8f288b85": {
        "source": "Arresting Criminal",
        "translation": "Arrêter un criminel",
        "field": "strTitle",
        "path": "$[9].strTitle",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
    "3afc5872b9757605ce78844fb56fc81107b91619": {
        "source": "\"Stop right there! You're under arrest!\" [us] [shouts] at [them].",
        "translation": "\"Arrêtez-vous là ! Vous êtes en état d'arrestation !\" [us] [shouts] à [them].",
        "field": "strDesc",
        "path": "$[9].strDesc",
        "relative_path": "interactions/interactions_crime_JFTS.json"
    },
