    "aad83d2615a69cbcdcc8261adbef67d0f5ac9cfb": {
        "source": "[us] [asks] [them] if [3rd] [knows] about the black market being run out of the back of K-Leg's only bar.",
        "translation": "[us] [asks] [them] si [3rd] [knows] à propos du marché noir géré à l'arrière du seul bar de K-Leg.",
        "field": "strDesc",
