    "aa657a1ab74ed55259d1092dea447a362b0d8d32": {
        "source": "Newcal Statistics",
        "translation": "Statistiques de Newcal",
        "field": "strTitle",
        "path": "$[76].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "13319b2277d150ab611cfc3de1059dfa368eb64b": {
        "source": "<b>Government:</b> Presidential republic\n<b>Head of state:</b> President Luciana Altman\n<b>Sovereignty:</b> Independent (formerly US-owned)\n<b>Location:</b> Venus's upper atmosphere\n<b>Established:</b> 2049\n<b>Major ports:</b> Long Beach terminal\n<b>Industries:</b> Plastics, shipbuilding, media & entertainment\n<b>Currency:</b> USD\n<b>Population estimate:</b> 3 million\n<b>Languages:</b> English, Spanish, Mandarin\n<b>Regional dialect:</b> Fenghua ('float')\n<b>Religions:</b> Christianity, Buddhism",
        "translation": "<b>Gouvernement :</b> République présidentielle\n<b>Chef de l'État :</b> Présidente Luciana Altman\n<b>Souveraineté :</b> Indépendant (anciennement détenu par les États-Unis)\n<b>Emplacement :</b> La haute atmosphère de Vénus\n<b>Établi :</b> 2049\n<b>Principaux ports :</b> Terminal de Long Beach\n<b>Industries :</b> Plastiques, construction navale, médias et divertissement\n<b>Devise :</b> USD\n<b>Estimation de la population :</b> 3 millions\n<b>Langues :</b> Anglais, espagnol, mandarin\n<b>Dialecte régional :</b> Fenghua (« flottant »)\n<b>Religions :</b> Christianisme, bouddhisme",
        "field": "strDesc",
        "path": "$[76].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "4f08c365608721a44518e86aa6b8135624b19657": {
