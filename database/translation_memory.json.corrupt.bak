    "2251a9a36973ef0e444f4a6ddd0e14200fcee5ca": {
        "source": "[us] [gains] EJDR LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] EJDR LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "b65c2183455db97282f7995d45306bbd9460302a": {
        "source": "Adds EJDR LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement EJDR LEO Threat",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "660366e2fa7107ea3ed7816ca516d4e926156d18": {
        "source": "[us] [gains] EJDR LEO Threat pledge.",
        "translation": "[us] [gains] EJDR LEO Engagement de menace.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_EJDR.json"
    },
    "974b95489dbeba83bd906cb839da3411e7b4a901": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "bc03ec04369777b64983be05cea476b96a5c4ebc": {
        "source": "They haul you before a Xinhua magistrate for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Qincheng Holding Cell for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un magistrat de Xinhua pour jugement, laissant derrière eux votre navire et votre équipement.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payables en totalité ou en plusieurs versements - ou vous allez à la cellule de détention de Qincheng pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "20882a192979a859cd006e00b59b89c08aa55598": {
        "source": "ENCHeatHQCHFineEnd",
        "translation": "ENCHeatHQCHFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "c79a123ee2597e90dfb00ace8d4982597da99f67": {
        "source": "ENCHeatHQCHFineDebtEnd",
        "translation": "ENCHeatHQCHFineDetteFin",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "cc69461040870a77e156f21876a34cd1d1bc9b03": {
        "source": "ENCHeatHQCHPrisonStart",
        "translation": "ENCHeatHQCHPrisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "7904f9f47b41fdce21f46f1d3d27560bbe0090d6": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "27d98249cf5500d43a548cc0cdeb9e3f7795b397": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "9e668b01b4297d4e39e8af6240f2f04f9adf4366": {
        "source": "ENCHeatHQCHFineFinish",
        "translation": "ENCHeatHQCHFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "9b665564682d89ce067950ee133908b24158a791": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "1137f85f359a2f6ff5fedb6a52d7bbbecb29c72d": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "b987f22165dbda5a5b8b75cc156f5fd04309cb66": {
        "source": "ENCHeatHQCHFineFinish",
        "translation": "ENCHeatHQCHFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "7913bb34057507bd466cb76da51b98fa7d2cf7ce": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "947860d30931bb0dba45c2b76bae0b75549725b1": {
        "source": "After processing, you are unceremoniously dumped outside the Qincheng Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l'extérieur du bureau de sécurité de Qincheng. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "d606e3e3ea28930b1969a5b000847a9957ebe4be": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "c632a44ff3b1e9aa2222c004751c98b28ca3be29": {
        "source": "Off to Qincheng Holding Cell",
        "translation": "En route vers la cellule de détention de Qincheng",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "0e49c0106a6d21aea20dab4139b433e07b1bc7e9": {
        "source": "You are hauled off to Qincheng Holding Cell.",
        "translation": "Vous êtes transporté vers la cellule de détention de Qincheng.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "1bf9178417ec3d3bb808ff503e50e398c0c5f5fe": {
        "source": "ENCHeatHQCHPrisonEnd",
        "translation": "ENCHeatHQCHPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "d214b0c40fec90c80bd4c5ffd86b3342b33e236a": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "e378f2a5da5d922b52d84acade3ac9d3bd7532b6": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "9776f439dfbcde9ec789cb0f87a34b37cea31247": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "493a1c0827194f1159b45016c000d1cf953880ea": {
        "source": "ENCHeatHQCHPrisonFinish",
        "translation": "ENCHeatHQCHPrisonTerminer",
        "field": "aInverse",
        "path": "$[5].aInverse[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "cabe7b41e1780056260c6d846b851379ecc4c69c": {
        "source": "CGEncHomeworldLEOEnemy",
        "translation": "CGEncHomeworldLEOEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "11e77b3a610cdc0728dab00eba2238d881731b9e": {
        "source": "CGEncHomeworldPrisonerFriend",
        "translation": "CGEncHomeworldPrisonerAmi",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[1]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "0fbb9a974f2387f51d12630406acd97c0acdacc5": {
        "source": "CGEncHomeworldCriminalEnemy",
        "translation": "CGEncHomeworldCriminalEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[2]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "46ab1a318c46420f05064226dc2bba5be05bfe28": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "7c1b6d20f3e4856fc45fadd0a634c71128fa4845": {
        "source": "After processing, you are unceremoniously dumped outside the Qincheng Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l'extérieur du bureau de sécurité de Qincheng. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "dfbb4f58b8be411b3c659809140ac2c1b12fa5a3": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[6].aInverse[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "ed1febea1325ec76b951d8f97b5f7504d410510e": {
        "source": "HQCH LEO Begins Arresting Criminal",
        "translation": "HQCH LEO commence à arrêter un criminel",
        "field": "strTitle",
        "path": "$[7].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "51e7893bd4fdd03b9600af334fe83d15fb5054d8": {
        "source": "\"Suspect spotted,\" [us] [says], looking at [them].",
        "translation": "\"Suspect repéré\", [us] [says], regardant [them].",
        "field": "strDesc",
        "path": "$[7].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "1df0097162b5449ddb8c816cd86667ed53f83bf4": {
        "source": "PLGAICrimeHQCHLEOInterruptSelf",
        "translation": "PLGAICrimeHQCHLEOInterruptionLui",
        "field": "aInverse",
        "path": "$[7].aInverse[0]",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "423a2123139a8d258b3b2480407afbfd0adcc129": {
        "source": "HQCH LEO Is Interrupted by Crime",
        "translation": "HQCH LEO est interrompu par le crime",
        "field": "strTitle",
        "path": "$[8].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "050cebfdb4c5c1a5689694eb79c428899a416b46": {
        "source": "Interrupt them.",
        "translation": "Interrompez-les.",
        "field": "strDesc",
        "path": "$[8].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "8539bc7523d94ee4dcf99e869f7b5b17c87746fb": {
        "source": "Arresting Criminal",
        "translation": "Arrêter un criminel",
        "field": "strTitle",
        "path": "$[9].strTitle",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "6e9292783af278e192dab5ac5177cd1227592076": {
        "source": "\"Stop right there! You're under arrest!\" [us] [shouts] at [them].",
        "translation": "\"Arrêtez-vous là ! Vous êtes en état d'arrestation !\" [us] [shouts] à [them].",
        "field": "strDesc",
        "path": "$[9].strDesc",
        "relative_path": "interactions/interactions_crime_HQCH.json"
    },
    "e8d22c75d9e4794fdbfb2200a7edb3a2cbc9cab0": {
