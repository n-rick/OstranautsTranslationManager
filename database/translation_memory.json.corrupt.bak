    "c2f7dcedfc4ec010079ffc9499efc36672be4887": {
        "source": "Trenchers Survivor Sensation",
        "translation": "Sensation de survivant des trancheuses",
        "field": "strTitle",
        "path": "$[151].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "8c44376e5e1f4478f27fc2036b6315f676141ae5": {
        "source": "Trenchers were the subject of media attention during the recovery of an arm of the Nautilus Station lost in the L3 disaster. Synchronisation engineer Radhu Laghari-Paul survived nearly six months trapped inside the arm surviving off Trenchers and grey water. Future Foods exploited a trend where media updates of Laghari-Paul's status coincided with spikes in demand for Trenchers System-wide.",
        "translation": "Les trancheuses ont fait l'objet d'une attention médiatique lors de la récupération d'un bras de la station Nautilus perdu lors de la catastrophe du L3. L'ingénieur de synchronisation Radhu Laghari-Paul a survécu près de six mois coincé à l'intérieur du bras, survivant des tranchées et des eaux grises. Future Foods a exploité une tendance selon laquelle les mises à jour médiatiques sur le statut de Laghari-Paul coïncidaient avec des pics de demande de trancheuses à l'échelle du système.",
        "field": "strDesc",
        "path": "$[151].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "bba84555645686f85be15bef1c7a1dcace85a028": {
        "source": "DataWIKITrenchers",
        "translation": "DonnéesWIKITranchers",
        "field": "aInverse",
        "path": "$[151].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
