    "712192047c17ef7a0bd9fab06f515571019dcef1": {
        "source": "Take Ship",
        "translation": "Prendre le bateau",
        "field": "strTitle",
        "path": "$[339].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "6b006fbcb3b5e9cafda55beb96dac701864f71fa": {
        "source": "You're now the proud owner of a Testudo Dream, and you can now reach some of the outer derelicts beyond the watchful eye of the yard masters.\n\nNow that you're on your own terms, your next move is up to you. Maybe score a valuable part or two for resale, or reuse? Pull down a platinum tier payout on a gig? Or maybe even discover a ship discarded before its time?\n\nWhatever the case, it beats sweating in a suit all day for someone else's profit. Time to get out there and find your future.",
        "translation": "Vous êtes désormais l'heureux propriétaire d'un Testudo Dream et vous pouvez désormais atteindre certaines des épaves extérieures au-delà de l'œil vigilant des maîtres du chantier.\n\nMaintenant que vous êtes selon vos propres conditions, la prochaine étape dépend de vous. Peut-être récupérer une ou deux pièces de valeur pour les revendre ou les réutiliser ? Réduire un paiement de niveau Platine lors d'un concert ? Ou peut-être même découvrir un navire abandonné avant l’heure ?\n\nQuoi qu’il en soit, c’est mieux que de transpirer toute la journée en costume pour le profit de quelqu’un d’autre. Il est temps de sortir et de trouver votre avenir.",
        "field": "strDesc",
        "path": "$[339].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "ada45d1a7edb3c5716a219eaa1f863987c82b5e3": {
        "source": "addus,ItmShipbreakerLoadout",
        "translation": "addus,ItmShipbreakerLoadout",
        "field": "aLootItms",
        "path": "$[339].aLootItms[0]",
        "relative_path": "interactions/interactions.json"
    },
    "6d18ee8da71db34a3f4fefd0282a8913ea8ef6d5": {
        "source": "Take Ship",
        "translation": "Prendre le bateau",
        "field": "strTitle",
        "path": "$[340].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "b7c6fb7328e3654d080767cbaae46df50f681b81": {
        "source": "You're now the proud owner of a Testudo Melody, and you can now reach some of the outer derelicts beyond the watchful eye of the yard masters.\n\nNow that you're on your own terms, your next move is up to you. Maybe score a valuable part or two for resale, or reuse? Pull down a platinum tier payout on a gig? Or maybe even discover a ship discarded before its time?\n\nWhatever the case, it beats sweating in a suit all day for someone else's profit. Time to get out there and find your future.",
        "translation": "Vous êtes désormais l'heureux propriétaire d'un Testudo Melody et vous pouvez désormais atteindre certaines des épaves extérieures au-delà de l'œil vigilant des maîtres du chantier.\n\nMaintenant que vous êtes selon vos propres conditions, la prochaine étape dépend de vous. Peut-être récupérer une ou deux pièces de valeur pour les revendre ou les réutiliser ? Réduire un paiement de niveau Platine lors d'un concert ? Ou peut-être même découvrir un navire abandonné avant l’heure ?\n\nQuoi qu’il en soit, c’est mieux que de transpirer toute la journée en costume pour le profit de quelqu’un d’autre. Il est temps de sortir et de trouver votre avenir.",
        "field": "strDesc",
        "path": "$[340].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "a3b1c51feab48c58dc4ddc7ef8c7d8dc743d557e": {
        "source": "addus,ItmShipbreakerLoadout",
