        "translation": "Plaider l'innocence",
        "field": "strTitle",
        "path": "$[11].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "6d8c93a110ab1af4f7e6ad0c2c150009a08a7161": {
        "source": "[us] [tells] [them] [them-subj] [has] the wrong person.",
        "translation": "[us] [tells] [them] [them-subj] [has] la mauvaise personne.",
        "field": "strDesc",
