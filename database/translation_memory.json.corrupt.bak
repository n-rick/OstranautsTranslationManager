    "269535f4fe9bb63e617b7d779f0234895f2c30ac": {
        "source": "Describe the Best Parts of Earth",
        "translation": "Décrivez les meilleures parties de la Terre",
        "field": "strTitle",
        "path": "$[253].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "80aaced05a18795d9f1bc82ce6fe7194682e4b6a": {
        "source": "[us] [says] that it was as beautiful as everyone says. You could walk for fifty miles in a forest and still find more trees.",
        "translation": "[us] [says] que c'était aussi beau que tout le monde le dit. Vous pourriez marcher cinquante milles dans une forêt et trouver encore plus d'arbres.",
        "field": "strDesc",
        "path": "$[253].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "fdd96efa78d3637a98d2cdcd8b8fba85b1461218": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[253].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "8f6bf8e9c437e903d652700a72929e2b61699bed": {
        "source": "Describe the Worst Parts of Earth",
        "translation": "Décrivez les pires régions de la Terre",
        "field": "strTitle",
        "path": "$[254].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "f233b1e473906b089bc41a44704c8b1924ba5c15": {
        "source": "[us] [says] that it was a rotten planet even before the ablation cascade cut it off from the rest of the system.",
        "translation": "[us] [says] que c'était une planète pourrie avant même que la cascade d'ablation ne la coupe du reste du système.",
        "field": "strDesc",
        "path": "$[254].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "c6f503d4c689959951ba5629d8739a6a6d2d0c70": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[254].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "53948bb6ada4dd28658bbe12273ac1df9c57bd09": {
        "source": "Share a Childhood Memory from Earth",
        "translation": "Partagez un souvenir d'enfance sur Terre",
        "field": "strTitle",
        "path": "$[255].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "852458587d9a261e44e770395c30be2d16a1d14d": {
        "source": "[us] [remembers] a lake that would freeze in the winter and melt in the summer. There was a rope swing on the lake and a big rock you could climb and then leap from.",
        "translation": "[us] [remembers] un lac qui gèlerait en hiver et fondrait en été. Il y avait une balançoire en corde sur le lac et un gros rocher sur lequel on pouvait grimper puis sauter.",
        "field": "strDesc",
        "path": "$[255].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "2e84ac1d564f8c01f616aef4984ba57a0f487b2f": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[255].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
