    },
    "19e374206d7d757f3c0ed5add4c3737506713444": {
        "source": "SHIPRumorOssifex",
        "translation": "SHIPRumeurOssifex",
        "field": "aInverse",
        "path": "$[126].aInverse[23]",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "45100a0ff107889dc8e8a8a49985ee332940117b": {
        "source": "Rumor Nothing",
        "translation": "Rumeur Rien",
        "field": "strTitle",
        "path": "$[127].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "7f081e1e8c61facf3452ee870dce2c3b0746122d": {
        "source": "Whole lotta nothing, [them-regID]. I'm beginning to think we're the only two ships out here.",
        "translation": "Beaucoup de rien, [them-regID]. Je commence à penser que nous sommes les deux seuls vaisseaux ici.",
        "field": "strDesc",
        "path": "$[127].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "7ce264f54ded804d3b2b4f5879ac3d060345fced": {
        "source": "Spam Rumor",
        "translation": "Rumeur de spam",
        "field": "strTitle",
        "path": "$[128].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "f690feb5087ecb06b2257a978bfc04de4e360957": {
        "source": "Another ship got spammed an empty packet. Uncompressed, all zeroes. Fifth time this week. Either someone is playing a prank or...well, I don't know what.",
        "translation": "Un autre navire a reçu un paquet vide. Non compressé, tous les zéros. Cinquième fois cette semaine. Soit quelqu'un fait une farce, soit... enfin, je ne sais pas quoi.",
        "field": "strDesc",
        "path": "$[128].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "7d77b3c7aaa2a778c68a85e3e070ca8e2150ad90": {
        "source": "Freezer Rumor",
        "translation": "Rumeur sur le congélateur",
        "field": "strTitle",
        "path": "$[129].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "c38009d70e0483a6231cb1f5f3a53866fae1d1dc": {
        "source": "A couple of dopes in the OE managed to get themselves locked in the Mescaform freezer. Barkeep found them the next morning frostbitten and drunk as all sin. One of them lost a finger.",
        "translation": "Quelques dopés de l'OE ont réussi à se faire enfermer dans le congélateur Mescaform. Le barman les trouva le lendemain matin, gelés et ivres comme un péché. L'un d'eux a perdu un doigt.",
        "field": "strDesc",
        "path": "$[129].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "25700e94a631c97b7f5efa5913e7cc643014af2f": {
        "source": "Fight Club Rumor",
        "translation": "Rumeur du club de combat",
        "field": "strTitle",
        "path": "$[130].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "bfa7a898fea93010e3a653897eb1a33a1a58e9ee": {
        "source": "There's a fight club on OKLG, apparently. Bunch of desk jockeys getting their anger out. Not a fighter myself, but I'd take a gander.",
        "translation": "Il y a un club de combat sur OKLG, apparemment. Une bande de jockeys de bureau qui expriment leur colère. Je ne suis pas un combattant moi-même, mais j'y jetterais un coup d'œil.",
        "field": "strDesc",
        "path": "$[130].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "c31ca69e137373d611caba758037b5e38dc73364": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[131].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "cce999d59165e95dedc2228aafcb80ef46337db9": {
        "source": "Breaker's Union can't get enough support from the rank and file for a strike. I'm starting to think Ayo is seeding it with saboteurs.",
        "translation": "Breaker's Union ne parvient pas à obtenir suffisamment de soutien de la base pour lancer une grève. Je commence à penser qu'Ayo le sème avec des saboteurs.",
        "field": "strDesc",
        "path": "$[131].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "af8da48936afc3da211b02a0088450565672fb16": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[132].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "931d67ce996429cba8372b692b29b8279c74a75c": {
        "source": "Folks keep saying they're seeing something purple floating outside their ship. Ever heard of The Mariner? I'm not superstitious myself but that one...that one gets me. ",
        "translation": "Les gens n'arrêtent pas de dire qu'ils voient quelque chose de violet flotter à l'extérieur de leur navire. Avez-vous déjà entendu parler du Mariner ? Je ne suis pas superstitieux moi-même mais celui-là… celui-là me comprend.",
        "field": "strDesc",
        "path": "$[132].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "d9147f35648599e425227888687650343fa80892": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[133].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "c7844cbaf97dd56230afa55f60ac617444c58e54": {
        "source": "More and more punk kids wearing purple and getting stoned on OKLG. I know what they're getting at, who they are trying to meet. But I'm not gonna say it.",
        "translation": "De plus en plus de jeunes punks portent du violet et se défoncent sur OKLG. Je sais où ils veulent en venir, qui ils essaient de rencontrer. Mais je ne vais pas le dire.",
        "field": "strDesc",
        "path": "$[133].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "e5697f6a1f5c62b5e866c473118d67d8316a048b": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[134].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "d82a82d3fcf766b6e6bc82dc70a4a37119849d1c": {
        "source": "Piracy is completely out of control around the Venus aerostats. They hit a dozen ships last week. Folks won't even fly from Newcal to Encantado to watch the races. Shameful shit if you ask me.",
        "translation": "Le piratage est totalement hors de contrôle autour des aérostats de Vénus. Ils ont touché une douzaine de navires la semaine dernière. Les gens ne prendront même pas l'avion de Newcal à Encantado pour regarder les courses. C'est honteux, à mon avis.",
        "field": "strDesc",
        "path": "$[134].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "16b2832315ad3fc0d86823fb7c31a2f26cff1c37": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[135].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "a01cc86aa4beb54bec7c9e0715bc33b4cae3bc30": {
        "source": "New clerk at the Port Authority seems like a pushover. Buddy of mine sweet talked her way out of a few docking fees. She's a looker, but still.",
        "translation": "Le nouveau commis à l'Autorité portuaire semble être un jeu d'enfant. Mon amie, ma chérie, lui a parlé de quelques frais d'amarrage. Elle est belle, mais quand même.",
        "field": "strDesc",
        "path": "$[135].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "23b5ec999fba68094e80ae5ca170780fe1125ae6": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[136].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "c144d5cf62aea4cdf92f6380d2d1043065f40122": {
        "source": "New clerk at the Port Authority scares easy. They dropped my docking fee after I gave them the ol' prison yard stare. Who says you can't learn anything in the joint?",
        "translation": "Le nouveau commis de l'autorité portuaire fait facilement peur. Ils ont baissé mes frais d'amarrage après que je leur ai lancé le regard de la cour de prison. Qui a dit qu'on ne pouvait rien apprendre dans un joint ?",
        "field": "strDesc",
        "path": "$[136].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "66cba80d69134a8f030c98e80eb8ebe2cf5e9850": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[137].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "e58eabfa02cb387bfbbf2eb25c5ca36b76fd346d": {
        "source": "Buddy of mine, a porter, heard something banging around one of their empty cabins the other night. Thought it was a stowaway. When they checked the cams, though, there was static in the center of the picture, near the bed. Damndest thing.",
        "translation": "L'autre soir, un de mes amis, un porteur, a entendu quelque chose détoner dans l'une de leurs cabines vides. Je pensais que c'était un passager clandestin. Cependant, lorsqu'ils ont vérifié les caméras, il y avait de l'électricité statique au centre de l'image, près du lit. La chose la plus foutue.",
        "field": "strDesc",
        "path": "$[137].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "5849de7746f2b2133b94215fa89c712c7f389cf2": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[138].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "99a069aaef933e551f58c13285102ad1a6bb69a4": {
        "source": "You remember that ship that escaped the Perpetual Protein lab breach? Name of The Lesser Key of Solomon? I heard it was spotted along the Ganymed orbit.",
        "translation": "Vous vous souvenez de ce vaisseau qui a échappé à la brèche du laboratoire Perpetual Protein ? Nom de la Petite Clé de Salomon ? J'ai entendu dire qu'il avait été repéré le long de l'orbite de Ganymed.",
        "field": "strDesc",
        "path": "$[138].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "0f384af2672711ac79fcf7b43699695245775022": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[139].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "e78cebfbea9ea58a207cc24a5ecfa9954b2d4f59": {
        "source": "I've been seeing more and more of those vat grown cats, you know? From Hyun Lee Petware? I don't understand the appeal myself.",
        "translation": "Je vois de plus en plus de ces chats cultivés en cuve, tu sais ? De Hyun Lee Petware ? Je ne comprends pas moi-même l'appel.",
        "field": "strDesc",
        "path": "$[139].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "ba0a469ce81090c425e284353f6f1b5a4ced8beb": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[140].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "86764f2fdcbb7dd290e97834f5d5e9b84da2c216": {
        "source": "I don't understand why everyone is so freaked out about the Perpetual Protein thing. Meat is meat, as far as I'm concerned. You think Trencher's is any better?",
        "translation": "Je ne comprends pas pourquoi tout le monde est si paniqué à propos du truc de Perpetual Protein. La viande est de la viande, en ce qui me concerne. Vous pensez que Trencher est meilleur ?",
        "field": "strDesc",
        "path": "$[140].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "50003913cb906c94fab44a505f0f691dfb9e2579": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[141].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "891d426f484853278e8067b484428246e0c8a46e": {
        "source": "That Professor Park Hyun Lee is a true bastard. Unleashing that monstrosity on the world. And for what? G-mod goat meat? Space him, I say.",
        "translation": "Ce professeur Park Hyun Lee est un vrai salaud. Libérer cette monstruosité sur le monde. Et pour quoi ? De la viande de chèvre G-mod ? Espacez-le, dis-je.",
        "field": "strDesc",
        "path": "$[141].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "da4167a4ad178d235662b975d9f7eb0220680ddf": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[142].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "25e790a9d867a607c256bc3c7c89cd3602f6c444": {
        "source": "Two horns, two eyes and a smiling tooth. Arranged just above his cloven hoof. Then from the void you'll hear the drums. For this is how the Goatman comes.",
        "translation": "Deux cornes, deux yeux et une dent souriante. Disposé juste au-dessus de son sabot fourchu. Puis, du vide, vous entendrez les tambours. Car c’est ainsi que vient l’Homme-Chèvre.",
        "field": "strDesc",
        "path": "$[142].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "0d2b431ad85c212a2afbe1d8739127758fa1015c": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[143].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "906373a756b1fe9cb674006371d4992a7e318fea": {
        "source": "Heard some freak managed to climb up the well at Prokofiev, if you can believe it.",
        "translation": "J'ai entendu dire qu'un monstre avait réussi à escalader le puits de Prokofiev, si vous pouvez le croire.",
        "field": "strDesc",
        "path": "$[143].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "629cd18b61507e31a3880b3b0cf7c68c05e64091": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[144].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "f8c60a2b2a11827dc9af270bcba75108481b8a57": {
        "source": "You ever tried lusca before? A buddy of mine says they serve it at weddings on Hangzhou. Melts like butter, he said.",
        "translation": "Avez-vous déjà essayé Lusca auparavant ? Un de mes amis dit qu'ils le servent lors des mariages à Hangzhou. Ça fond comme du beurre, dit-il.",
        "field": "strDesc",
        "path": "$[144].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "f681446e2bb8a0054a0d884967c70a1365f45f4f": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[145].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "07792c4c9d64ae531a972b3002e39a890cf081a7": {
        "source": "I've been off of long-hauling for so long now, my body aches when I put my boots on. I gotta get a line on some Ossifex.",
        "translation": "Cela fait si longtemps que je n'ai plus fait de longs trajets, j'ai mal au corps quand j'enfile mes bottes. Je dois avoir une ligne sur de l'Ossifex.",
        "field": "strDesc",
        "path": "$[145].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "b8e1ee951b77e61c40743f03b47275b48a9b15bd": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[146].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "3c55e7692f50834524c983c5286d0d44091c9a47": {
        "source": "The Harbourmaster has been more paranoid than usual lately. Has a private detail guarding his quarters all night. Running 12 hour shifts. The whole thing has become a huge drain on department resources.",
        "translation": "La capitainerie du port est plus paranoïaque que d'habitude ces derniers temps. Il y a un agent privé qui garde ses quartiers toute la nuit. Effectuer des quarts de travail de 12 heures. Tout cela est devenu une énorme ponction sur les ressources du ministère.",
        "field": "strDesc",
        "path": "$[146].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "e272caf652a87d8907ccd2b8f4144cbfb861c7df": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[147].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "fc951df5c98eadd5882c692ae3fdfcec0ede8b41": {
        "source": "We keep seeing tags of the number 79 around the station, especially over there in the OE? I think it's bored kids but my boss insists it's some kind of cult.",
        "translation": "On voit toujours des tags du numéro 79 autour de la gare, surtout là-bas dans l'OE ? Je pense que ça ennuie les enfants mais mon patron insiste sur le fait que c'est une sorte de culte.",
        "field": "strDesc",
        "path": "$[147].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "4fa594cd1ceda3d916a2bed542ef65a5f5c033af": {
        "source": "Offer Rumor",
        "translation": "Offre Rumeur",
        "field": "strTitle",
        "path": "$[148].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "0c54004a3b39f434813864ddfa278039e91f9855": {
        "source": "I don't know what to make of this living meat story. Everyone I've seen talk about it seems half-insane.",
        "translation": "Je ne sais pas quoi penser de cette histoire de viande vivante. Tous ceux que j'ai vu en parler semblent à moitié fous.",
        "field": "strDesc",
        "path": "$[148].strDesc",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
    "3c36792821b645f65ea7fdcf767d806635b47780": {
        "source": "Hail Deny",
        "translation": "Grêle Refuser",
        "field": "strTitle",
        "path": "$[149].strTitle",
        "relative_path": "interactions/interactions_ship_to_ship.json"
    },
