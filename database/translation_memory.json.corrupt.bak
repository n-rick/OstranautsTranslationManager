    "12b5b145aedd5934decc89ce703e60da88742779": {
        "source": "[us] says I like your faction! Sure, let's talk favors.",
        "translation": "[us] dit que j'aime votre faction ! Bien sûr, parlons de faveurs.",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_stk_template.json"
    },
    "8c06db4c7d18982d3091273f176022ff60a66bb4": {
