    "37b7d18b7666e090da01ee6a6f991593884c8a97": {
        "source": "Talk About the Best Parts of Europa",
        "translation": "Parlez des meilleures parties d’Europe",
        "field": "strTitle",
        "path": "$[268].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "9dd2150c62249b9a8607990d8f45583ba0d66a07": {
        "source": "[us] [says] that they grew up in Atlantis, a submarine colony beneath the frozen oceans of Europa. [us] [misses] Europa, whose population mostly ignores the messy political and corporate drama of the inner planets.",
        "translation": "[us] [says] qu'ils ont grandi dans l'Atlantide, une colonie sous-marine située sous les océans gelés d'Europe. [us] [misses] Europe, dont la population ignore en grande partie le drame politique et corporatif désordonné des planètes intérieures.",
        "field": "strDesc",
        "path": "$[268].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "fb5467211400782b935314330be7bb059e275e06": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[268].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "b2ef3c33d1664b5b180a8bd80be95d4a35b3ca2c": {
        "source": "Talk About the Worst parts of Europa",
        "translation": "Talk About the Worst parts of Europa",
        "field": "strTitle",
        "path": "$[269].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "574f3037310a731b58083681724c1cce196b0bc0": {
        "source": "[us] [says] that they grew up in Atlantis, a submarine colony beneath the frozen oceans of Europa. [us] [insists] the cliffside colony was damp and miserable and full of researchers who were intentionally obtuse.",
        "translation": "[us] [says] qu'ils ont grandi dans l'Atlantide, une colonie sous-marine située sous les océans gelés d'Europe. [us] [insists] la colonie à flanc de falaise était humide et misérable et pleine de chercheurs intentionnellement obtus.",
        "field": "strDesc",
        "path": "$[269].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "420425096f49ad55273d1eef5563c97673ee50ef": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[269].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "89303fccba4b088bdc978d34576c081ec3f283e3": {
        "source": "Describe a Memory From Europa",
        "translation": "Décrire un souvenir d'Europe",
        "field": "strTitle",
        "path": "$[270].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "1b02e7b7a054729ede5c1c7f18eacf62eaa148fb": {
        "source": "[us] [says] that they grew up in Atlantis, a submarine colony beneath the frozen oceans of Europa. [us] [recalls] a childhood trip to Point Mosman and the tendrilled iridescent Lusca drifting in and out of the thermal vents.",
        "translation": "[us] [says] qu'ils ont grandi dans l'Atlantide, une colonie sous-marine située sous les océans gelés d'Europe. [us] [recalls] un voyage d'enfance à Point Mosman et la Lusca irisée à vrilles dérivant dans et hors des bouches thermiques.",
        "field": "strDesc",
        "path": "$[270].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "70ca121f82097e6780bd564ca562439b78c0cc3b": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[270].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "8a732838b53300e1cdd6129be2e3344c7354bcd6": {
        "source": "Describe the Best Parts of Ganymede",
        "translation": "Describe the Best Parts of Ganymede",
        "field": "strTitle",
        "path": "$[271].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "80a211947ff8c5387e5453735a4436ab974109b8": {
        "source": "[us] [says] that they grew up on Ganymede, the only truly free colony left in the system. [us] [misses] the solidarity of building a liberated society among laboring Confederates. ",
        "translation": "[us] [says] qu'ils ont grandi sur Ganymède, la seule colonie véritablement libre qui reste dans le système. [us] [misses] la solidarité dans la construction d’une société libérée parmi les travailleurs confédérés.",
        "field": "strDesc",
        "path": "$[271].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "c906d6b512677fe38cefbc7e3a6c03da388c4b72": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[271].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "3332294869e3416381bd6c4f59555baafbb03351": {
        "source": "Describe the Worst Parts of Ganymede",
        "translation": "Décrivez les pires parties de Ganymède",
        "field": "strTitle",
        "path": "$[272].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "9ecf375f4433bb460a552c2167aba81c43de435d": {
        "source": "[us] [says] that they grew up on Ganymede, the only truly 'free' colony left in the system. [us] [complains] that it is impossible to get ahead there because the Confederacy won't let anyone start a private mining claim.",
        "translation": "[us] [says] qu'ils ont grandi sur Ganymède, la seule colonie véritablement « libre » restante dans le système. [us] [complains] qu'il est impossible d'y parvenir parce que la Confédération ne permettra à personne de lancer une concession minière privée.",
        "field": "strDesc",
        "path": "$[272].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "29ba69b5d2213515562d5b2a3cd77195d3a23806": {
        "source": "SOCChangeSubject",
        "translation": "SOCChangeSujet",
        "field": "aInverse",
        "path": "$[272].aInverse[0]",
        "relative_path": "interactions/interactions2.json"
    },
    "b5ff35d0c5c86ca0fcea0d81b7f253f5d0ebc6ed": {
        "source": "Describe a Memory from Ganymede",
        "translation": "Décrire un souvenir de Ganymède",
        "field": "strTitle",
        "path": "$[273].strTitle",
        "relative_path": "interactions/interactions2.json"
    },
    "f49bcea6072d2089ff511a073f966cadcf1527ad": {
        "source": "[us] [says] that they grew up on Ganymede, the only truly free colony left in the system. [us] [recalls] staring into the sky during the Coup and watching the Guns of Ganymede flash teal and pink as they obliterated a fleet of decelerating corporate mercenary frigates.",
        "translation": "[us] [says] qu'ils ont grandi sur Ganymède, la seule colonie véritablement libre qui reste dans le système. [us] [recalls] regardant le ciel pendant le coup d'État et regardant les canons de Ganymède clignoter en bleu sarcelle et rose alors qu'ils anéantissaient une flotte de frégates mercenaires d'entreprise en décélération.",
        "field": "strDesc",
        "path": "$[273].strDesc",
        "relative_path": "interactions/interactions2.json"
    },
    "a2842ac8392fb12ee37b89cd0a0cb1b0711c9e34": {
