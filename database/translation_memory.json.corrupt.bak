    },
    "83181445e30aa53a653743a253111a6715fbc60c": {
        "source": "GalCon LEO Begins Arresting Criminal for Stealing a Ship",
        "translation": "GalCon LEO commence à arrêter un criminel pour avoir volé un navire",
        "field": "strTitle",
        "path": "$[16].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "d98ccddaf23e159fa417881632f2396fca85b26d": {
        "source": "\"You've been reported as flying a stolen ship,\" [us] [says], looking at [them].\"We're bringing you in.\"",
        "translation": "\"On vous a signalé que vous pilotiez un vaisseau volé\", [us] [says], regardant [them]. \"Nous vous emmenons.\"",
        "field": "strDesc",
        "path": "$[16].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
