        "translation": "PLGAICrimeMSUZLEOInterruptionLui",
        "field": "aInverse",
        "path": "$[7].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "95d46f36fa3be2f2ffe9973bfc21d5b2a2936877": {
        "source": "MSUZ LEO Is Interrupted by Crime",
        "translation": "MSUZ LEO est interrompu par le crime",
        "field": "strTitle",
