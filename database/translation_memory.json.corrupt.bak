    "e5ba3f1f4e9e5ef008c0155adf2b6a8621927215": {
        "source": "Damask Rose Marketing Controversy",
        "translation": "Damask Rose Marketing Controversy",
        "field": "strTitle",
        "path": "$[118].strTitle",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "3d727ffab327748ba3a374219276bbc6daab5539": {
        "source": "In an expose first featured on OWNG's Wilcox, the bulk of the money spent by The Green Energy Company on Damask Rose's marketing was revealed to have been spent sponsoring celebrities, politicians, and even industry leaders to smoke or consume Damask Rose brand marijuana in public. Large media events were held or co-opted by the company to promote the drug. In particular, the Three Day Blowout was first conceived by TGEC marketing representatives, even though it is likely most of the attendees were unaware of the festival's origins. Actress Valeria Valencia, who received five million kuai over three years without disclosing her relationship with TGEC, claimed not to have altered her behaviour in any way.",
        "translation": "Dans un article présenté pour la première fois sur Wilcox d'OWNG, il a été révélé que la majeure partie de l'argent dépensé par The Green Energy Company pour le marketing de Damask Rose avait été dépensée pour parrainer des célébrités, des politiciens et même des leaders de l'industrie pour qu'ils fument ou consomment de la marijuana de marque Damask Rose en public. De grands événements médiatiques ont été organisés ou cooptés par l’entreprise pour promouvoir le médicament. En particulier, le Three Day Blowout a été conçu à l'origine par les représentants marketing de TGEC, même s'il est probable que la plupart des participants ignoraient les origines du festival. L'actrice Valeria Valencia, qui a reçu cinq millions de kuai sur trois ans sans révéler sa relation avec TGEC, a affirmé n'avoir modifié en aucune façon son comportement.",
        "field": "strDesc",
        "path": "$[118].strDesc",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "b0e7702c13053de56c7566f2470f0e11f4f34c1d": {
        "source": "DataWIKIDamaskRose",
        "translation": "DonnéesWIKIDamaskRose",
        "field": "aInverse",
        "path": "$[118].aInverse[0]",
        "relative_path": "interactions/interactions_datafiles.json"
    },
    "0f64af7c5f42ec7149557f5cd473fff704440d23": {
