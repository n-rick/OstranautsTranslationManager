        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "cd207364f1f0fbb6633f900971f212df128fda5c": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[6].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "3df1bba7909939639fa0094e0c89ab8e3096e5b1": {
        "source": "After processing, you are unceremoniously dumped outside the Galilean Confederacy Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l’extérieur du bureau de sécurité de la Confédération galiléenne. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[6].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "d6ae22d7ec8f5d3079d6587a7186e84b7f23e115": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[6].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "b09e436c07f30b2c0840a70ee836a01e446f6a0b": {
        "source": "GalCon LEO Begins Arresting Criminal",
        "translation": "GalCon LEO commence à arrêter un criminel",
        "field": "strTitle",
        "path": "$[7].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "c8b07937764a4aee97ce29a767e22ce6d12ed363": {
        "source": "\"Suspect spotted,\" [us] [says], looking at [them].",
        "translation": "\"Suspect repéré\", [us] [says], regardant [them].",
        "field": "strDesc",
        "path": "$[7].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "cd874b563c7ed74ed6b0c5ae6dc08e14998ac997": {
        "source": "PLGAICrimeGalConLEOInterruptSelf",
        "translation": "PLGAICrimeGalConLEOInterruptionSoi",
        "field": "aInverse",
        "path": "$[7].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "5c87aa0d177e7b0e8b8b6fbce61fd78fddb85e5a": {
        "source": "GalCon LEO Is Interrupted by Crime",
        "translation": "GalCon LEO est interrompu par le crime",
        "field": "strTitle",
        "path": "$[8].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "e4ccc807629e5d93ad2a1cc6b0cdcf20d796a5bd": {
        "source": "Interrupt them.",
        "translation": "Interrompez-les.",
        "field": "strDesc",
        "path": "$[8].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "73ef11a83b095b9aec531e73d4f584de6157a975": {
        "source": "Arresting Criminal",
        "translation": "Arrêter un criminel",
        "field": "strTitle",
        "path": "$[9].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "8b895d6cfb4c7a9bfc0319d13792d43649285103": {
        "source": "\"Stop right there! You're under arrest!\" [us] [shouts] at [them].",
        "translation": "\"Arrêtez-vous là ! Vous êtes en état d'arrestation !\" [us] [shouts] à [them].",
        "field": "strDesc",
        "path": "$[9].strDesc",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "383e0b7688c940ee53e8bf02c8e009864b0dbd0e": {
        "source": "PLGAICrimeGalConLEOArrestDoDeny",
        "translation": "PLGAICrimeGalConLEOArrestDoDeny",
        "field": "aInverse",
        "path": "$[9].aInverse[0]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "529020d1f4d53a3cf81023fb89586dae9ad431b2": {
