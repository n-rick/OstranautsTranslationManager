        "relative_path": "interactions/interactions.json"
    },
    "41ee3365a7d5f5b8148c4cc0de9086148adc8007": {
        "source": "Uprooted.",
        "translation": "Déraciné.",
        "field": "strTitle",
        "path": "$[395].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "871cf24fda21c1cd4943952a1c77844bd0048e46": {
        "source": "Criminals move in, forcing you to leave with only what you can carry.",
        "translation": "Les criminels s'installent, vous obligeant à repartir avec seulement ce que vous pouvez emporter.",
        "field": "strDesc",
        "path": "$[395].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "945afb143572607f1bd1b32fe0aed8053ddd3f56": {
        "source": "CGEncCriminalEnemy",
        "translation": "CGEncCriminalEnnemi",
        "field": "aSocialNew",
        "path": "$[395].aSocialNew[0]",
        "relative_path": "interactions/interactions.json"
    },
    "80b326bc514d63c091cf7625d0a1b3c3615b69a5": {
        "source": "Crackdown",
        "translation": "Répression",
        "field": "strTitle",
        "path": "$[396].strTitle",
        "relative_path": "interactions/interactions.json"
    },
    "4688198a21e5ffb864e7827aeb8cc9a2e19fd9bc": {
        "source": "\"Zhou, Zhou, Zhouyi!\" a woman calls. You stop what you're doing, mouth dry. So do the dozen or so other day-workers in the cramped dormitory, a 'Silver Class Econopartment' in ASC Barracks.\n\nThat's the signal from the next pod over. They're coming.\n\nOutside the door and up the access corridor, you hear the clatter of mag boots marching in double time. A half dozen of your neighbours flee through the back door. Moments later you hear a series of sharp cracks and screams - shocker rounds, you hope.\n\nYou've got a moment to act. What do you do?",
        "translation": "\"Zhou, Zhou, Zhouyi!\" une femme appelle. Vous arrêtez ce que vous faites, la bouche sèche. Il en va de même pour la douzaine d'autres travailleurs journaliers dans le dortoir exigu, un « éconopartement de classe Argent » dans la caserne ASC.\n\nC'est le signal du module suivant. Ils arrivent.\n\nDevant la porte et dans le couloir d'accès, vous entendez le cliquetis des bottes mag marchant au rythme double. Une demi-douzaine de vos voisins fuient par la porte arrière. Quelques instants plus tard, vous entendez une série de craquements et de cris aigus – des balles choquantes, espérez-vous.\n\nVous avez un moment pour agir. Que fais-tu?",
        "field": "strDesc",
        "path": "$[396].strDesc",
        "relative_path": "interactions/interactions.json"
    },
    "d8f8516b345a06f8cb10f1c15dab4933b2f00166": {
