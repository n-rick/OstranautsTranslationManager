        "field": "aSocialNew",
        "path": "$[5].aSocialNew[1]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
    },
    "ecb7b83ec770af065e6b7996115ad273d87f5a70": {
        "source": "CGEncHomeworldCriminalEnemy",
        "translation": "CGEncHomeworldCriminalEnemy",
        "field": "aSocialNew",
        "path": "$[5].aSocialNew[2]",
        "relative_path": "interactions/interactions_crime_MHNG.json"
