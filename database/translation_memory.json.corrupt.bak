    "19fa1801161089646642f9c6af2413d392bbcb03": {
        "source": "Port Authority Coveralls",
        "translation": "Combinaisons d'autorité portuaire",
        "field": "strNameFriendly",
        "path": "$[20].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_clothes.json"
    },
    "bdd86f9bccdc0763abe8f66f4863fc6d8cec6f89": {
        "source": "A loose fitting garment covering the whole body, also known as a boilersuit. Wearing one will protect your modesty and little else.\n\nDesaturated seafoam is the go-to color for when you want to simultaneously exude a sense of authority and austerity.",
        "translation": "Un vêtement ample couvrant tout le corps, également connu sous le nom de combinaison. En porter un protégera votre pudeur et rien d’autre.\n\nL’écume de mer désaturée est la couleur idéale lorsque vous souhaitez dégager simultanément un sentiment d’autorité et d’austérité.",
        "field": "strDesc",
        "path": "$[20].strDesc",
        "relative_path": "cooverlays/cooverlays_clothes.json"
    },
    "0d82b16fb0afc40ea008ae5a5dd4145b66fbac9d": {
        "source": "shirt_mid",
        "translation": "chemise_milieu",
        "field": "mapSlotEffects",
        "path": "$[20].mapSlotEffects[0]",
        "relative_path": "cooverlays/cooverlays_clothes.json"
    },
    "5cd5e14a080d62e504f7e3fc9967066233e1c5d7": {
        "source": "BodySuit09",
        "translation": "BodySuit09",
        "field": "mapSlotEffects",
        "path": "$[20].mapSlotEffects[1]",
        "relative_path": "cooverlays/cooverlays_clothes.json"
    },
    "a27c683768f0efa9e20499211b9f807d95c11f99": {
