    "3deb7e15ebdaf763f309c6ba43b37f4c7ee170e7": {
        "source": "<b>Government:</b> Federal democracy\n<b>Head of state:</b> President Edmund Markham\n<b>Sovereignty:</b> Owned by the Galilean Confederacy\n<b>Location:</b> Ganymede\n<b>Established:</b> 2054\n<b>Major ports:</b> Port Independence\n<b>Industries:</b> Textiles, munitions\n<b>Currency:</b> USD, XNY\n<b>Population estimate:</b> 1,200,000\n<b>Languages:</b> English, Mandarin\n<b>Religions:</b> Christian",
        "translation": "<b>Gouvernement :</b> Démocratie fédérale\n<b>Chef de l'État :</b> Président Edmund Markham\n<b>Souveraineté :</b> Propriété de la Confédération galiléenne\n<b>Lieu :</b> Ganymède\n<b>Établi :</b> 2054\n<b>Principaux ports :</b> Indépendance des ports\n<b>Industries :</b> Textiles, munitions\n<b>Devise :</b> USD, XNY\n<b>Estimation de la population :</b> 1 200 000\n<b>Langues :</b> Anglais, mandarin\n<b>Religions :</b> Chrétien",
        "field": "strDesc",
