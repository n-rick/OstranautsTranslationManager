        "translation": "PLGAICrimeGalConLEOArrestDoAllow",
        "field": "aInverse",
        "path": "$[9].aInverse[1]",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "40ede378f3a1463fd37f13bad111a0cc19e4332c": {
        "source": "Surrender to Officer",
        "translation": "Se rendre à l'officier",
        "field": "strTitle",
        "path": "$[10].strTitle",
        "relative_path": "interactions/interactions_crime_BCER.json"
    },
    "8758183a150a041410841f3253d56382bff32d0b": {
        "source": "[us] [goes] along peacefully with [them].",
        "translation": "[us] [goes] accompagné paisiblement de [them].",
        "field": "strDesc",
        "path": "$[10].strDesc",
