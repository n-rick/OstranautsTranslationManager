    },
    "07dac0b1c1b5122967cb441fac58c5664e6452c4": {
        "source": "A drone operating system and behavior log.",
        "translation": "Un système d’exploitation et un journal de comportement du drone.",
        "field": "strDesc",
        "path": "$[98].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "07dbac8dbdeb7b8968783b42052d9231d89214fc": {
        "source": "CREW_HEALTH_RECORDS.BIN",
        "translation": "CREW_HEALTH_RECORDS.BIN",
        "field": "strNameFriendly",
        "path": "$[99].strNameFriendly",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "1d940d85ffe69190b7ef36f346de7cd372d58ea7": {
        "source": "A collection of dashboards visualizing health monitoring data for a handful of crewmembers.\n\nCollectively, there is a sense that this crew was admittedly trying to stave off the worst effects of spacer life, though ultimately failing.\n\nThe poor sleep, negligence in exercise, and excess of drinking and smoking feel all too familiar.",
        "translation": "Une collection de tableaux de bord visualisant les données de surveillance de la santé d’une poignée de membres d’équipage.\n\nCollectivement, on a le sentiment que cet équipage essayait certes d'éviter les pires effets de la vie des spacers, mais en fin de compte, il a échoué.\n\nLe manque de sommeil, la négligence dans l’exercice physique et l’excès de boisson et de tabac ne nous semblent que trop familiers.",
        "field": "strDesc",
        "path": "$[99].strDesc",
        "relative_path": "cooverlays/cooverlays_datafiles.json"
    },
    "30dee9f463216fb8b6c71993cd50fa37773e9f11": {
