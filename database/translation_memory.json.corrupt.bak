    "12e7c8029f606b9fcefa0c1e74a0356470e559e2": {
        "source": "[us] [sighs] and [says] [us-subj] [hopes] [them] [knows] what [them-contractIs] doing. Nobody likes a double agent. If [them] [wants] to trade, though, the market is open to them. For now.",
        "translation": "[us] [sighs] et [says] [us-subj] [hopes] [them] [knows] ce que [them-contractIs] fait. Personne n’aime les agents doubles. Cependant, si [them] [wants] fait du commerce, le marché leur est ouvert. Pour l'instant.",
        "field": "strDesc",
        "path": "$[21].strDesc",
        "relative_path": "interactions/interactions_fixer.json"
    },
    "2a609a629489614c3e97efec026a7cfd24ef05a5": {
