    "736bbfee69451979f5ee91be79eb08a95df3c794": {
        "source": "Adds MSUZ LEO Arrest pledge to us",
        "translation": "Nous ajoute l'engagement d'arrestation de MSUZ LEO",
        "field": "strTitle",
        "path": "$[28].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "e4a8490a6f193d7677358170e9219ac1f1105161": {
        "source": "[us] [gains] MSUZ LEO Arrest pledge.",
        "translation": "[us] [gains] MSUZ LEO Engagement d'arrestation.",
        "field": "strDesc",
        "path": "$[28].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "ae5633f5ee7bbe5dff315d5924ae8a333d4d64d8": {
        "source": "Adds MSUZ LEO Arrest pledge to us because the player stole a ship.",
        "translation": "Nous ajoute l'engagement d'arrestation de MSUZ LEO car le joueur a volé un navire.",
        "field": "strTitle",
        "path": "$[29].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "7db62bd61e7844a3471960f8cf0491aedc0b1032": {
        "source": "[us] [gains] MSUZ LEO Arrest for Stolen Ship pledge.",
        "translation": "[us] [gains] MSUZ LEO Arrestation pour promesse de vol de navire.",
        "field": "strDesc",
        "path": "$[29].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "948ce546c37892f7626e67af5df512e347cf7f52": {
        "source": "Adds MSUZ LEO Threat pledge to us",
        "translation": "Nous ajoute l'engagement MSUZ LEO Threat",
        "field": "strTitle",
        "path": "$[30].strTitle",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "66547384a51a64d0f4950ea740ea73101f871818": {
        "source": "[us] [gains] MSUZ LEO Threat pledge.",
        "translation": "[us] [gains] MSUZ LEO Engagement de menace.",
        "field": "strDesc",
        "path": "$[30].strDesc",
        "relative_path": "interactions/interactions_crime_MSUZ.json"
    },
    "6fc0974e814ddb19d1779afd71898ce6fa63dd46": {
        "source": "Busted",
        "translation": "Cassé",
        "field": "strTitle",
        "path": "$[0].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "d33c07467f73b1ad438c9a87d5ee36e3106e0950": {
        "source": "They haul you before a Xinhua magistrate for judgement, leaving your ship and gear behind.\n\nAt the hearing, you can beg for just a fine- $15,000 payable in full or installments- or it's off to Tharsis Landing Brig for a year or three of hard labor.",
        "translation": "Ils vous transportent devant un magistrat de Xinhua pour jugement, laissant derrière eux votre navire et votre équipement.\n\nLors de l'audience, vous pouvez mendier simplement une amende - 15 000 $ payable en totalité ou en plusieurs versements - ou vous partez à Tharsis Landing Brig pour un an ou trois de travaux forcés.",
        "field": "strDesc",
        "path": "$[0].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "7b77f3f33f4ee5e5200653e817d9333c875e0d87": {
        "source": "ENCHeatMTRSFineEnd",
        "translation": "ENCHeatMTRSFineEnd",
        "field": "aInverse",
        "path": "$[0].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "d0933a0726cd2ceaf2849a8746ad70c026037e56": {
        "source": "ENCHeatMTRSFineDebtEnd",
        "translation": "ENCHeatMTRSFineDetteFin",
        "field": "aInverse",
        "path": "$[0].aInverse[1]",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "4d12dc954e962e65b9a473f632ca58f0ab3e70dd": {
        "source": "ENCHeatMTRSPrisonStart",
        "translation": "ENCHeatMTRSPrisonStart",
        "field": "aInverse",
        "path": "$[0].aInverse[2]",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "405d5983fff19767bffbf44655fafefd9330769b": {
        "source": "Plead for a fine (Lump Sum)",
        "translation": "Plaider pour une amende (Somme forfaitaire)",
        "field": "strTitle",
        "path": "$[1].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "f0e9b835da50ec9aa7f09d2c763b2686007dc312": {
        "source": "It's almost like they want you to break the rules so they can extract more fines from you.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 fine added.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous imposer davantage d'amendes.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle amende de 15 000 $ ajoutée.",
        "field": "strDesc",
        "path": "$[1].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "b756d4dc521aa6fe59b34f51af7ed34635136426": {
        "source": "ENCHeatMTRSFineFinish",
        "translation": "ENCHeatMTRSFineFinish",
        "field": "aInverse",
        "path": "$[1].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "acf34a75daaf7ba2828419af4224de8931f8d5ce": {
        "source": "Plead for a fine (Paid in installments)",
        "translation": "Plaider pour une amende (payée en plusieurs fois)",
        "field": "strTitle",
        "path": "$[2].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "a120f24e9e88a6b1ea85b7fc00aed4150cfb3947": {
        "source": "It's almost like they want you to break the rules so they can lock you deeper in interest payments.\n\nYou sign reams of paperwork in tight cuffs.\n\nIt's a prison sentence of another sort. Another weight hanging around your neck.\n\nNew $15,000 debt added, with payment due each shift.",
        "translation": "C'est presque comme s'ils voulaient que vous enfreigniez les règles afin de pouvoir vous enfermer davantage dans le paiement des intérêts.\n\nVous signez des tonnes de documents avec des menottes serrées.\n\nC'est une peine de prison d'un autre genre. Un autre poids qui traîne autour de ton cou.\n\nNouvelle dette de 15 000 $ ajoutée, avec paiement dû à chaque quart de travail.",
        "field": "strDesc",
        "path": "$[2].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "8ef7cea30d0e29cf77820d3f793b8f48c1f69d0b": {
        "source": "ENCHeatMTRSFineFinish",
        "translation": "ENCHeatMTRSFineFinish",
        "field": "aInverse",
        "path": "$[2].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "db8139174c507210cc3f0c188804a5fff3914dd0": {
        "source": "Continue",
        "translation": "Continuer",
        "field": "strTitle",
        "path": "$[3].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "b52b92eb1aa9f5db0abd1ab0ca867029d27e8a1f": {
        "source": "After processing, you are unceremoniously dumped outside the Tharsis Security Office. If you weren't docked at station when you were arrested, you may need to use the PASS ferry service (on your PDA) to reach your ship again. Hopefully it's still there.\n\nTime to get back on your feet.",
        "translation": "Après le traitement, vous êtes jeté sans cérémonie à l'extérieur du bureau de sécurité de Tharsis. Si vous n'étiez pas amarré à la gare au moment de votre arrestation, vous devrez peut-être utiliser le service de ferry PASS (sur votre PDA) pour rejoindre à nouveau votre navire. J'espère qu'il est toujours là.\n\nIl est temps de se remettre sur pied.",
        "field": "strDesc",
        "path": "$[3].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "16b95e18da18d92da881ff90e4c5c9225c65ff15": {
        "source": "ENCFinish",
        "translation": "ENCFinition",
        "field": "aInverse",
        "path": "$[3].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "e346eefc6386ae068dc7e1c9b79c072e749627fb": {
        "source": "Off to Tharsis Brig",
        "translation": "En route pour Tharsis Brig",
        "field": "strTitle",
        "path": "$[4].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "2ef5332e2608630c5c70445c676f83ec7975dad9": {
        "source": "You are hauled off to Tharsis Landing Brig.",
        "translation": "Vous êtes transporté à Tharsis Landing Brig.",
        "field": "strDesc",
        "path": "$[4].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "9da6774a0b496400196267a78a934fc64fa5c58a": {
        "source": "ENCHeatMTRSPrisonEnd",
        "translation": "ENCHeatMTRSPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[0]",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "0de5aa2507cfe76fae9360c1c32f19b5e35a0a04": {
        "source": "ENCHeatVenusPrisonEnd",
        "translation": "FRChaleurVénusPrisonFin",
        "field": "aInverse",
        "path": "$[4].aInverse[1]",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "85147422449c8a65482ac98c599c08925c306fab": {
        "source": "Serve Hard Time",
        "translation": "Servir des moments difficiles",
        "field": "strTitle",
        "path": "$[5].strTitle",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "6b25d148f5eb3cb9a5e6a994cd06bfcc57bb497d": {
        "source": "You spend months laboring without wage among outcasts both meek and dangerous. You share a dorm with nearly a hundred other souls, all of you stacked like kindling on triple high bunks.\n\nBut even a hell like this is not without opportunity. You hear things. You meet people. You get in a few scrapes, you find a few friends. By the end of your term you've lived a dozen lives and you have all the scars to prove it.\n\nPlus, free room and board. In a certain light, it might all be worth it ...\n\n",
        "translation": "Vous passez des mois à travailler sans salaire parmi des parias à la fois doux et dangereux. Vous partagez un dortoir avec près d'une centaine d'autres âmes, vous tous empilés comme du petit bois sur des couchettes triples.\n\nMais même un enfer comme celui-ci n’est pas sans opportunités. Vous entendez des choses. Vous rencontrez des gens. Vous avez quelques éraflures, vous trouvez quelques amis. À la fin de votre mandat, vous avez vécu une douzaine de vies et vous portez toutes les cicatrices qui le prouvent.\n\nDe plus, chambre et pension gratuites. D’un certain point de vue, cela en vaut peut-être la peine…",
        "field": "strDesc",
        "path": "$[5].strDesc",
        "relative_path": "interactions/interactions_crime_MTRS.json"
    },
    "21165d6e7935fd5495ce70c4b30aae899fa370b8": {
        "source": "ENCHeatMTRSPrisonFinish",
        "translation": "ENCHeatMTRSPrisonFinish",
        "field": "aInverse",
